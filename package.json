{
  "name": "varino-ai-studio",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "scripts:syntax": "node scripts/check-inline-script-syntax.mjs",
    "links:check": "node scripts/check-links.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "cf:local": "wrangler pages dev dist --local",
    "security:headers": "node scripts/check-security-headers.mjs",
    "csp:check": "node scripts/check-csp-compatibility.mjs",
    "claims:check": "node scripts/check-claims.mjs",
    "launch:check": "node scripts/check-launch-readiness.mjs",
    "readiness": "npm run build && npm run scripts:syntax && npm run links:check && npm run csp:check"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.10",
    "jose": "6.2.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/workers-types": "5.20260902.1",
    "@playwright/test": "1.62.1",
    "jsdom": "30.0.1",
    "vitest": "4.1.11",
    "wrangler": "4.128.0"
  }
}
