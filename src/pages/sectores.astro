---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { BASE, SITE } from "../config";
const sectores = [
  { n: "Clínicas y salud", e: "Consultas y centros sanitarios", dolor: "Ejemplo a explorar: coordinar solicitudes y citas administrativas con el equipo de recepción.", montamos: ["Organización de solicitudes", "Información pública aprobada", "Revisión humana antes de responder"], href: `${BASE}/sectores/clinicas/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Medicina estética", e: "Centros de estética y dermatología", dolor: "Ejemplo a explorar: ordenar consultas administrativas y facilitar la coordinación de citas.", montamos: ["Entrada de consultas", "Respuestas generales revisadas", "Derivación al personal"], href: `${BASE}/sectores/estetica/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Inmobiliarias", e: "Agencias, equipos de ventas y administración", dolor: "Ejemplo a explorar: centralizar consultas sobre inmuebles y organizar visitas.", montamos: ["Registro de preferencias expresadas", "Disponibilidad y tareas", "Decisiones del equipo"], href: `${BASE}/sectores/inmobiliarias/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Despachos profesionales", e: "Servicios jurídicos, fiscales y consultoría", dolor: "Ejemplo a explorar: clasificar solicitudes administrativas y preparar borradores para revisión.", montamos: ["Enrutamiento de consultas", "Extracción de campos mínimos", "Aprobación profesional"], href: `${BASE}/sectores/legal/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Centros veterinarios", e: "Clínicas y hospitales veterinarios", dolor: "Ejemplo a explorar: organizar citas y consultas administrativas sin sustituir la atención clínica.", montamos: ["Registro de solicitudes", "Canales definidos por la clínica", "Derivación al equipo veterinario"], href: `${BASE}/sectores/veterinarias/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Oftalmología", e: "Consultas y centros oftalmológicos", dolor: "Ejemplo a explorar: facilitar la coordinación administrativa de consultas y citas.", montamos: ["Información general aprobada", "Solicitudes de cita", "Revisión por recepción"], href: `${BASE}/sectores/oftalmologia/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Reproducción asistida", e: "Centros de fertilidad y reproducción humana", dolor: "Ejemplo a explorar: coordinar primeros contactos con cuidado y mínima recogida de datos.", montamos: ["Preferencia de contacto", "Información general aprobada", "Coordinación humana"], href: `${BASE}/sectores/fertilidad/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Traumatología", e: "Consultas de traumatología y ortopedia", dolor: "Ejemplo a explorar: coordinar solicitudes administrativas y citas con el equipo.", montamos: ["Registro de solicitudes", "Preferencias horarias", "Derivación al personal clínico"], href: `${BASE}/sectores/traumatologia/`, linkLabel: "Ver propuesta ilustrativa →" },
  { n: "Comercio y operaciones", e: "Tiendas, distribución, administración y logística", dolor: "Ejemplo a explorar: reducir pasos manuales entre herramientas, sujeto a medir el proceso real.", montamos: ["Validación de campos", "Avisos de excepciones", "Registro de actividad"] },
  { n: "Equipos de conocimiento", e: "Documentación, formación y soporte interno", dolor: "Ejemplo a explorar: encontrar información interna autorizada con permisos y fuentes visibles.", montamos: ["Búsqueda sobre documentos aprobados", "Respuestas con revisión humana", "Control de permisos"] },
];
---
<Base title={`Sectores — ${SITE.name}`} description="Automatización e IA aplicada a servicios profesionales, comercio, operaciones y equipos de conocimiento.">
  <section data-reveal class="mx-auto max-w-6xl px-6 pb-10 pt-24 sm:pt-32">
    <p class="eyebrow">Sectores</p>
    <h1 class="display-title mt-4 max-w-5xl">Mismo método.<br /><span>Problemas distintos.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Explora ejemplos de procesos que podríamos estudiar contigo. Cada propuesta depende de herramientas, datos, riesgos y aprobación del equipo responsable.</p>
    <p role="note" class="mt-6 max-w-3xl rounded-2xl border border-amber-500/25 bg-amber-50 p-5 text-sm leading-6 text-amber-950 dark:bg-amber-950/30 dark:text-amber-100"><strong>Ejemplo de diseño, no un sistema implantado:</strong> estas páginas no son casos de clientes ni resultados de VARINO. Las cifras de la calculadora dependen de supuestos introducidos por quien la usa; no son métricas observadas.</p>
  </section>
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-5 md:grid-cols-2">
      {sectores.map((s) => (
        <article data-reveal class="rounded-3xl border border-black/8 p-7 dark:border-white/10">
          <h2 class="text-xl font-semibold">{s.n}</h2>
          <p class="mt-1 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">{s.e}</p>
          <p class="mt-4 text-sm leading-6">{s.dolor}</p>
          <p class="mt-4 text-xs font-bold text-[#0071e3]">Idea de flujo a evaluar</p>
          <ul class="mt-2 space-y-1.5 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">{s.montamos.map((m) => <li>· {m}</li>)}</ul>
          {s.href && (
            <a href={s.href} class="mt-5 inline-flex items-center gap-1 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline">
              {s.linkLabel || "Ver solución sectorial →"}
            </a>
          )}
        </article>
      ))}
    </div>
    <a href={`${BASE}/experiencia/`} class="button-primary mt-8 inline-flex">Explorar mi proceso con la guía</a>
  </section>
  <Cta titulo="¿Tu sector no está aquí?" texto="Cuéntanos el proceso que te quita horas: si no encaja, te lo diremos igualmente." />
</Base>
