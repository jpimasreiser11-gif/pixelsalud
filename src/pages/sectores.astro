---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { BASE, SITE } from "../config";
const sectores = [
  { n: "Clínicas y centros de salud", e: "clínicas dentales, policlínicas, centros médicos en Barcelona", dolor: "Recepción saturada a primera hora, pre-anamnesis en papel que retrasa el gabinete y ausentismo no avisado que deja sillones vacíos.", montamos: ["Triaje asistido de solicitudes", "Pre-anamnesis digital antes de gabinete", "Confirmación activa y reasignación de huecos"], href: `${BASE}/sectores/clinicas/`, linkLabel: "Ver solución para Clínicas en Barcelona →" },
  { n: "Cirugía estética y dermatología", e: "clínicas de medicina estética, cirugía plástica y dermatología en Barcelona", dolor: "Pérdida de pacientes de alto ticket que solicitan cita por Instagram o web fuera de horario y esperan 12 horas a que abra recepción.", montamos: ["Triaje en menos de 60 segundos 24/7", "Pre-evaluación médica con imágenes cifradas", "Captura y agendamiento prioritario alto ticket"], href: `${BASE}/sectores/estetica/`, linkLabel: "Ver solución para Clínicas Estéticas en Barcelona →" },
  { n: "Inmobiliarias de alto standing", e: "agencias boutique, brokers y consultores prime en Barcelona", dolor: "El 70% de solicitudes de portales no tienen solvencia real y los consultores pierden horas en gestiones que no cierran operaciones.", montamos: ["Filtro automatizado de compradores VIP", "Pre-KYC y verificación de fondos (Ley 10/2010)", "Coordinación de visitas privadas con credencial"], href: `${BASE}/sectores/inmobiliarias/`, linkLabel: "Ver solución para Inmobiliarias Prime en Barcelona →" },
  { n: "Sector legal y tributario", e: "bufetes de abogados, asesorías fiscales y despachos tributarios en Barcelona", dolor: "Horas de letrados consumidas descargando notificaciones de sedes electrónicas, cotejando modelos tributarios y clasificando consultas.", montamos: ["Ingesta de notificaciones (LexNET, DEHú, AEAT)", "Extracción y cotejo de escrituras y modelos tributarios", "Triaje multicanal de consultas por especialidad"], href: `${BASE}/sectores/legal/`, linkLabel: "Ver solución para Despachos en Barcelona →" },
  { n: "Hospitales y clínicas veterinarias 24h", e: "hospitales veterinarios de referencia, UCI y urgencias 24h en Barcelona", dolor: "Guardias nocturnas colapsadas por dudas leves mientras se pierden urgencias quirúrgicas críticas de 1.000 € a 4.000 € por falta de respuesta inmediata.", montamos: ["Triaje automatizado de urgencias 24/7 en WhatsApp", "Clasificación clínica rojo/amarillo/verde en <45s", "Pre-aviso directo a quirófano UCI y preparación de box"], href: `${BASE}/sectores/veterinarias/`, linkLabel: "Ver solución para Hospitales Veterinarios en Barcelona →" },
  { n: "Oftalmología y cirugía refractiva", e: "clínicas oftalmológicas, centros de microcirugía ocular y láser en Barcelona", dolor: "Pérdida de pacientes de cirugía refractiva o lentes intraoculares (>2.000 € ticket) que preguntan por WhatsApp/web de noche y no esperan 12h a recibir respuesta.", montamos: ["Test de idoneidad refractiva automatizado en <60s", "Precalificación de dioptrías y edad con triaje protocolizado", "Confirmación de cita diagnóstica y pautas prequirúrgicas"], href: `${BASE}/sectores/oftalmologia/`, linkLabel: "Ver solución para Clínicas Oftalmológicas en Barcelona →" },
  { n: "Fertilidad y reproducción asistida", e: "clínicas de fertilidad, centros de reproducción humana, FIV y método ROPA en Barcelona", dolor: "Pacientes con alta carga emocional que consultan fuera de horario y esperan días para aclarar dudas sobre tratamientos de alto valor (>5.000 €), perdiéndose frente a la competencia.", montamos: ["Triaje confidencial multicanal 24/7 en WhatsApp", "Precalificación de perfil reproductivo en 45s", "Agenda coordinada de estudio de fertilidad en pareja"], href: `${BASE}/sectores/fertilidad/`, linkLabel: "Ver solución para Clínicas de Fertilidad en Barcelona →" },
  { n: "Traumatología y cirugía ortopédica", e: "institutos de traumatología, centros ortopédicos, cirugía articular y artroscopia en Barcelona", dolor: "Pacientes con lesiones agudas y pruebas de RMN que esperan días para ser triados, reasignaciones de agenda erróneas y fuga de intervenciones de alto ticket (>3.500 €).", montamos: ["Triaje anatómico articular inmediato en WhatsApp", "Ingesta estructurada de informes de RMN y TAC", "Asignación directa a subunidad y consulta de alta resolución"], href: `${BASE}/sectores/traumatologia/`, linkLabel: "Ver solución para Traumatología en Barcelona →" },
  { n: "Servicios profesionales", e: "asesorías, gestorías, consultoras, agencias, despachos", dolor: "Cada cierre mensual empieza reuniendo y clasificando documentación que llega por correo, portal o WhatsApp.", montamos: ["Entrada unificada de documentos", "Clasificación y avisos", "Seguimiento comercial sin Excel"] },
  { n: "Comercio y ecommerce", e: "tiendas, distribución, retail", dolor: "Pedidos, stock y devoluciones se copian a mano entre la tienda, el ERP y el transportista.", montamos: ["Sincronización de pedidos y stock", "Avisos de incidencias", "Informes de ventas automáticos"] },
  { n: "Operaciones", e: "logística, administración, soporte", dolor: "El equipo copia datos entre herramientas y descubre los errores cuando ya es tarde.", montamos: ["Flujos observables con errores controlados", "Excepciones y recuperación manual", "Panel de actividad"] },
  { n: "Equipos de conocimiento", e: "documentación, formación, compliance", dolor: "El conocimiento está repartido y responder dudas repetidas consume horas.", montamos: ["Buscador sobre vuestros documentos", "Asistentes con permisos", "IA local para datos sensibles"] },
];
---
<Base title={`Sectores — ${SITE.name}`} description="Automatización e IA aplicada a servicios profesionales, comercio, operaciones y equipos de conocimiento.">
  <section data-reveal class="mx-auto max-w-6xl px-6 pb-10 pt-24 sm:pt-32">
    <p class="eyebrow">Sectores</p>
    <h1 class="display-title mt-4 max-w-5xl">Mismo método.<br /><span>Problemas distintos.</span></h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Estos son los sectores donde más se repite el trabajo manual. Elige el tuyo y verás qué automatizamos primero.</p>
  </section>
  <section class="mx-auto max-w-6xl px-6 pb-20">
    <div class="grid gap-5 md:grid-cols-2">
      {sectores.map((s) => (
        <article data-reveal class="rounded-3xl border border-black/8 p-7 dark:border-white/10">
          <h2 class="text-xl font-semibold">{s.n}</h2>
          <p class="mt-1 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">{s.e}</p>
          <p class="mt-4 text-sm leading-6">{s.dolor}</p>
          <p class="mt-4 text-xs font-bold text-[#0071e3]">Qué montamos</p>
          <ul class="mt-2 space-y-1.5 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">{s.montamos.map((m) => <li>· {m}</li>)}</ul>
          {s.href && (
            <a href={s.href} class="mt-5 inline-flex items-center gap-1 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline">
              {s.linkLabel || "Ver solución sectorial →"}
            </a>
          )}
        </article>
      ))}
    </div>
    <a href={`${BASE}/reservar/`} class="button-primary mt-8 inline-flex">Reservar una llamada</a>
  </section>
  <Cta titulo="¿Tu sector no está aquí?" texto="Cuéntanos el proceso que te quita horas: si no encaja, te lo diremos igualmente." />
</Base>
