---
import Base from "../../layouts/Base.astro";
---

<Base title="Varino Autopilot · Espacio de trabajo" description="Acceso seguro al espacio de trabajo de Varino Autopilot." noindex includeVisitorTools={false}>
  <section id="contenido" class="mx-auto min-h-[70vh] max-w-5xl px-6 pb-24 pt-20 sm:pt-28">
    <div class="mb-10 flex items-center justify-between gap-4">
      <div>
        <p class="eyebrow">VARINO AI · AUTOPILOT</p>
        <h1 class="mt-3 text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">Tu espacio de trabajo.</h1>
      </div>
      <a class="button-secondary shrink-0" href="/">Volver a Varino</a>
    </div>

    <div class="grid gap-6 lg:grid-cols-[1fr_.85fr]">
      <section class="rounded-[2rem] border border-black/10 bg-[#f7f7f5] p-7 dark:border-white/10 dark:bg-[#111318] sm:p-9" aria-labelledby="access-title">
        <div id="access-status" class="mb-6 rounded-xl border border-[#0071e3]/20 bg-[#0071e3]/5 px-4 py-3 text-sm text-[#1d1d1f] dark:text-[#f5f5f7]" role="status" aria-live="polite" hidden></div>
        <div id="guest-view">
          <p class="eyebrow">Acceso a la plataforma</p>
          <h2 id="access-title" class="mt-3 text-3xl font-semibold tracking-[-0.04em]">Empieza con una identidad verificada.</h2>
          <p class="mt-4 max-w-xl text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">En esta primera fase, el acceso usa Google solo para confirmar quién eres. No pedimos acceso a Gmail, Drive ni a otras aplicaciones de tu empresa.</p>
          <button id="google-sign-in" type="button" class="mt-7 inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-[#0071e3] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#0077ed] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0071e3]">
            <span aria-hidden="true" class="text-lg leading-none">G</span>
            Continuar con Google
          </button>
          <p class="mt-4 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">Tu sesión se guarda en una cookie protegida y puede cerrarse desde este espacio.</p>
        </div>

        <div id="account-view" hidden>
          <p class="eyebrow">Sesión segura</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em]">Bienvenido a Autopilot.</h2>
          <p id="account-email" class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6]"></p>
          <div id="workspace-list-view" class="mt-8" hidden>
            <h3 class="text-lg font-semibold">Tus espacios</h3>
            <ul id="workspace-list" class="mt-3 grid gap-2"></ul>
            <p class="mt-4 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">La gestión de varios espacios y miembros llegará en una fase posterior; aquí no se muestran estadísticas ni automatizaciones que todavía no estén conectadas.</p>
          </div>
          <form id="workspace-form" class="mt-8" hidden>
            <label for="workspace-name" class="block text-sm font-semibold">¿Cómo se llama tu empresa o equipo?</label>
            <p class="mt-1 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">Este será tu primer espacio. Puedes cambiar el nombre más adelante.</p>
            <input id="workspace-name" name="name" required minlength="2" maxlength="80" autocomplete="organization" class="mt-4 min-h-12 w-full rounded-xl border border-black/15 bg-white px-4 text-sm outline-none focus:border-[#0071e3] focus:ring-2 focus:ring-[#0071e3]/20 dark:border-white/15 dark:bg-black" />
            <button id="create-workspace" type="submit" class="button-primary mt-4">Crear espacio</button>
          </form>
          <button id="sign-out" type="button" class="button-secondary mt-8">Cerrar sesión</button>
        </div>
      </section>

      <aside class="rounded-[2rem] border border-black/10 p-7 dark:border-white/10 sm:p-9">
        <p class="eyebrow">Construido por fases</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em]">Primero, una base que protege tu espacio.</h2>
        <ol class="mt-7 grid gap-5">
          <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0071e3]/10 text-xs font-bold text-[#0071e3]">1</span><div><h3 class="text-sm font-semibold">Identidad verificada</h3><p class="mt-1 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">Google confirma la cuenta; Varino guarda un identificador y el correo verificado.</p></div></li>
          <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0071e3]/10 text-xs font-bold text-[#0071e3]">2</span><div><h3 class="text-sm font-semibold">Espacio propio</h3><p class="mt-1 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">Tu primer workspace se crea en el servidor y quedas como propietario.</p></div></li>
          <li class="flex gap-4"><span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#0071e3]/10 text-xs font-bold text-[#0071e3]">3</span><div><h3 class="text-sm font-semibold">Automatizaciones, después</h3><p class="mt-1 text-xs leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">No hay ejecuciones ni conexiones externas activas en esta fase.</p></div></li>
        </ol>
      </aside>
    </div>
  </section>

  <script>
    const statusBox = document.querySelector("#access-status");
    const guestView = document.querySelector("#guest-view");
    const accountView = document.querySelector("#account-view");
    const accountEmail = document.querySelector("#account-email");
    const workspaceListView = document.querySelector("#workspace-list-view");
    const workspaceList = document.querySelector("#workspace-list");
    const workspaceForm = document.querySelector("#workspace-form");
    const workspaceName = document.querySelector("#workspace-name");
    const createWorkspace = document.querySelector("#create-workspace");
    const signInButton = document.querySelector("#google-sign-in");
    const signOutButton = document.querySelector("#sign-out");

    const messages = {
      success: "Has iniciado sesión. A continuación puedes crear tu espacio de trabajo.",
      failed: "No se pudo completar el acceso. Comprueba la cuenta e inténtalo de nuevo.",
      unavailable: "El acceso aún no está configurado en este entorno.",
    };

    function announce(message) {
      if (!statusBox) return;
      statusBox.textContent = message;
      statusBox.hidden = false;
    }

    async function loadSession() {
      try {
        const response = await fetch("/api/auth/session", { credentials: "same-origin", cache: "no-store" });
        if (response.status === 401) return;
        if (!response.ok) throw new Error("service unavailable");
        const session = await response.json();
        if (session.authenticated !== true || !session.user || !Array.isArray(session.workspaces)) throw new Error("invalid response");
        if (guestView) guestView.hidden = true;
        if (accountView) accountView.hidden = false;
        if (accountEmail) accountEmail.textContent = session.user.email;
        if (session.workspaces.length) {
          if (workspaceListView) workspaceListView.hidden = false;
          if (workspaceForm) workspaceForm.hidden = true;
          if (workspaceList) {
            workspaceList.replaceChildren(...session.workspaces.map((workspace) => {
              const item = document.createElement("li");
              item.className = "rounded-xl border border-black/10 bg-white px-4 py-3 text-sm dark:border-white/10 dark:bg-black";
              const name = document.createElement("strong");
              name.textContent = workspace.name;
              const role = document.createElement("span");
              role.className = "ml-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6]";
              role.textContent = workspace.role;
              item.append(name, role);
              return item;
            }));
          }
        } else if (workspaceForm) {
          workspaceForm.hidden = false;
          if (workspaceListView) workspaceListView.hidden = true;
        }
      } catch {
        announce("La aplicación aún no está disponible en este entorno. No se ha creado ni guardado ningún dato.");
        if (signInButton) signInButton.disabled = true;
      }
    }

    const authResult = new URLSearchParams(window.location.search).get("auth");
    if (authResult && messages[authResult]) announce(messages[authResult]);
    if (authResult) history.replaceState(null, "", window.location.pathname);

    signInButton?.addEventListener("click", async () => {
      signInButton.disabled = true;
      signInButton.textContent = "Conectando con Google…";
      try {
        const response = await fetch("/api/auth/google/start", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
        });
        const result = await response.json();
        if (!response.ok || typeof result.authorizationUrl !== "string") {
          announce(messages.unavailable);
          return;
        }
        const target = new URL(result.authorizationUrl);
        if (target.origin !== "https://accounts.google.com" || target.pathname !== "/o/oauth2/v2/auth") {
          announce("No se pudo iniciar el acceso seguro.");
          return;
        }
        window.location.assign(target.toString());
      } catch {
        announce("No se pudo iniciar el acceso. Inténtalo de nuevo más tarde.");
      } finally {
        signInButton.disabled = false;
        signInButton.textContent = "Continuar con Google";
      }
    });

    workspaceForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!workspaceName || !createWorkspace) return;
      createWorkspace.disabled = true;
      try {
        const response = await fetch("/api/workspaces", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name: workspaceName.value }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error("workspace creation failed");
        announce(result.created ? "Tu espacio de trabajo está creado." : "Tu espacio de trabajo ya estaba creado.");
        await loadSession();
      } catch {
        announce("No se pudo crear el espacio. Revisa el nombre e inténtalo de nuevo.");
      } finally {
        createWorkspace.disabled = false;
      }
    });

    signOutButton?.addEventListener("click", async () => {
      signOutButton.disabled = true;
      try {
        const response = await fetch("/api/auth/logout", {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "content-type": "application/json" },
          body: "{}",
        });
        if (!response.ok) throw new Error("logout failed");
        window.location.replace("/app/");
      } catch {
        announce("No se pudo cerrar la sesión. Inténtalo de nuevo.");
        signOutButton.disabled = false;
      }
    });

    void loadSession();
  </script>
</Base>
