---
import Base from "../layouts/Base.astro";
import { BASE, SITE, hasContactChannel, BACKEND_LEAD } from "../config";

---

<Base
  title={`Contacto & Agendamiento — ${SITE.name} AI Studio`}
  description="Cuéntanos qué proceso quieres mejorar. Revisaremos el contexto, las herramientas y el resultado que buscas antes de proponer un alcance."
>
  <section class="mx-auto max-w-6xl px-6 pb-20 pt-20 sm:pt-28">
    <div class="grid gap-12 lg:grid-cols-2 items-start">
      <div>
        <p class="eyebrow">Plantear un proyecto</p>
        <h1 class="mt-4 text-4xl sm:text-6xl font-semibold tracking-[-0.05em] leading-[1.02]">
          Empecemos por el proceso, no por la herramienta.
        </h1>
        <p class="mt-4 text-[#86868b] leading-relaxed">
          Cuéntanos qué proceso quieres mejorar, quién lo realiza y con qué herramientas. Esa información permite preparar una primera conversación útil.
        </p>

        <div class="mt-8 space-y-3 text-sm">
          <div class="flex items-center gap-2.5">
            <span class="text-[#2997ff] font-bold">✓</span>
            <span>Primera conversación centrada en un proceso real</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-[#2997ff] font-bold">✓</span>
            <span>Revisión de viabilidad, dependencias y forma de medir</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-[#2997ff] font-bold">✓</span>
            <span>Alcance y presupuesto por escrito antes de construir</span>
          </div>
        </div>

        <div class="mt-10 pt-8 border-t border-[#424245]/30">
          <p class="text-xs text-[#86868b] mb-2">Canal de contacto:</p>
          {SITE.email ? (
            <a href={`mailto:${SITE.email}`} class="text-sm font-semibold text-[#2997ff] hover:underline">{SITE.email}</a>
          ) : (
            <p class="text-sm text-[#6e6e73] dark:text-[#a1a1a6]">Estamos terminando la apertura pública. Mientras tanto puedes preparar y copiar el briefing sin que salga de tu dispositivo.</p>
          )}
        </div>
      </div>

      <!-- Contact Form -->
      <form
        id="form-contacto"
        data-email={SITE.email}
        data-lead={BACKEND_LEAD}
        class="rounded-3xl border border-black/10 bg-[#f7f7f5] p-6 shadow-sm space-y-4 dark:border-white/10 dark:bg-[#111318] sm:p-8"
      >
        {!hasContactChannel && (
          <p class="rounded-xl border border-black/8 bg-white p-3 text-xs text-[#6e6e73] dark:border-white/10 dark:bg-black/20 dark:text-[#a1a1a6]">
            Modo privado: prepara el briefing y cópialo. Nada se envía ni se almacena.
          </p>
        )}
        <p class="font-semibold text-lg">Briefing inicial</p>

        <div class="space-y-4">
          <div>
            <label for="contacto-nombre" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Nombre completo</label>
            <input
              id="contacto-nombre"
              type="text"
              name="nombre"
              required
              placeholder="Tu nombre"
              class="contact-field"
            />
          </div>

          <div>
            <label for="contacto-negocio" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Empresa / organización</label>
            <input
              id="contacto-negocio"
              type="text"
              name="negocio"
              required
              placeholder="Nombre de tu empresa"
              class="contact-field"
            />
          </div>

          <div>
            <label for="contacto-web" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Sitio web o software</label>
            <input
              id="contacto-web"
              type="text"
              name="web"
              placeholder="https://empresa.com"
              class="contact-field"
            />
          </div>

          <div>
            <label for="contacto-servicio" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Servicio de interés</label>
            <select
              id="contacto-servicio"
              name="servicio"
              class="contact-field"
            >
              <option>Diagnóstico inicial</option>
              <option>Automatización de procesos</option>
              <option>Producto o asistente con IA</option>
              <option>Sistema comercial</option>
              <option>Otro caso</option>
            </select>
          </div>

          <div>
            <label for="contacto-mensaje" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Detalles del proyecto</label>
            <textarea
              id="contacto-mensaje"
              name="mensaje"
              rows="3"
              placeholder="Cuéntanos brevemente qué te gustaría automatizar o desarrollar..."
              class="contact-field"
            ></textarea>
          </div>

          <div>
            <label for="contacto-email" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Email</label>
            <input id="contacto-email" type="email" name="email" required placeholder="tu@email.com" class="contact-field" />
          </div>

          <div>
            <label for="contacto-whatsapp" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">WhatsApp (opcional)</label>
            <input id="contacto-whatsapp" type="tel" name="whatsapp" placeholder="+34 600 000 000" class="contact-field" />
          </div>

          <button
            type="submit"
            class="w-full rounded-full bg-[#0071e3] px-6 py-3 font-semibold text-white transition hover:bg-[#0077ed] text-xs shadow-lg shadow-[#0071e3]/20"
          >
            {hasContactChannel ? "Enviar solicitud →" : "Copiar briefing →"}
          </button>

          <label class="flex items-start gap-2 text-[11px] leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">
            <input type="checkbox" name="consentimiento" required class="mt-0.5 shrink-0" />
            <span>Acepto que VARINO guarde estos datos para contactarme, según su <a href={`${BASE}/privacidad/`} class="underline hover:text-[#0071e3]">política de privacidad</a>.</span>
          </label>

          <p class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6] text-center" aria-live="polite" data-form-status>
            No incluyas información confidencial o datos personales de terceros.
          </p>
        </div>
      </form>
    </div>
  </section>

  <script>
    (function () {
      var form = document.getElementById("form-contacto");
      if (!form) return;
      var lead = form.getAttribute("data-lead") || "";
      var statusEl = form.querySelector("[data-form-status]");
      function val(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }
      function servicioAI(nombre) {
        var map = {
          "Automatización de procesos": "automation-sprint",
          "Sistema comercial": "growth-system",
          "Producto o asistente con IA": "private-ai",
        };
        return map[nombre] || "otro";
      }
      function abrirMailto() {
        var destinatario = form.getAttribute("data-email") || "";
        var asunto = "Consulta de Proyecto: " + val("negocio");
        var cuerpo =
          "Nombre: " + val("nombre") + "\n" +
          "Email: " + val("email") + "\n" +
          "Empresa: " + val("negocio") + "\n" +
          "Servicio: " + val("servicio") + "\n\n" +
          "Mensaje: " + val("mensaje");
        window.location.href = "mailto:" + destinatario + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);
      }
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var nombre = val("nombre");
        var email = val("email");
        var whatsapp = val("whatsapp");
        var consent = form.querySelector('[name="consentimiento"]').checked;
        if (!consent) { if (statusEl) statusEl.textContent = "Necesitamos tu consentimiento para contactarte."; return; }
        if (lead) {
          if (statusEl) statusEl.textContent = "Enviando…";
          var payload = {
            nombre: nombre,
            email: email,
            whatsapp: whatsapp,
            empresa: val("negocio"),
            interes: servicioAI(val("servicio")),
            fuente: "form-contacto",
            pagina: location.pathname,
            consentimiento: true,
            mensaje: val("mensaje"),
          };
          fetch(lead, {
            method: "POST",
            headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true" },
            body: JSON.stringify(payload),
          }).then(function (r) { return r.json(); }).then(function (d) {
            if (d && d.ok) {
              if (statusEl) statusEl.textContent = "✓ Recibido. El equipo de VARINO te escribirá en breve.";
              form.reset();
            } else {
              abrirMailto();
            }
          }).catch(function () { abrirMailto(); });
        } else {
          // Sin backend (web estática): plantilla por correo como antes.
          navigator.clipboard.writeText("Nombre: " + val("nombre") + "\nEmail: " + email + "\nEmpresa: " + val("negocio") + "\n\n" + val("mensaje"))
            .then(function () { if (statusEl) statusEl.textContent = "Briefing copiado."; })
            .catch(function () { abrirMailto(); });
        }
      });
    })();
  </script>

  <style>
    .contact-field { width: 100%; border-radius: .75rem; border: 1px solid rgb(0 0 0 / .12); background: white; padding: .7rem 1rem; font-size: .875rem; color: #1d1d1f; outline: none; transition: border-color .2s, box-shadow .2s; }
    .contact-field:focus { border-color: #0071e3; box-shadow: 0 0 0 3px rgb(0 113 227 / .12); }
    :global(.dark) .contact-field { border-color: rgb(255 255 255 / .14); background: #050506; color: #f5f5f7; }
  </style>
</Base>
