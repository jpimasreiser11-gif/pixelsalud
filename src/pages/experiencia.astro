---
import Base from "../layouts/Base.astro";
import InteractiveMissions from "../components/InteractiveMissions.astro";
import { SITE } from "../config";
---

<Base title={`Experiencia guiada por IA — ${SITE.name}`} description="Describe tu proceso con lenguaje natural y visualiza una arquitectura de automatización sin enviar ni guardar datos.">
  <section class="mx-auto max-w-6xl px-6 pb-10 pt-20 sm:pt-28">
    <p class="eyebrow">Diseñador conversacional</p>
    <h1 class="display-title max-w-5xl">Entender haciendo.<br /><span>Decidir con control.</span></h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Habla con la guía como hablarías con un consultor. Mientras responde, verás cómo tu necesidad se convierte en un sistema visual. No conecta con tus herramientas ni ejecuta acciones sin revisión y aprobación.</p>
  </section>
  <InteractiveMissions />
</Base>
