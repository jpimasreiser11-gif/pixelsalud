---
import Base from "../layouts/Base.astro";
import InteractiveMissions from "../components/InteractiveMissions.astro";
import { SITE } from "../config";
---

<Base title={`Experiencia interactiva — ${SITE.name}`} description="Simula decisiones reales de automatización e IA sin enviar datos ni asumir resultados.">
  <section class="mx-auto max-w-6xl px-6 pb-10 pt-20 sm:pt-28">
    <p class="eyebrow">Simulador estratégico</p>
    <h1 class="display-title max-w-5xl">Entender haciendo.<br /><span>Decidir con control.</span></h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Casos demostrativos inspirados en problemas operativos comunes. Ninguno representa un cliente real ni promete un resultado.</p>
  </section>
  <InteractiveMissions />
</Base>
