---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD } from "../config";
---

<Base title={`Diagnóstico CAIO — ${SITE.name}`} description="Diagnóstico de procesos, automatización e IA con mapa de prioridades, riesgos y presupuesto trazable.">
  <section class="mx-auto max-w-6xl px-6 pb-12 pt-24 sm:pt-32">
    <p class="eyebrow">Diagnóstico CAIO</p>
    <h1 class="display-title max-w-5xl">Antes de automatizar,<br /><span>decidimos qué merece existir.</span></h1>
    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_.55fr]">
      <p class="max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">VARINO AI ordena una primera conversación en el chat (abajo a la derecha). El diagnóstico profesional valida el proceso, prioriza oportunidades y deja por escrito alcance, riesgos y siguiente inversión.</p>
      <div class="border-l border-black/10 pl-6 dark:border-white/10"><span class="text-xs text-[#6e6e73]">Precio cerrado</span><strong class="mt-1 block text-3xl">290 € + IVA</strong><p class="mt-2 text-xs leading-5 text-[#6e6e73]">Se descuenta íntegramente si contratas la implementación propuesta.</p></div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-8">
    <div class="grid gap-px overflow-hidden border-y border-black/10 bg-black/10 dark:border-white/10 dark:bg-white/10 md:grid-cols-3">
      {[['01','Entender','Entrevista sobre proceso, personas, datos, herramientas y excepciones.'],['02','Priorizar','Matriz impacto, esfuerzo, riesgo y dependencia con una recomendación concreta.'],['03','Entregar','Diagnóstico, mapa del bucle, arquitectura inicial y presupuesto con supuestos.']].map(([n,t,d]) => <article class="bg-white px-6 py-8 dark:bg-[#050505]"><span class="text-xs font-bold text-[#0071e3]">{n}</span><h2 class="mt-8 text-2xl font-semibold">{t}</h2><p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{d}</p></article>)}
    </div>
  </section>


  <section class="mx-auto max-w-3xl px-6 pb-6">
    <div class="rounded-3xl border border-black/10 bg-[#f7f7f5] p-7 dark:border-white/10 dark:bg-[#111318] sm:p-9">
      <p class="eyebrow">Diagnóstico gratuito</p>
      <h2 class="mt-2 text-2xl font-semibold sm:text-3xl">¿Prefieres que el equipo de {SITE.name} te escriba?</h2>
      <p class="mt-2 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">Te contactamos para una primera conversación sin compromiso y preparamos un mapa de tu proceso.</p>

      <form id="form-auditoria" data-lead={BACKEND_LEAD} class="mt-6 space-y-3">
        <input type="hidden" name="website" value="" aria-hidden="true" tabindex="-1" autocomplete="off" />
        <div class="grid gap-3 sm:grid-cols-2">
          <div>
            <label for="aud-nombre" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Nombre</label>
            <input id="aud-nombre" name="nombre" type="text" required placeholder="Tu nombre" class="contact-field" />
          </div>
          <div>
            <label for="aud-email" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Email</label>
            <input id="aud-email" name="email" type="email" placeholder="tu@email.com" class="contact-field" />
          </div>
          <div>
            <label for="aud-whatsapp" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">WhatsApp</label>
            <input id="aud-whatsapp" name="whatsapp" type="tel" placeholder="+34 600 000 000" class="contact-field" />
          </div>
          <div>
            <label for="aud-interes" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">¿Qué te interesa?</label>
            <select id="aud-interes" name="interes" class="contact-field">
              <option value="otro">Todavía no lo sé / otro</option>
              <option value="automation-sprint">Automatizar un proceso concreto</option>
              <option value="growth-system">Sistema de captación y seguimiento</option>
              <option value="private-ai">IA privada o asistente</option>
            </select>
          </div>
        </div>
        <label class="flex items-start gap-2 text-[11px] leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">
          <input type="checkbox" name="consentimiento" value="true" required class="mt-0.5 shrink-0" />
          <span>Acepto que VARINO guarde estos datos para contactarme, según su <a href={`${BASE}/privacidad/`} class="underline hover:text-[#0071e3]">política de privacidad</a>.</span>
        </label>
        <button type="submit" class="w-full rounded-full bg-[#0071e3] px-6 py-3 font-semibold text-white transition hover:bg-[#0077ed] text-xs shadow-lg shadow-[#0071e3]/20 sm:w-auto">
          Quiero que me contacten →
        </button>
        <p class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6]" aria-live="polite" data-form-status></p>
      </form>
    </div>
  </section>

  <script>
    (function () {
      var form = document.getElementById("form-auditoria");
      if (!form) return;
      var statusEl = form.querySelector("[data-form-status]");
      function val(n) { var el = form.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ""; }
      form.addEventListener("submit", function (ev) {
        ev.preventDefault();
        var nombre = val("nombre"), email = val("email"), whatsapp = val("whatsapp");
        var consent = form.querySelector('[name="consentimiento"]').checked;
        if (!consent) { if (statusEl) statusEl.textContent = "Necesitamos tu consentimiento para contactarte."; return; }
        if (!email && !whatsapp) { if (statusEl) statusEl.textContent = "Indica un email o un WhatsApp para poder contactarte."; return; }
        var lead = form.getAttribute("data-lead");
        if (!lead) { if (statusEl) statusEl.textContent = "El envío aún no está disponible. Escríbenos a varinoagency@gmail.com."; return; }
        if (statusEl) statusEl.textContent = "Enviando…";
        fetch(lead, {
          method: "POST",
          headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true" },
          body: JSON.stringify({
            nombre: nombre, email: email, whatsapp: whatsapp, empresa: "",
            interes: val("interes") || "otro", fuente: "form-auditoria",
            pagina: location.pathname, consentimiento: true,
            mensaje: "Ha completado el formulario del diagnóstico CAIO en /auditoria."
          })
        }).then(function (r) { return r.json(); }).then(function (d) {
          if (d && d.ok) { if (statusEl) statusEl.textContent = "✓ Recibido. El equipo de VARINO te escribirá en breve."; form.reset(); }
          else if (statusEl) statusEl.textContent = "No se pudo enviar. Escríbenos a varinoagency@gmail.com.";
        }).catch(function () {
          if (statusEl) statusEl.textContent = "Sin conexión. Escríbenos a varinoagency@gmail.com.";
        });
      });
    })();
  </script>

  <Cta titulo="Convierte la conversación en un plan revisado." texto="El precio, plazo y retorno solo se confirman después de validar la información con una persona." />

  <style>
    .contact-field { width: 100%; border-radius: .75rem; border: 1px solid rgb(0 0 0 / .12); background: white; padding: .7rem 1rem; font-size: .875rem; color: #1d1d1f; outline: none; transition: border-color .2s, box-shadow .2s; }
    .contact-field:focus { border-color: #0071e3; box-shadow: 0 0 0 3px rgb(0 113 227 / .12); }
    :global(.dark) .contact-field { border-color: rgb(255 255 255 / .14); background: #050506; color: #f5f5f7; }
  </style>
</Base>
