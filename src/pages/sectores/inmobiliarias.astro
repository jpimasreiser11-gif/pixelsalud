---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de filtro de compradores VIP y pre-KYC para inmobiliarias de alto standing de VARINO."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Filtro Automatizado de Compradores VIP y Pre-KYC para Inmobiliarias Prime en Barcelona",
  provider: {
    "@type": "RealEstateAgent",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Filtro automatizado de compradores VIP, pre-calificación de solvencia y pre-KYC según Ley 10/2010 para agencias inmobiliarias boutique y consultores de alto standing en Barcelona.",
  serviceType: "Automatización Inmobiliaria Prime y Cumplimiento PBC",
});
---

<Base
  title="Inmobiliarias de Alto Standing en Barcelona"
  description="Filtro automatizado de compradores VIP, pre-calificación de solvencia y pre-KYC (Ley 10/2010) para agencias inmobiliarias de lujo en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Inmobiliarias de Alto Standing</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-amber-500/20 bg-amber-500/10 px-3.5 py-1 text-xs font-semibold text-amber-700 dark:text-amber-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-amber-500 live-dot"></span>
        <span>Prime Real Estate · Barcelona · Pre-KYC Ley 10/2010 Compliant</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Inmobiliarias boutique y propiedades de lujo</p>
        <h1 class="display-title mt-4">
          Filtro automatizado de compradores VIP.<br />
          <span>Pre-calificación y visitas privadas.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores de agencias inmobiliarias boutique, consultores prime y brokers</strong> de propiedades exclusivas en Barcelona (Pedralbes, Sarrià, Eixample Dret, Turó Park y Costa del Garraf). Filtre automáticamente el 70% de solicitudes de portales que carecen de capacidad financiera real y libere a sus consultores para cerrar operaciones de alto valor.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular capacidad recuperable →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta confidencial por WhatsApp ↗
            </a>
          )}
        </div>

        <!-- Trust Highlights -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-black/8 dark:border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Filtro de portales</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Idealista, Fotocasa, JamesEdition</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Cumplimiento normativo</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Pre-KYC & Ley 10/2010 (PBC)</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Discreción propietaria</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Cero visitas no cualificadas</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Zona Prime</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Barcelona & Costa Catalana</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EL CUELLO DE BOTELLA EN INMOBILIARIAS PRIME -->
  <section class="py-20 sm:py-28 bg-[#f7f7f5] dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El desafío del alto standing</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          El tiempo de los consultores sénior es el activo más caro de la agencia.
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          En el mercado inmobiliario de alta gama en Barcelona, una propiedad singular genera cientos de contactos por portales generalistas y de lujo. Gestionar manualmente ese volumen diluye la atención en los compradores reales.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <!-- Friccion 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-sm">
            01
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            El 70% de solicitudes no cualificadas
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Contactos sin capacidad financiera demostrable, curiosos o intermediarios no acreditados que colapsan los correos y teléfonos de los agentes. Días enteros dedicados a descartar perfiles sin solvencia.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Pérdida de hasta 15 horas semanales por agente en llamadas y correos infructuosos.
          </div>
        </article>

        <!-- Friccion 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 font-bold text-sm">
            02
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Riesgo y molestia para los propietarios
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Llevar visitas presenciales a inmuebles habitados de alta gama sin verificar antes la identidad y solvencia del comprador genera fricción con el vendedor y degrada la exclusividad del mandato de venta.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Pérdida de confianza de propietarios VIP y riesgo de cancelación de exclusivas.
          </div>
        </article>

        <!-- Friccion 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-sm">
            03
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Exigencias de Blanqueo de Capitales (Ley 10/2010)
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            La normativa de Prevención de Blanqueo de Capitales (PBC) exige identificar formalmente a los compradores y titulares reales antes de formalizar operaciones inmobiliarias. Gestionarlo en papel o emails dispersos multiplica el riesgo sancionador del SEPBLAC.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Vulnerabilidad legal y retrasos innecesarios al formalizar el contrato de arras.
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- LA SOLUCIÓN: AUTOMATION SPRINT PARA INMOBILIARIAS PRIME -->
  <section id="solucion" class="py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-3xl">
        <p class="eyebrow">La arquitectura para el sector prime</p>
        <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Filtro Inteligente de Compradores VIP y Visitas Privadas
        </h2>
        <p class="mt-5 text-lg text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          Conectamos la entrada de consultas de los portales y canales directos con un sistema que cualifica el perfil financiero del interesado, recopila documentación conforme a la Ley 10/2010 y prepara la visita exclusiva para el consultor.
        </p>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <!-- Pillar 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 01</span>
            <span class="rounded-full bg-amber-500/10 px-3 py-0.5 text-xs font-medium text-amber-700 dark:text-amber-400">Pre-Cualificación</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Triaje multicanal de portales inmobiliarios
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Captura unificada de solicitudes procedentes de Idealista, Fotocasa, JamesEdition, web corporativa y WhatsApp profesional.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Cuestionario de pre-calificación en menos de 2 minutos sobre plazos, disponibilidad de fondos y método de pago (fondos propios o financiación).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Filtrado automático del 70% de solicitudes que no alcanzan el perfil financiero de la propiedad.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Notificación prioritaria al consultor sénior con los compradores que acreditan solvencia inmediata.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 02</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Ley 10/2010 PBC</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Flujo de Pre-KYC y custodia documental segura
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Recopilación estructurada y cifrada de documentación de diligencia debida antes de organizar visitas o compartir dossieres confidenciales de venta.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Verificación de identidad (DNI, NIE, Pasaporte) y titularidad real en caso de vehículos societarios.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Firma digital previa de Acuerdo de Confidencialidad (NDA) para propiedades Off-Market.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Almacenamiento seguro conforme al RGPD y auditoría lista para inspecciones del SEPBLAC.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 03</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Agenda Exclusiva</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Coordinación de visitas privadas con credencial
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Coordinación de agendas entre el comprador cualificado, el consultor asignado a la propiedad y la disponibilidad del propietario o conserjería.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Envío automático de hoja de visita digital con geolocalización, código de acceso y ficha resumida.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Confirmación interactiva 24 horas antes por WhatsApp para evitar cancelaciones de última hora.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Control humano integral: el consultor valida y aprueba cada visita antes de emitir la cita.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 4 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 04</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Sincronización CRM</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Integración con el CRM inmobiliario del despacho
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Los datos del comprador VIP, su nivel de solvencia acreditado y las notas de visita se vuelcan directamente en vuestro software habitual.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Compatibilidad con Inmovilla, Mobilia, HabitatSoft, Salesforce o sistemas propios mediante webhook o API.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Etiquetado automático del comprador por rango de presupuesto y tipología de activo buscado.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Sin necesidad de cambiar de software inmobiliario ni duplicar registros manuales.</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- CALCULADORA INTERACTIVA DE CAPACIDAD PARA INMOBILIARIAS -->
  <section id="calculadora" class="py-24 sm:py-32 bg-[#f7f7f5] dark:bg-[#0a0d14] border-y border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Calculadora de Productividad Prime</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Calcula las horas recuperadas para cerrar operaciones de alto valor
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          Evalúa cuántas horas de consultores se liberan al automatizar el filtro del 70% de solicitudes no cualificadas de los portales.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-[2.5rem] border border-black/10 bg-white p-6 sm:p-10 dark:border-white/10 dark:bg-[#111318] shadow-xl">
        <div class="grid gap-10 lg:grid-cols-12 items-start">
          <!-- Parámetros (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
              1. Cartera de la agencia
            </h3>

            <!-- Número de propiedades en cartera -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-propiedades" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Número de propiedades activas en cartera
                </label>
                <span id="label-propiedades" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">25 propiedades</span>
              </div>
              <input
                id="calc-propiedades"
                type="range"
                min="10"
                max="100"
                step="5"
                value="25"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <div class="flex justify-between text-[11px] text-[#86868b] mt-1">
                <span>10 (Boutique)</span>
                <span>50 (Agencia media)</span>
                <span>100+ (Firma Prime)</span>
              </div>
            </div>

            <!-- Precio medio de inmueble -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-precio" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Precio medio de los inmuebles en cartera
                </label>
                <span id="label-precio" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">1.800.000 €</span>
              </div>
              <input
                id="calc-precio"
                type="range"
                min="800000"
                max="5000000"
                step="100000"
                value="1800000"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <p class="text-xs text-[#86868b] mt-1">
                Desde pisos singulares en Eixample Dret (800k–1.5M€) hasta villas en Pedralbes o Sitges (3M–5M€+).
              </p>
            </div>

            <!-- Horas semanales invertidas en filtrar consultas -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-horas-filtro" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Horas semanales dedicadas por agente a cribar solicitudes de portales
                </label>
                <span id="label-horas-filtro" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">10 horas / semana</span>
              </div>
              <input
                id="calc-horas-filtro"
                type="range"
                min="5"
                max="20"
                step="1"
                value="10"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <p class="text-xs text-[#86868b] mt-1">
                Llamadas de comprobación, correos de respuesta inicial y descarte de contactos sin solvencia.
              </p>
            </div>
          </div>

          <!-- Resultados dinámicos (5 cols) -->
          <div class="lg:col-span-5 rounded-3xl border border-black/8 bg-[#f7f7f5] p-6 sm:p-8 dark:border-white/10 dark:bg-[#161617] space-y-6">
            <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-4">
              <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">Capacidad Recuperada</span>
              <span class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6]">Base 45 semanas hábiles</span>
            </div>

            <div class="space-y-4">
              <div>
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Horas profesionales liberadas al año por consultor:</span>
                <strong id="res-horas-inmo" class="mt-1 block text-3xl font-bold text-[#1d1d1f] dark:text-white">
                  315 horas / año
                </strong>
                <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-0.5">
                  Tiempo transferido de cribado burocrático a negociación y visitas con compradores reales.
                </p>
              </div>

              <div class="border-t border-black/5 dark:border-white/10 pt-4">
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Capacidad adicional para visitas VIP efectivas:</span>
