  <!-- SCRIPT VANILLA JS (CALCULADORA & FORMULARIO SEGURO) -->
  <script>
    (function () {
      // 1. Calculadora de Productividad Inmobiliaria
      var inputPropiedades = document.getElementById("calc-propiedades");
      var inputPrecio = document.getElementById("calc-precio");
      var inputHorasFiltro = document.getElementById("calc-horas-filtro");

      var labelPropiedades = document.getElementById("label-propiedades");
      var labelPrecio = document.getElementById("label-precio");
      var labelHorasFiltro = document.getElementById("label-horas-filtro");

      var resHorasInmo = document.getElementById("res-horas-inmo");
      var resVisitasEfectivas = document.getElementById("res-visitas-efectivas");
      var resMultiplicadorInmo = document.getElementById("res-multiplicador-inmo");

      function recalcularCapacidad() {
        if (!inputPropiedades || !inputPrecio || !inputHorasFiltro) return;

        var propiedades = parseInt(inputPropiedades.value, 10) || 25;
        var precio = parseInt(inputPrecio.value, 10) || 1800000;
        var horasFiltro = parseInt(inputHorasFiltro.value, 10) || 10;

        if (labelPropiedades) {
          labelPropiedades.textContent = propiedades + " propiedades";
        }
        if (labelPrecio) {
          labelPrecio.textContent = precio.toLocaleString("es-ES") + " €";
        }
        if (labelHorasFiltro) {
          labelHorasFiltro.textContent = horasFiltro + " horas / semana";
        }

        // Semanas hábiles en sector inmobiliario: 45 semanas
        // El 70% de las horas dedicadas a filtrar se liberan mediante automatización
        var horasTotalesAnuales = horasFiltro * 45;
        var horasRecuperadas = Math.round(horasTotalesAnuales * 0.70);

        // Tiempo medio por visita cualificada completa (preparación + visita + seguimiento): ~2 horas
        var visitasAdicionales = Math.round(horasRecuperadas / 2);

        if (resHorasInmo) {
          resHorasInmo.textContent = horasRecuperadas.toLocaleString("es-ES") + " horas / año";
        }
        if (resVisitasEfectivas) {
          resVisitasEfectivas.textContent = "+" + visitasAdicionales.toLocaleString("es-ES") + " visitas anuales";
        }
        if (resMultiplicadorInmo) {
          resMultiplicadorInmo.textContent =
            "Amortización estimada con el cierre de una sola operación de " + precio.toLocaleString("es-ES") + " €";
        }
      }

      if (inputPropiedades) inputPropiedades.addEventListener("input", recalcularCapacidad);
      if (inputPrecio) inputPrecio.addEventListener("input", recalcularCapacidad);
      if (inputHorasFiltro) inputHorasFiltro.addEventListener("input", recalcularCapacidad);

      // 2. Envío del Formulario Confidencial
      var form = document.getElementById("form-inmo-lead");
      if (!form) return;

      var statusEl = document.getElementById("form-inmo-status");
      var btnSubmit = document.getElementById("btn-enviar-inmo");
      var leadUrl = form.getAttribute("data-lead") || "";
      var fallbackEmail = form.getAttribute("data-email") || "varinoagency@gmail.com";

      function getVal(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }

      function enviarPorMailto(datos) {
        var asunto = "Solicitud Auditoría Inmobiliaria Prime: " + datos.agencia;
        var cuerpo =
          "SOLICITUD DE FILTRO VIP Y PRE-KYC PARA AGENCIA INMOBILIARIA\n\n" +
          "Consultor / Contacto: " + datos.nombre + "\n" +
          "Agencia: " + datos.agencia + "\n" +
          "Zona: " + datos.zona + "\n" +
          "Email: " + datos.email + "\n" +
          "WhatsApp/Teléfono: " + datos.whatsapp + "\n" +
          "CRM Inmobiliario: " + datos.crm + "\n\n" +
          "PARÁMETROS DE CARTERA:\n" +
          "- Propiedades en cartera: " + datos.propiedades + "\n" +
          "- Precio medio: " + datos.precio_medio + " €\n" +
          "- Horas semanales cribando: " + datos.horas_semana + " h/sem\n" +
          "- Horas recuperables estimadas: " + datos.horas_recuperables + "\n";

        window.location.href =
          "mailto:" + fallbackEmail + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);

        if (statusEl) {
          statusEl.textContent = "Se ha preparado un correo. Solo se enviará cuando pulses Enviar en tu aplicación de correo.";
        }
      }

      form.addEventListener("submit", function (ev) {
        ev.preventDefault();

        // Honeypot anti-spam
        var honeypot = form.querySelector('input[name="website"]');
        if (honeypot && honeypot.value) return;

        var consentEl = form.querySelector('input[name="consentimiento"]');
        if (!consentEl || !consentEl.checked) {
          if (statusEl) statusEl.textContent = "Por favor, marca la casilla de consentimiento para continuar.";
          return;
        }

        var propVal = inputPropiedades ? inputPropiedades.value : "25";
        var precVal = inputPrecio ? inputPrecio.value : "1800000";
        var horasVal = inputHorasFiltro ? inputHorasFiltro.value : "10";

        var payload = {
          nombre: getVal("nombre"),
          empresa: getVal("agencia"),
          agencia: getVal("agencia"),
          zona: getVal("zona"),
          email: getVal("email"),
          whatsapp: getVal("whatsapp"),
          crm: getVal("crm"),
          propiedades: propVal,
          precio_medio: precVal,
          horas_semana: horasVal,
          horas_recuperables: resHorasInmo ? resHorasInmo.textContent : "",
          visitas_estimadas: resVisitasEfectivas ? resVisitasEfectivas.textContent : "",
          interes: "automation-sprint-inmobiliarias-7-dias",
          fuente: "landing-sectores-inmobiliarias",
          pagina: location.pathname,
          consentimiento: true,
          fecha: new Date().toISOString(),
        };

        if (statusEl) statusEl.textContent = "Procesando solicitud confidencial…";
        if (btnSubmit) btnSubmit.setAttribute("disabled", "true");

        if (leadUrl) {
          fetch(leadUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
            },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                if (statusEl) {
                  statusEl.textContent = "✓ Solicitud recibida. El equipo revisará la información.";
                }
                form.reset();
                recalcularCapacidad();
              } else {
                enviarPorMailto(payload);
              }
            })
            .catch(function () {
              enviarPorMailto(payload);
            })
            .finally(function () {
              if (btnSubmit) btnSubmit.removeAttribute("disabled");
            });
        } else {
          enviarPorMailto(payload);
          if (btnSubmit) btnSubmit.removeAttribute("disabled");
        }
      });
    })();
  </script>
</Base>
