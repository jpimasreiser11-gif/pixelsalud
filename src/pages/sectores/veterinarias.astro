  <!-- SCRIPT VANILLA JS (CALCULADORA & FORMULARIO SEGURO) -->
  <script>
    (function () {
      // 1. Calculadora de Productividad para Hospitales Veterinarios
      var inputUrgencias = document.getElementById("calc-urgencias");
      var inputTicket = document.getElementById("calc-ticket");
      var inputHorasGuardia = document.getElementById("calc-horas-guardia");

      var labelUrgencias = document.getElementById("label-urgencias");
      var labelTicket = document.getElementById("label-ticket");
      var labelHorasGuardia = document.getElementById("label-horas-guardia");

      var resHorasVet = document.getElementById("res-horas-vet");
      var resUrgenciasRetenidas = document.getElementById("res-urgencias-retenidas");
      var resMultiplicadorVet = document.getElementById("res-multiplicador-vet");

      function recalcularCapacidad() {
        if (!inputUrgencias || !inputTicket || !inputHorasGuardia) return;

        var urgenciasMes = parseInt(inputUrgencias.value, 10) || 150;
        var ticket = parseInt(inputTicket.value, 10) || 450;
        var horasGuardia = parseInt(inputHorasGuardia.value, 10) || 20;

        if (labelUrgencias) {
          labelUrgencias.textContent = urgenciasMes + " urgencias / mes";
        }
        if (labelTicket) {
          labelTicket.textContent = ticket.toLocaleString("es-ES") + " €";
        }
        if (labelHorasGuardia) {
          labelHorasGuardia.textContent = horasGuardia + " horas / semana";
        }

        // Semanas anuales en guardias 24/7: 52 semanas
        // Aproximadamente el 65% del tiempo en centralita por dudas leves se automatiza
        var horasTotalesAnuales = horasGuardia * 52;
        var horasRecuperadas = Math.round(horasTotalesAnuales * 0.65);

        // Retención estimada: retener ~3-4 urgencias graves al mes al responder en <45s
        // Equivale a ~2.5% a 3% del volumen total de urgencias atendidas que antes marchaban a la competencia
        var urgenciasRetenidasAnuales = Math.max(12, Math.round(urgenciasMes * 12 * 0.027));

        if (resHorasVet) {
          resHorasVet.textContent = horasRecuperadas.toLocaleString("es-ES") + " horas / año";
        }
        if (resUrgenciasRetenidas) {
          resUrgenciasRetenidas.textContent = "+" + urgenciasRetenidasAnuales.toLocaleString("es-ES") + " casos anuales";
        }
        if (resMultiplicadorVet) {
          var casosAmortizacion = Math.max(1, Math.ceil(1450 / ticket));
          resMultiplicadorVet.textContent =
            "Amortización estimada reteniendo " + casosAmortizacion + " caso" + (casosAmortizacion > 1 ? "s" : "") + " de urgencia en el hospital";
        }
      }

      if (inputUrgencias) inputUrgencias.addEventListener("input", recalcularCapacidad);
      if (inputTicket) inputTicket.addEventListener("input", recalcularCapacidad);
      if (inputHorasGuardia) inputHorasGuardia.addEventListener("input", recalcularCapacidad);

      // 2. Envío del Formulario Confidencial
      var form = document.getElementById("form-vet-lead");
      if (!form) return;

      var statusEl = document.getElementById("form-vet-status");
      var btnSubmit = document.getElementById("btn-enviar-vet");
      var leadUrl = form.getAttribute("data-lead") || "";
      var fallbackEmail = form.getAttribute("data-email") || "varinoagency@gmail.com";

      function getVal(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }

      function enviarPorMailto(datos) {
        var asunto = "Solicitud Auditoría Triaje Veterinario: " + datos.hospital;
        var cuerpo =
          "SOLICITUD DE TRIAJE VETERINARIO 24H Y ALERTA UCI\n\n" +
          "Facultativo / Contacto: " + datos.nombre + "\n" +
          "Hospital / Centro: " + datos.hospital + "\n" +
          "Software Veterinario: " + datos.software + "\n" +
          "Email: " + datos.email + "\n" +
          "WhatsApp/Teléfono: " + datos.whatsapp + "\n" +
          "Servicio de Urgencias: " + datos.urgencias_tipo + "\n\n" +
          "PARÁMETROS DEL SERVICIO:\n" +
          "- Urgencias mensuales: " + datos.urgencias + "\n" +
          "- Ticket medio de urgencia: " + datos.ticket_medio + " €\n" +
          "- Horas semanales en consultas leves: " + datos.horas_guardia + " h/sem\n" +
          "- Horas liberadas estimadas: " + datos.horas_recuperables + "\n" +
          "- Urgencias retenidas estimadas: " + datos.casos_retenidos + "\n";

        window.location.href =
          "mailto:" + fallbackEmail + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);

        if (statusEl) {
          statusEl.textContent = "Se ha preparado un correo. Solo se enviará cuando pulses Enviar en tu aplicación de correo.";
        }
      }

      form.addEventListener("submit", function (ev) {
        ev.preventDefault();

        // Honeypot anti-spam
        var honeypot = form.querySelector('input[name="website"]');
        if (honeypot && honeypot.value) return;

        var consentEl = form.querySelector('input[name="consentimiento"]');
        if (!consentEl || !consentEl.checked) {
          if (statusEl) statusEl.textContent = "Por favor, marca la casilla de consentimiento para continuar.";
          return;
        }

        var urgVal = inputUrgencias ? inputUrgencias.value : "150";
        var ticVal = inputTicket ? inputTicket.value : "450";
        var hVal = inputHorasGuardia ? inputHorasGuardia.value : "20";

        var payload = {
          nombre: getVal("nombre"),
          empresa: getVal("hospital"),
          hospital: getVal("hospital"),
          software: getVal("software"),
          email: getVal("email"),
          whatsapp: getVal("whatsapp"),
          urgencias_tipo: getVal("urgencias_tipo"),
          urgencias_mes: urgVal,
          ticket_medio: ticVal,
          horas_guardia_semana: hVal,
          horas_recuperables: resHorasVet ? resHorasVet.textContent : "",
          casos_retenidos: resUrgenciasRetenidas ? resUrgenciasRetenidas.textContent : "",
          interes: "automation-sprint-veterinarias-7-dias",
          fuente: "landing-sectores-veterinarias",
          pagina: location.pathname,
          consentimiento: true,
          fecha: new Date().toISOString(),
        };

        if (statusEl) statusEl.textContent = "Procesando solicitud hospitalaria…";
        if (btnSubmit) btnSubmit.setAttribute("disabled", "true");

        if (leadUrl) {
          fetch(leadUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
            },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                if (statusEl) {
                  statusEl.textContent = "✓ Solicitud recibida. El equipo revisará la información.";
                }
                form.reset();
                recalcularCapacidad();
              } else {
                enviarPorMailto(payload);
              }
            })
            .catch(function () {
              enviarPorMailto(payload);
            })
            .finally(function () {
              if (btnSubmit) btnSubmit.removeAttribute("disabled");
            });
        } else {
          enviarPorMailto(payload);
          if (btnSubmit) btnSubmit.removeAttribute("disabled");
        }
      });
    })();
  </script>
