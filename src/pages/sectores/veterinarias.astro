---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de triaje de urgencias veterinarias 24h y alerta UCI de VARINO para hospitales veterinarios."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Triaje Automatizado de Urgencias Veterinarias 24h y Alerta UCI en Barcelona",
  provider: {
    "@type": "VeterinaryCare",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Triaje automatizado de urgencias veterinarias 24h por WhatsApp, clasificación clínica en menos de 45 segundos y pre-aviso directo a quirófano y UCI para hospitales veterinarios en Barcelona.",
  serviceType: "Automatización de Urgencias Veterinarias e Integración Clínica",
});
---

<Base
  title="Hospitales Veterinarios 24h en Barcelona — Triaje UCI y Urgencias"
  description="Triaje automatizado de urgencias veterinarias 24h por WhatsApp, clasificación clínica en menos de 45s y pre-aviso directo a UCI y quirófano en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Hospitales Veterinarios 24h</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-emerald-500 live-dot"></span>
        <span>Hospitales Veterinarios 24h · Barcelona · Integración Qvet / Gesvet</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Hospitales y centros veterinarios de urgencias</p>
        <h1 class="display-title mt-4">
          Triaje de urgencias 24h en WhatsApp.<br />
          <span>Clasificación en 45s y alerta directa a UCI.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos, cirujanos y equipos de guardia</strong> de hospitales veterinarios 24 horas y centros de referencia en Barcelona (Sarrià, Les Corts, Eixample, Glòries y Diagonal). Clasifique instantáneamente las consultas nocturnas leves, retenga emergencias quirúrgicas de alto ticket y prepare el box de cuidados intensivos antes de que el paciente cruce la puerta.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular capacidad de guardia recuperable →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta técnica por WhatsApp ↗
            </a>
          )}
        </div>

        <!-- Trust Highlights -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-black/8 dark:border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Canal de triaje</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">WhatsApp Business API 24/7</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Software veterinario</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Qvet, Gesvet, WinVet</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Pre-aviso crítico</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Alerta directa a quirófano y UCI</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Área hospitalaria</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Barcelona y Área Metropolitana</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EL CUELLO DE BOTELLA EN URGENCIAS VETERINARIAS -->
  <section class="py-20 sm:py-28 bg-[#f7f7f5] dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El desafío en guardias hospitalarias</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          El equipo veterinario de UCI no puede atender centralitas nocturnas mientras opera.
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          En un hospital veterinario 24 horas, la madrugada y los fines de semana concentran las urgencias vitales más rentables y delicadas. Sin un filtro automatizado, el personal de guardia pierde tiempo valioso en llamadas informativas.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <!-- Fricción 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="h-10 w-10 rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 flex items-center justify-center font-bold text-lg">
            !
          </div>
          <h3 class="mt-5 text-lg font-semibold text-[#1d1d1f] dark:text-white">
            Centralita saturada por consultas leves
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Llamadas de propietarios a las tres de la mañana por dudas menores (un estornudo, una molestia leve) ocupan la línea del hospital mientras pacientes con compromiso respiratorio o torsión gástrica no logran comunicar.
          </p>
        </article>

        <!-- Fricción 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="h-10 w-10 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-lg">
            ⏱
          </div>
          <h3 class="mt-5 text-lg font-semibold text-[#1d1d1f] dark:text-white">
            Pérdida de urgencias quirúrgicas críticas
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Si un propietario en estado de pánico no recibe respuesta o pautas de triaje inmediatas en menos de dos minutos, arranca su vehículo hacia otro hospital veterinario 24h de Barcelona, perdiendo intervenciones de alto valor.
          </p>
        </article>

        <!-- Fricción 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="h-10 w-10 rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-lg">
            🩺
          </div>
          <h3 class="mt-5 text-lg font-semibold text-[#1d1d1f] dark:text-white">
            Llegadas imprevistas a UCI sin preparación previa
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Los pacientes en estado crítico llegan directamente a recepción sin previo aviso de constantes ni cuadro sintomático, obligando a montar oxígeno, medicación y box de estabilización contra reloj.
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- CÓMO FUNCIONA EL FLUJO DE TRIAJE VETERINARIO -->
  <section class="py-24 sm:py-32 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Arquitectura del sistema</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Triaje protocolizado en 3 etapas supervisadas
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          El flujo opera de manera ininterrumpida sobre WhatsApp Business API y se conecta con el software de gestión del hospital sin sustituir el criterio del veterinario.
        </p>
      </div>

      <div class="mt-16 grid gap-8 md:grid-cols-3">
        <!-- Paso 1 -->
        <div data-reveal class="relative rounded-3xl border border-black/8 p-8 dark:border-white/10 bg-white dark:bg-[#111318]">
          <span class="text-xs font-bold text-[#0071e3] uppercase tracking-wider">Etapa 1</span>
          <h3 class="mt-3 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Evaluación sintomática guiada en 45 segundos
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            El propietario accede vía WhatsApp. El sistema identifica especie, edad, peso aproximado y evalúa signos de alarma: dificultad respiratoria, palidez de mucosas, convulsiones, traumatismos o abdomen agudo.
          </p>
          <div class="mt-6 rounded-2xl bg-[#f7f7f5] p-4 text-xs dark:bg-[#161617] text-[#1d1d1f] dark:text-white">
            <strong>Algoritmo clínico:</strong> Clasificación Manchester adaptada a medicina veterinaria de pequeños animales.
          </div>
        </div>

        <!-- Paso 2 -->
        <div data-reveal class="relative rounded-3xl border border-black/8 p-8 dark:border-white/10 bg-white dark:bg-[#111318]">
          <span class="text-xs font-bold text-amber-600 dark:text-amber-400 uppercase tracking-wider">Etapa 2</span>
          <h3 class="mt-3 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Alerta prioritaria a terminal de guardia y UCI
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Si el triaje detecta código rojo o amarillo, se emite un aviso instantáneo a la terminal del veterinario de guardia (pantalla de quirófano / bot de Telegram seguro) con tiempo estimado de llegada y síntesis de constantes.
          </p>
          <div class="mt-6 rounded-2xl bg-[#f7f7f5] p-4 text-xs dark:bg-[#161617] text-[#1d1d1f] dark:text-white">
            <strong>Respuesta al propietario:</strong> Pautas de estabilización en ruta y botón de ubicación GPS directa al hospital.
          </div>
        </div>

        <!-- Paso 3 -->
        <div data-reveal class="relative rounded-3xl border border-black/8 p-8 dark:border-white/10 bg-white dark:bg-[#111318]">
          <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Etapa 3</span>
          <h3 class="mt-3 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Sincronización directa en Qvet / Gesvet
          </h3>
          <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Los datos del titular, la mascota y el motivo de consulta de urgencia se integran automáticamente en el historial clínico del software de gestión. Sin doble entrada de datos en recepción física.
          </p>
          <div class="mt-6 rounded-2xl bg-[#f7f7f5] p-4 text-xs dark:bg-[#161617] text-[#1d1d1f] dark:text-white">
            <strong>Continuidad asistencial:</strong> Registro completo de la conversación y consentimiento informado previo.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULADORA INTERACTIVA DE CAPACIDAD PARA HOSPITALES VETERINARIOS -->
  <section id="calculadora" class="py-24 sm:py-32 bg-[#f7f7f5] dark:bg-[#0a0d14] border-y border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Calculadora Hospitalaria</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Calcula el tiempo de guardia recuperado y las urgencias retenidas
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          Evalúa cuántas horas de guardia se liberan de consultas leves y el impacto económico de retener cirugías y pacientes críticos de madrugada.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-[2.5rem] border border-black/10 bg-white p-6 sm:p-10 dark:border-white/10 dark:bg-[#111318] shadow-xl">
        <div class="grid gap-10 lg:grid-cols-12 items-start">
          <!-- Parámetros (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
              1. Parámetros del servicio de urgencias 24h
            </h3>

            <!-- Volumen de consultas de urgencias mensuales -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-urgencias" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Consultas y llamadas de urgencia recibidas al mes
                </label>
                <span id="label-urgencias" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">150 urgencias / mes</span>
              </div>
              <input
                id="calc-urgencias"
                type="range"
                min="50"
                max="400"
                step="10"
                value="150"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <div class="flex justify-between text-[11px] text-[#86868b] mt-1">
                <span>50 (Clínica 24h local)</span>
                <span>150 (Hospital comarcal)</span>
                <span>400+ (Hospital de referencia)</span>
              </div>
            </div>

            <!-- Ticket medio de urgencia / cirugía nocturna -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-ticket" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Ticket medio de urgencia / hospitalización nocturna
                </label>
                <span id="label-ticket" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">450 €</span>
              </div>
              <input
                id="calc-ticket"
                type="range"
                min="200"
                max="1500"
                step="50"
                value="450"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <p class="text-xs text-[#86868b] mt-1">
                Desde estabilización básica (200–350 €) hasta cirugías de urgencia con hospitalización en UCI (800–1.500 €+).
              </p>
            </div>

            <!-- Horas semanales invertidas en llamadas leves -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-horas-guardia" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Horas semanales del veterinario de guardia en llamadas leves
                </label>
                <span id="label-horas-guardia" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">20 horas / semana</span>
              </div>
              <input
                id="calc-horas-guardia"
                type="range"
                min="10"
                max="40"
                step="2"
                value="20"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <p class="text-xs text-[#86868b] mt-1">
                Atención a llamadas informativas nocturnas que no requieren desplazamiento inmediato al hospital.
              </p>
            </div>
          </div>

          <!-- Resultados dinámicos (5 cols) -->
          <div class="lg:col-span-5 rounded-3xl border border-black/8 bg-[#f7f7f5] p-6 sm:p-8 dark:border-white/10 dark:bg-[#161617] space-y-6">
            <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-4">
              <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">Capacidad Hospitalaria</span>
              <span class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6]">Base 52 semanas 24/7</span>
            </div>

            <div class="space-y-4">
              <div>
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Horas clínicas liberadas para UCI y quirófano:</span>
                <strong id="res-horas-vet" class="mt-1 block text-3xl font-bold text-[#1d1d1f] dark:text-white">
                  676 horas / año
                </strong>
                <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-0.5">
                  Tiempo liberado de centralita para supervisar pacientes hospitalizados y quirófanos críticos.
                </p>
              </div>

              <div class="border-t border-black/5 dark:border-white/10 pt-4">
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Urgencias críticas retenidas al año:</span>
                <strong id="res-urgencias-retenidas" class="mt-1 block text-3xl font-bold text-[#0071e3] dark:text-[#2997ff]">
                  +48 casos anuales
                </strong>
                <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-0.5">
                  Pacientes graves que eligen su hospital gracias a la respuesta guiada en menos de 45 segundos.
                </p>
              </div>

              <div class="border-t border-black/5 dark:border-white/10 pt-4">
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Retorno frente a un Sprint (1.450 €):</span>
                <strong id="res-multiplicador-vet" class="mt-1 block text-sm font-semibold text-emerald-600 dark:text-emerald-400">
                  Amortización estimada reteniendo 3 a 4 urgencias en el hospital
                </strong>
              </div>
            </div>
          </div>
        </div>

        <!-- Formulario confidencial para hospitales veterinarios -->
        <div class="mt-12 border-t border-black/10 dark:border-white/10 pt-10">
          <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
            2. Solicita el estudio de triaje veterinario para tu hospital
          </h3>
          <p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">
            Analizamos los protocolos de urgencias y la compatibilidad con vuestro software clínico bajo estricto acuerdo de confidencialidad.
          </p>

          <form
            id="form-vet-lead"
            data-lead={BACKEND_LEAD}
            data-email={SITE.email}
            class="mt-6 space-y-4"
          >
            <!-- Honeypot anti-spam -->
            <input type="hidden" name="website" value="" aria-hidden="true" tabindex="-1" autocomplete="off" />

            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              <div>
                <label for="vet-nombre" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">
                  Nombre y cargo
                </label>
                <input
                  id="vet-nombre"
                  name="nombre"
                  type="text"
                  required
                  placeholder="Dra. Laura Morales (Dir. Médica)"
                  class="w-full rounded-xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
                />
              </div>

              <div>
                <label for="vet-hospital" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">
                  Nombre del hospital o clínica
                </label>
                <input
                  id="vet-hospital"
                  name="hospital"
                  type="text"
                  required
                  placeholder="Hospital Veterinari Sarrià 24h"
                  class="w-full rounded-xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
                />
              </div>

              <div>
                <label for="vet-software" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">
                  Software de gestión actual
                </label>
                <select
                  id="vet-software"
                  name="software"
                  class="w-full rounded-xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
                >
                  <option value="qvet">Qvet</option>
                  <option value="gesvet">Gesvet</option>
                  <option value="winvet">WinVet</option>
                  <option value="otro">Otro software / Sistema propio</option>
                </select>
              </div>

              <div>
                <label for="vet-email" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">
                  Email profesional corporativo
                </label>
                <input
                  id="vet-email"
                  name="email"
                  type="email"
                  required
                  placeholder="urgencias@hospitalveterinari.cat"
                  class="w-full rounded-xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
                />
              </div>

              <div>
                <label for="vet-whatsapp" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">
                  Teléfono / WhatsApp de contacto
                </label>
                <input
                  id="vet-whatsapp"
                  name="whatsapp"
                  type="tel"
                  required
                  placeholder="+34 600 000 000"
                  class="w-full rounded-xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
                />
              </div>

              <div>
