---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de triaje de idoneidad refractiva y captación 24/7 de VARINO para clínicas oftalmológicas."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Triaje Automatizado de Idoneidad Refractiva y Cirugía Ocular en Barcelona",
  provider: {
    "@type": "MedicalClinic",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Test de idoneidad refractiva automatizado por WhatsApp y web en menos de 60 segundos, precalificación clínica de candidatos a LASIK/ICL y cita diagnóstica para clínicas oftalmológicas en Barcelona.",
  serviceType: "Automatización de Cirugía Refractiva e Integración Clínica",
});
---

<Base
  title="Clínicas Oftalmológicas en Barcelona — Triaje Cirugía Refractiva y Captación 24/7"
  description="Triaje automatizado de idoneidad para cirugía refractiva y cataratas por WhatsApp en menos de 60s, preevaluación y agenda diagnóstica en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Oftalmología y Cirugía Refractiva</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/10 px-3.5 py-1 text-xs font-semibold text-sky-700 dark:text-sky-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-sky-500 live-dot"></span>
        <span>Clínicas Oftalmológicas · Barcelona · Integración Clinic Cloud / DriCloud / Gesden</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Centros de oftalmología y cirugía refractiva</p>
        <h1 class="display-title mt-4">
          Test de idoneidad refractiva en WhatsApp.<br />
          <span>Calificación en 45s y agenda diagnóstica 24/7.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos, coordinadores quirúrgicos y gerentes</strong> de clínicas oftalmológicas en Barcelona (Sarrià-Sant Gervasi, Eixample, Pedralbes y Les Corts). Responda al instante a pacientes que preguntan por LASIK, FemtoLASIK, lentes ICL o cataratas, filtre su graduación orientativa y confirme citas diagnósticas presenciales antes de que comparen con la competencia.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular ingresos recuperables en cirugía →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta técnica por WhatsApp ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM DIAGNOSIS -->
  <section class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El cuello de botella asistencial</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Por qué se fugan pacientes de cirugía refractiva en Barcelona
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          En cirugía láser ocular y lentes intraoculares (tickets de 1.500 € a 4.500 € por paciente), la decisión de compra está altamente condicionada por la inmediatez y la claridad de la información inicial.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-rose-600 dark:text-rose-400">15 min</div>
          <h3 class="text-base font-semibold mt-3">Ventana de decisión crítica</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            El 65% de los interesados en corregir su miopía escriben fuera de horario laboral. Si la clínica tarda más de 15 minutos en responder, piden cita diagnóstica en otro centro privado de Barcelona.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-amber-600 dark:text-amber-400">70%</div>
          <h3 class="text-base font-semibold mt-3">Sobrecarga en recepción</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            El equipo de atención dedica hasta 3 horas al día a responder las mismas preguntas sobre dioptrías mínimas, edad idónea, lentillas blandas y precio por ojo, en lugar de cerrar citas diagnósticas.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-sky-600 dark:text-sky-400">22%</div>
          <h3 class="text-base font-semibold mt-3">Incomparecencias a pruebas</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            Pacientes que acuden a la topografía corneal sin haber descansado de sus lentillas el tiempo exigido (5-7 días), obligando a suspender la consulta y dejando huecos vacíos en la agenda del optometrista.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 PILLARS SOLUTION -->
  <section class="py-20 border-b border-black/5 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">La solución tecnológica</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Triaje refractivo inteligente y agenda confirmada en 7 días
        </h2>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div data-reveal class="flex flex-col justify-between rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm">
          <div>
            <span class="inline-block rounded-xl bg-sky-500/10 p-3 text-sky-600 dark:text-sky-400 font-bold text-sm mb-4">
              01 · Triaje <45s
            </span>
            <h3 class="text-lg font-semibold">Test de idoneidad en WhatsApp</h3>
            <p class="mt-3 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
              Asistente guiado que evalúa edad (18-50+), graduación orientativa (miopía, astigmatismo, hipermetropía o presbicia) y estabilidad óptica, orientando al paciente hacia LASIK o lente intraocular ICL.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/5 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
            ✓ 0 esperas · Atención inmediata 24/7
          </div>
        </div>

        <div data-reveal class="flex flex-col justify-between rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm">
          <div>
            <span class="inline-block rounded-xl bg-emerald-500/10 p-3 text-emerald-600 dark:text-emerald-400 font-bold text-sm mb-4">
              02 · Protocolo
            </span>
            <h3 class="text-lg font-semibold">Pautas de preparación corneal</h3>
            <p class="mt-3 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
              Envío automático y pautado por WhatsApp de las instrucciones previas: días de retirada de lentillas blandas/tóricas, no uso de maquillaje y confirmación activa con geolocalización de la clínica.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/5 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
            ✓ Incomparecencias reducidas a <5%
          </div>
        </div>

        <div data-reveal class="flex flex-col justify-between rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm">
          <div>
            <span class="inline-block rounded-xl bg-purple-500/10 p-3 text-purple-600 dark:text-purple-400 font-bold text-sm mb-4">
              03 · RGPD Médico
            </span>
            <h3 class="text-lg font-semibold">Cifrado de datos sanitarios</h3>
            <p class="mt-3 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
              Tratamiento de datos conforme al Art. 9 RGPD. Cero almacenamiento intermedio de datos médicos en servidores de terceros. Sincronización directa con vuestro software oftalmológico (Clinic Cloud, DriCloud).
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-black/5 dark:border-white/5 text-xs text-emerald-600 dark:text-emerald-400 font-medium">
            ✓ Cumplimiento AEPD garantizado por contrato
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ROI CALCULATOR -->
  <section id="calculadora" class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-4xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Calculadora de Impacto Económico</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Estime el retorno mensual de automatizar su captación refractiva
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-sm">
          Ajuste los parámetros según la operativa actual de su clínica oftalmológica en Barcelona.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-3xl border border-black/10 dark:border-white/15 p-8 bg-white dark:bg-[#1c1c1e] shadow-lg">
        <div class="grid gap-8 sm:grid-cols-2">
          <div>
            <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-white uppercase tracking-wider">
              Consultas web/WhatsApp sobre cirugía al mes: <span id="val-consultas" class="text-sky-600 font-bold text-sm">80</span>
            </label>
            <input
              id="range-consultas"
              type="range"
              min="20"
              max="300"
              step="10"
              value="80"
              class="w-full mt-3 accent-sky-600 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-[#86868b] mt-1">
              <span>20 consultas</span>
              <span>150 consultas</span>
              <span>300 consultas</span>
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-[#1d1d1f] dark:text-white uppercase tracking-wider">
              Ticket medio de intervención (LASIK/ICL): <span id="val-ticket" class="text-sky-600 font-bold text-sm">1.800 €</span>
            </label>
            <input
              id="range-ticket"
              type="range"
              min="1000"
              max="4000"
              step="100"
              value="1800"
              class="w-full mt-3 accent-sky-600 cursor-pointer"
            />
            <div class="flex justify-between text-[10px] text-[#86868b] mt-1">
              <span>1.000 € (Láser)</span>
              <span>2.500 €</span>
              <span>4.000 € (ICL/Premium)</span>
            </div>
          </div>
        </div>

        <div class="mt-8 pt-8 border-t border-black/5 dark:border-white/10 grid gap-6 sm:grid-cols-3 text-center">
          <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.02]">
            <span class="text-xs text-[#86868b] block">Cirugías adicionales / mes</span>
            <span id="res-cirugias" class="text-2xl font-bold text-[#1d1d1f] dark:text-white mt-1 block">+4</span>
          </div>

          <div class="p-4 rounded-2xl bg-black/[0.02] dark:bg-white/[0.02]">
            <span class="text-xs text-[#86868b] block">Horas de recepción liberadas</span>
            <span id="res-horas" class="text-2xl font-bold text-[#1d1d1f] dark:text-white mt-1 block">48 h</span>
          </div>

          <div class="p-4 rounded-2xl bg-sky-500/10 border border-sky-500/20">
            <span class="text-xs text-sky-700 dark:text-sky-400 block font-semibold">Facturación adicional estimada</span>
            <span id="res-ingresos" class="text-2xl font-bold text-sky-600 dark:text-sky-400 mt-1 block">7.200 € / mes</span>
          </div>
        </div>

        <div class="mt-6 text-center text-xs text-[#86868b]">
          * Estimación basada en una mejora del 5% en la tasa de conversión de consulta a intervención programada mediante triaje instantáneo en <60s.
        </div>
      </div>
    </div>
  </section>

  <!-- SPRINT SECTION -->
  <section id="sprint" class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Alcance cerrado y garantía</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Automation Sprint: Oftalmología en 7 Días
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          Sin proyectos interminables ni costes ocultos. Implementamos el flujo completo en una semana y lo dejamos operando en vuestra clínica.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        <div data-reveal class="rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-white dark:bg-[#1c1c1e]">
          <h3 class="text-xl font-semibold">Qué incluye el Sprint</h3>
          <ul class="mt-6 space-y-3 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">
            <li class="flex items-start gap-2">
              <span class="text-sky-600 font-bold">✓</span>
              <span>Asistente de triaje refractivo en WhatsApp Cloud API y widget web oficial.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-600 font-bold">✓</span>
              <span>Árbol de decisión médica protocolizado (LASIK vs ICL vs Presbicia).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-600 font-bold">✓</span>
              <span>Automatización de pautas de descanso de lentillas y recordatorios de cita.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-600 font-bold">✓</span>
              <span>Integración con agenda clínica (Clinic Cloud, DriCloud o Google Calendar).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-600 font-bold">✓</span>
              <span>Contrato DPA de tratamiento de datos sanitarios 100% conforme al RGPD.</span>
            </li>
          </ul>
        </div>

        <div data-reveal class="rounded-3xl border border-sky-500/20 bg-sky-500/[0.03] p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-semibold text-sky-600 dark:text-sky-400 uppercase tracking-wider">Tarifa Cerrada</span>
            <div class="mt-4 flex items-baseline gap-2">
              <span class="text-4xl font-bold text-[#1d1d1f] dark:text-white">1.450 €</span>
              <span class="text-xs text-[#86868b]">+ IVA (pago 50% inicio / 50% entrega)</span>
            </div>
            <p class="mt-4 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
              Mantenimiento y soporte técnico posterior opcional: 350 €/mes (incluye monitorización 24/7, cambios de protocolo y servidores n8n).
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-sky-500/10">
            <a href="#contacto" class="button-primary w-full text-center">
              Solicitar Sprint para mi clínica →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAD CONTACT FORM -->
  <section id="contacto" class="py-20 border-b border-black/5 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]">
    <div class="mx-auto max-w-xl px-6 text-center">
      <div data-reveal>
        <p class="eyebrow">Contacto Directo</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Hablemos sobre su clínica oftalmológica
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-sm">
          El equipo revisará la solicitud y confirmará si puede preparar una propuesta técnica para su software clínico.
        </p>
      </div>

      <form
        action={BACKEND_LEAD}
        method="POST"
        data-reveal
        class="mt-10 text-left space-y-4 rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm"
      >
        <input type="hidden" name="sector" value="Oftalmología y Cirugía Refractiva" />
        <input type="hidden" name="origen" value="/sectores/oftalmologia" />

        <div>
          <label for="nombre" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre y Apellidos</label>
          <input type="text" id="nombre" name="nombre" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Dr. / Dña..." />
        </div>

        <div>
          <label for="clinica" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre de la Clínica Oftalmológica</label>
          <input type="text" id="clinica" name="empresa" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Clínica Ocular Barcelona" />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Correo Corporativo</label>
          <input type="email" id="email" name="email" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="direccion@suclinica.es" />
        </div>

        <div>
          <label for="software" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Software de Gestión / Agenda Actual</label>
          <input type="text" id="software" name="software" class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Clinic Cloud, DriCloud, Gesden..." />
        </div>

        <div class="pt-2">
          <button type="submit" class="button-primary w-full text-center">
            Enviar solicitud confidencial →
          </button>
        </div>

        <p class="text-[11px] text-[#86868b] text-center mt-3">
          Tratamiento confidencial de datos bajo el RGPD. Cero spam.
        </p>
      </form>
    </div>
  </section>

  <!-- FOOTER CTA -->
  <Cta
    titulo="¿Su clínica realiza más de 30 cirugías refractivas al mes?"
    texto="Diseñamos un flujo a medida que conecta directamente con sus quirófanos y su equipo de optometría."
  />

  <!-- CALCULATOR SCRIPT -->
  <script>
    (function () {
      const rConsultas = document.getElementById("range-consultas");
      const rTicket = document.getElementById("range-ticket");
      const valConsultas = document.getElementById("val-consultas");
      const valTicket = document.getElementById("val-ticket");
      const resCirugias = document.getElementById("res-cirugias");
      const resHoras = document.getElementById("res-horas");
      const resIngresos = document.getElementById("res-ingresos");

      function recalc() {
        const c = parseInt(rConsultas.value, 10);
        const t = parseInt(rTicket.value, 10);

        valConsultas.textContent = c;
        valTicket.textContent = t.toLocaleString("es-ES") + " €";

        // 5% additional surgical conversions
        const cirugias = Math.max(1, Math.round(c * 0.05));
        const horas = Math.round(c * 0.6);
        const ingresos = cirugias * t;

        resCirugias.textContent = "+" + cirugias;
        resHoras.textContent = horas + " h";
        resIngresos.textContent = ingresos.toLocaleString("es-ES") + " € / mes";
      }

      if (rConsultas && rTicket) {
        rConsultas.addEventListener("input", recalc);
        rTicket.addEventListener("input", recalc);
        recalc();
      }
    })();
  </script>
</Base>
