---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de triaje inmediato y captura 24/7 para clínicas de medicina estética y dermatología de VARINO."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Triaje Inmediato y Automatización para Clínicas de Estética y Dermatología en Barcelona",
  provider: {
    "@type": "MedicalBusiness",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Automatización de triaje en 60 segundos y captura 24/7 de pacientes de alto ticket para clínicas de cirugía estética, dermatología y medicina estética en Barcelona. Cumplimiento estricto del Art. 9 del RGPD.",
  serviceType: "Automatización de Admisión y Triaje Sanitario Privado",
});
---

<Base
  title="Cirugía Estética y Dermatología en Barcelona"
  description="Triaje inmediato en 60 segundos y captura 24/7 de pacientes de alto ticket para clínicas de cirugía estética, dermatología y medicina estética en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Estética y Dermatología</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-rose-500/20 bg-rose-500/10 px-3.5 py-1 text-xs font-semibold text-rose-700 dark:text-rose-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-rose-500 live-dot"></span>
        <span>Cirugía Plástica & Medicina Estética de Alto Ticket · Barcelona · RGPD Art. 9</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Cirugía estética, dermatología y medicina estética</p>
        <h1 class="display-title mt-4">
          Triaje inmediato en 60 segundos.<br />
          <span>Captura de pacientes de alto ticket.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos y gerentes</strong> de clínicas de cirugía estética, dermatología clínica y medicina estética avanzada en Barcelona. Elimine la fuga de pacientes que solicitan cita por Instagram o web fuera de horario: cualificación clínica en el primer minuto bajo estricto cumplimiento del Artículo 9 del RGPD.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular facturación recuperable →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta confidencial por WhatsApp ↗
            </a>
          )}
        </div>

        <!-- Trust Highlights -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-black/8 dark:border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Respuesta al paciente</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">&lt; 60 segundos (24/7)</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Privacidad médica</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Art. 9 RGPD On-Premise</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Control de agenda</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Recepción valida cada cita</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Zona de cobertura</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Barcelona y área metropolitana</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EL CUELLO DE BOTELLA DEL ALTO TICKET EN BARCELONA -->
  <section class="py-20 sm:py-28 bg-[#f7f7f5] dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">La fuga oculta de pacientes</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Invierten miles de euros en captación para dejar al paciente esperando 12 horas.
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          En las clínicas de medicina estética y cirugía plástica de Barcelona, más del 40% de las solicitudes de valoración médica entran por las noches o en fin de semana.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <!-- Friccion 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 font-bold text-sm">
            01
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            La fuga nocturna y de fin de semana
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente consulta Instagram o la web a las 23:00 o un domingo por la tarde. Si la clínica tarda 12 horas en responder cuando abre recepción, el paciente ya ha agendado en otro centro que le atendió al instante.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Pérdida directa de presupuestos de 1.500€ a 6.000€ en tratamientos quirúrgicos y médico-estéticos.
          </div>
        </article>

        <!-- Friccion 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-sm">
            02
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Recepción colapsada por consultas no cualificadas
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El personal de recepción pasa horas respondiendo preguntas genéricas sobre precios básicos, sin tiempo para hacer un seguimiento cuidado a pacientes que desean procedimientos de alto ticket (rinoplastia, blefaroplastia, lifting).
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Falta de atención personalizada a las oportunidades más rentables para la clínica.
          </div>
        </article>

        <!-- Friccion 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-sm">
            03
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Riesgo legal con imágenes y datos de salud (Art. 9 RGPD)
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Pacientes enviando fotos faciales o corporales por WhatsApp o Instagram direct sin consentimiento explícito ni canal cifrado homologado. Un riesgo sancionador crítico para la reputación de la clínica.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Exposición a multas de la AEPD por tratamiento no custodiado de datos de salud.
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- LA SOLUCIÓN: AUTOMATION SPRINT PARA ESTÉTICA Y DERMATOLOGÍA -->
  <section id="solucion" class="py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-3xl">
        <p class="eyebrow">La arquitectura para clínicas de estética</p>
        <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Triaje Clínico 24/7 y Captura de Pacientes Alto Ticket
        </h2>
        <p class="mt-5 text-lg text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          Conectamos la entrada de vuestra clínica (Instagram, web, WhatsApp oficial) con un sistema de triaje médico que responde en menos de un minuto, recopila antecedentes bajo protocolo seguro y prepara la cita para recepción.
        </p>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <!-- Pillar 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 01</span>
            <span class="rounded-full bg-rose-500/10 px-3 py-0.5 text-xs font-medium text-rose-700 dark:text-rose-400">Respuesta &lt; 60 s</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Triaje inteligente inmediato (Instagram, Web y WhatsApp)
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Atención instantánea las 24 horas del día, los 7 días de la semana. Cuando un paciente escribe solicitando información sobre un tratamiento, recibe una respuesta profesional en menos de 60 segundos.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Identificación del motivo de consulta: cirugía corporal/facial, inyectables, dermatología clínica o láser médico.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Pre-cualificación de expectativas, presupuesto aproximado y disponibilidad de fechas para primera visita.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Elimina la pérdida de oportunidades mientras la recepción física está cerrada.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 02</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Custodia Segura</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Pre-evaluación médica y envío de imágenes cifrado
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente recibe un enlace seguro de un solo uso para completar un cuestionario de antecedentes estéticos y, opcionalmente, adjuntar fotografías de la zona a valorar.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Cifrado de extremo a extremo conforme al Art. 9 del RGPD para datos biométricos y de salud.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Generación de ficha previa para el cirujano o dermatólogo antes de que el paciente entre al gabinete.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Cero almacenamiento de imágenes sensibles en chats personales de empleados o dispositivos móviles.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 03</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Agenda Optimizada</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Agendamiento prioritario y confirmación activa
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Filtro inteligente que asigna el hueco adecuado según el tiempo de consulta requerido (ej. 45 min para valoración de cirugía vs. 20 min para toxina botulínica).
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Recordatorios personalizados y confirmación interactiva 48h y 24h antes por WhatsApp oficial.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Protocolo de cancelación temprana con activación de lista de espera para no dejar gabinetes vacíos.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Supervisión humana: la recepción siempre tiene la última palabra para confirmar o mover la cita.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 4 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 04</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Soberanía y Privacidad</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Alojamiento privado en Europa y DPA sanitario
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Toda la infraestructura de automatización se ejecuta en servidores locales (on-premise) en la propia clínica o en centros de datos con certificación europea de máxima seguridad.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Acuerdo de Encargo de Tratamiento (<a href={`${BASE}/dpa/`} class="underline text-[#0071e3] dark:text-[#2997ff]">DPA</a>) específico para clínicas médico-estéticas.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Ninguna fotografía ni expediente se utiliza para entrenar algoritmos públicos o externos.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Cumplimiento estricto de la Ley de Autonomía del Paciente y la LOPDGDD.</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- CALCULADORA INTERACTIVA DE FACTURACIÓN RECUPERABLE -->
  <section id="calculadora" class="py-24 sm:py-32 bg-[#f7f7f5] dark:bg-[#0a0d14] border-y border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Calculadora de Retorno Sanitario</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Calcula la facturación que tu clínica deja escapar fuera de horario
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          Simula el impacto de atender en menos de 60 segundos a los pacientes que entran por Instagram Ads y web en horarios nocturnos y fines de semana.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-[2.5rem] border border-black/10 bg-white p-6 sm:p-10 dark:border-white/10 dark:bg-[#111318] shadow-xl">
        <div class="grid gap-10 lg:grid-cols-12 items-start">
          <!-- Parámetros (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
              1. Datos comerciales de la clínica
            </h3>

            <!-- Inversión mensual en publicidad -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-inversion" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Inversión mensual en publicidad (Instagram / Google Ads)
                </label>
                <span id="label-inversion" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">3.000 € / mes</span>
              </div>
              <input
                id="calc-inversion"
                type="range"
                min="1000"
                max="10000"
                step="500"
                value="3000"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <div class="flex justify-between text-[11px] text-[#86868b] mt-1">
                <span>1.000 €</span>
                <span>5.000 €</span>
                <span>10.000 €+</span>
              </div>
            </div>

            <!-- Ticket medio de tratamiento -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <label for="calc-ticket" class="text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6]">
                  Ticket medio de tratamiento realizado
                </label>
                <span id="label-ticket" class="text-sm font-bold text-[#0071e3] dark:text-[#2997ff]">1.800 €</span>
              </div>
              <input
                id="calc-ticket"
                type="range"
                min="500"
                max="5000"
                step="100"
                value="1800"
                class="w-full accent-[#0071e3] cursor-pointer"
              />
              <p class="text-xs text-[#86868b] mt-1">
                Promedio ponderado entre medicina estética (400–1.200 €) y cirugía plástica (2.500–8.000 €).
              </p>
            </div>

            <!-- Porcentaje fuera de horario -->
            <div>
              <label for="calc-porcentaje-horario" class="block text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6] mb-2">
                Porcentaje estimado de solicitudes fuera de horario comercial (tardes, noches y fines de semana)
              </label>
              <select
                id="calc-porcentaje-horario"
                class="w-full rounded-2xl border border-black/12 bg-[#f7f7f5] px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
              >
                <option value="0.30">30% de solicitudes fuera de horario</option>
                <option value="0.40" selected>40% de solicitudes fuera de horario (Media del sector)</option>
                <option value="0.50">50% de solicitudes fuera de horario (Campañas activas en redes)</option>
                <option value="0.60">60% de solicitudes fuera de horario (Enfoque digital intensivo)</option>
              </select>
            </div>
          </div>

          <!-- Resultados dinámicos (5 cols) -->
          <div class="lg:col-span-5 rounded-3xl border border-black/8 bg-[#f7f7f5] p-6 sm:p-8 dark:border-white/10 dark:bg-[#161617] space-y-6">
            <div class="flex items-center justify-between border-b border-black/5 dark:border-white/10 pb-4">
              <span class="text-xs font-bold text-rose-600 dark:text-rose-400 uppercase tracking-wider">Impacto Mensual Estimado</span>
              <span class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6]">Modelo de conversión</span>
            </div>

            <div class="space-y-4">
              <div>
                <span class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Pacientes adicionales atendidos en &lt; 60 s:</span>
                <strong id="res-leads-rescatados" class="mt-1 block text-3xl font-bold text-[#1d1d1f] dark:text-white">
                  36 solicitudes / mes
                </strong>
                <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-0.5">
