  <!-- SCRIPT VANILLA JS (CALCULADORA DE RETORNO Y FORMULARIO DE LEAD) -->
  <script>
    (function () {
      // 1. Lógica interactiva de la calculadora
      var inputInversion = document.getElementById("calc-inversion");
      var inputTicket = document.getElementById("calc-ticket");
      var selectPorcentaje = document.getElementById("calc-porcentaje-horario");

      var labelInversion = document.getElementById("label-inversion");
      var labelTicket = document.getElementById("label-ticket");

      var resLeadsRescatados = document.getElementById("res-leads-rescatados");
      var resFacturacionRecuperada = document.getElementById("res-facturacion-recuperada");
      var resMultiplicador = document.getElementById("res-multiplicador-estetica");

      function recalcularRetorno() {
        if (!inputInversion || !inputTicket || !selectPorcentaje) return;

        var inversion = parseInt(inputInversion.value, 10) || 3000;
        var ticket = parseInt(inputTicket.value, 10) || 1800;
        var pctFueraHorario = parseFloat(selectPorcentaje.value) || 0.40;

        if (labelInversion) {
          labelInversion.textContent = inversion.toLocaleString("es-ES") + " € / mes";
        }
        if (labelTicket) {
          labelTicket.textContent = ticket.toLocaleString("es-ES") + " €";
        }

        // Estimación del sector médico-estético en Barcelona:
        // Coste medio por lead en Ads estético de calidad: ~35 € por contacto
        var leadsTotalesMes = Math.round(inversion / 35);
        var leadsFueraHorario = Math.round(leadsTotalesMes * pctFueraHorario);

        // Conversión estimada de lead cualificado con respuesta en < 60s a tratamiento contratado: ~15%
        var tratamientosAdicionales = Math.max(1, Math.round(leadsFueraHorario * 0.15));
        var facturacionRecuperada = tratamientosAdicionales * ticket;

        if (resLeadsRescatados) {
          resLeadsRescatados.textContent = leadsFueraHorario + " solicitudes / mes";
        }
        if (resFacturacionRecuperada) {
          resFacturacionRecuperada.textContent = facturacionRecuperada.toLocaleString("es-ES") + " € / mes";
        }
        if (resMultiplicador) {
          var sprintCost = 1450;
          var ratio = (facturacionRecuperada / sprintCost).toFixed(1);
          resMultiplicador.textContent =
            "Retorno potencial equivalente a " + ratio + " veces el coste del sprint de 1.450 €";
        }
      }

      if (inputInversion) inputInversion.addEventListener("input", recalcularRetorno);
      if (inputTicket) inputTicket.addEventListener("input", recalcularRetorno);
      if (selectPorcentaje) selectPorcentaje.addEventListener("change", recalcularRetorno);

      // 2. Envío del Formulario Confidencial de Lead
      var form = document.getElementById("form-estetica-lead");
      if (!form) return;

      var statusEl = document.getElementById("form-estetica-status");
      var btnSubmit = document.getElementById("btn-enviar-estetica");
      var leadUrl = form.getAttribute("data-lead") || "";
      var fallbackEmail = form.getAttribute("data-email") || "varinoagency@gmail.com";

      function getVal(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }

      function enviarPorMailto(datos) {
        var asunto = "Solicitud Auditoría Clínica Estética: " + datos.clinica;
        var cuerpo =
          "SOLICITUD DE AUDITORÍA Y TRIAJE 24/7 PARA CLÍNICA ESTÉTICA\n\n" +
          "Nombre y cargo: " + datos.nombre + "\n" +
          "Clínica: " + datos.clinica + "\n" +
          "Especialidad: " + datos.especialidad + "\n" +
          "Email: " + datos.email + "\n" +
          "WhatsApp/Teléfono: " + datos.whatsapp + "\n" +
          "Software de gestión: " + datos.software + "\n\n" +
          "PARÁMETROS ESTIMADOS:\n" +
          "- Inversión mensual Ads: " + datos.inversion_ads + " €/mes\n" +
          "- Ticket medio: " + datos.ticket_medio + " €\n" +
          "- Solicitudes fuera de horario calculadas: " + datos.leads_fuera_horario + "\n" +
          "- Facturación mensual recuperable estimada: " + datos.facturacion_estimada + "\n";

        window.location.href =
          "mailto:" + fallbackEmail + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);

        if (statusEl) {
          statusEl.textContent = "Se ha preparado un correo. Solo se enviará cuando pulses Enviar en tu aplicación de correo.";
        }
      }

      form.addEventListener("submit", function (ev) {
        ev.preventDefault();

        // Honeypot anti-spam
        var honeypot = form.querySelector('input[name="website"]');
        if (honeypot && honeypot.value) return;

        var consentEl = form.querySelector('input[name="consentimiento"]');
        if (!consentEl || !consentEl.checked) {
          if (statusEl) statusEl.textContent = "Por favor, marque la casilla de consentimiento para continuar.";
          return;
        }

        var invVal = inputInversion ? inputInversion.value : "3000";
        var tickVal = inputTicket ? inputTicket.value : "1800";

        var payload = {
          nombre: getVal("nombre"),
          empresa: getVal("clinica"),
          clinica: getVal("clinica"),
          especialidad: getVal("especialidad"),
          email: getVal("email"),
          whatsapp: getVal("whatsapp"),
          software: getVal("software"),
          inversion_ads: invVal,
          ticket_medio: tickVal,
          leads_fuera_horario: resLeadsRescatados ? resLeadsRescatados.textContent : "",
          facturacion_estimada: resFacturacionRecuperada ? resFacturacionRecuperada.textContent : "",
          interes: "automation-sprint-estetica-7-dias",
          fuente: "landing-sectores-estetica",
          pagina: location.pathname,
          consentimiento: true,
          fecha: new Date().toISOString(),
        };

        if (statusEl) statusEl.textContent = "Procesando solicitud confidencial…";
        if (btnSubmit) btnSubmit.setAttribute("disabled", "true");

        if (leadUrl) {
          fetch(leadUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
            },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                if (statusEl) {
                  statusEl.textContent = "✓ Solicitud recibida. El equipo revisará la información.";
                }
                form.reset();
                recalcularRetorno();
              } else {
                enviarPorMailto(payload);
              }
            })
            .catch(function () {
              enviarPorMailto(payload);
            })
            .finally(function () {
              if (btnSubmit) btnSubmit.removeAttribute("disabled");
            });
        } else {
          enviarPorMailto(payload);
          if (btnSubmit) btnSubmit.removeAttribute("disabled");
        }
      });
    })();
  </script>
</Base>
