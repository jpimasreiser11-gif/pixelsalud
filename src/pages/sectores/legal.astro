      var resHorasAnuales = document.getElementById("res-horas-anuales");
      var resValorEconomico = document.getElementById("res-valor-economico");
      var resMultiplicador = document.getElementById("res-multiplicador");

      function recalcularAhorro() {
        if (!inputProfesionales || !inputHoras || !selectTarifa) return;

        var numProf = parseInt(inputProfesionales.value, 10) || 8;
        var horasSemana = parseInt(inputHoras.value, 10) || 5;
        var tarifaHora = parseInt(selectTarifa.value, 10) || 80;

        if (labelProfesionales) {
          labelProfesionales.textContent = numProf + " profesionales";
        }
        if (labelHoras) {
          labelHoras.textContent = horasSemana + " horas / semana";
        }

        // Semanas hábiles de trabajo al año en despacho medio: 45 semanas
        // Eficiencia estimada de automatización en tareas mecánicas: 60%
        var totalHorasRepetitivas = numProf * horasSemana * 45;
        var horasLiberadas = Math.round(totalHorasRepetitivas * 0.6);
        var valorLiberado = Math.round(horasLiberadas * tarifaHora);

        if (resHorasAnuales) {
          resHorasAnuales.textContent = horasLiberadas.toLocaleString("es-ES") + " horas / año";
        }
        if (resValorEconomico) {
          resValorEconomico.textContent = valorLiberado.toLocaleString("es-ES") + " € / año";
        }
        if (resMultiplicador) {
          var sprintCost = 1450;
          var ratio = (valorLiberado / sprintCost).toFixed(1);
          resMultiplicador.textContent =
            "Capacidad equivalente a " + ratio + " veces la inversión del sprint de 1.450 €";
        }
      }

      if (inputProfesionales) inputProfesionales.addEventListener("input", recalcularAhorro);
      if (inputHoras) inputHoras.addEventListener("input", recalcularAhorro);
      if (selectTarifa) selectTarifa.addEventListener("change", recalcularAhorro);

      // 2. Envío del Formulario Confidencial
      var form = document.getElementById("form-legal-lead");
      if (!form) return;

      var statusEl = document.getElementById("form-legal-status");
      var btnSubmit = document.getElementById("btn-enviar-legal");
      var leadUrl = form.getAttribute("data-lead") || "";
      var fallbackEmail = form.getAttribute("data-email") || "varinoagency@gmail.com";

      function getVal(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }

      function enviarPorMailto(datos) {
        var asunto = "Solicitud Confidencial Despacho: " + datos.despacho;
        var cuerpo =
          "SOLICITUD DE AUDITORÍA / PROPUESTA TÉCNICA PARA BUFETE\n\n" +
          "Letrado / Contacto: " + datos.nombre + "\n" +
          "Despacho: " + datos.despacho + "\n" +
          "Email: " + datos.email + "\n" +
          "Teléfono: " + datos.telefono + "\n" +
          "Software de gestión: " + datos.software + "\n" +
          "Prioridad declarada: " + datos.prioridad + "\n\n" +
          "PARÁMETROS DEL CÁLCULO:\n" +
          "- Profesionales: " + datos.profesionales + "\n" +
          "- Horas repetitivas/sem: " + datos.horas_semana + "\n" +
          "- Tarifa estimada: " + datos.tarifa + " €/h\n" +
          "- Horas liberadas estimadas: " + datos.horas_liberadas + " h/año\n";

        window.location.href =
          "mailto:" + fallbackEmail + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);

        if (statusEl) {
          statusEl.textContent = "Se ha preparado un correo. Solo se enviará cuando pulses Enviar en tu aplicación de correo.";
        }
      }

      form.addEventListener("submit", function (ev) {
        ev.preventDefault();

        // Honeypot anti-spam check
        var honeypot = form.querySelector('input[name="website"]');
        if (honeypot && honeypot.value) return;

        var consentEl = form.querySelector('input[name="consentimiento"]');
        if (!consentEl || !consentEl.checked) {
          if (statusEl) statusEl.textContent = "Por favor, marca la casilla de consentimiento para continuar.";
          return;
        }

        var numProf = inputProfesionales ? inputProfesionales.value : "8";
        var horasSem = inputHoras ? inputHoras.value : "5";
        var tarifaVal = selectTarifa ? selectTarifa.value : "80";

        var payload = {
          nombre: getVal("nombre"),
          empresa: getVal("despacho"),
          despacho: getVal("despacho"),
          software: getVal("software"),
          email: getVal("email"),
          whatsapp: getVal("telefono"),
          prioridad: getVal("prioridad"),
          profesionales: numProf,
          horas_semana: horasSem,
          tarifa: tarifaVal,
          horas_liberadas: resHorasAnuales ? resHorasAnuales.textContent : "",
          valor_estimado: resValorEconomico ? resValorEconomico.textContent : "",
          interes: "automation-sprint-legal-7-dias",
          fuente: "landing-sectores-legal",
          pagina: location.pathname,
          consentimiento: true,
          fecha: new Date().toISOString(),
        };

        if (statusEl) statusEl.textContent = "Enviando solicitud confidencial…";
        if (btnSubmit) btnSubmit.setAttribute("disabled", "true");

        if (leadUrl) {
          fetch(leadUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
            },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                if (statusEl) {
                  statusEl.textContent = "✓ Solicitud recibida. El equipo revisará la información.";
                }
                form.reset();
                recalcularAhorro();
              } else {
                enviarPorMailto(payload);
              }
            })
            .catch(function () {
              enviarPorMailto(payload);
            })
            .finally(function () {
              if (btnSubmit) btnSubmit.removeAttribute("disabled");
            });
        } else {
          enviarPorMailto(payload);
          if (btnSubmit) btnSubmit.removeAttribute("disabled");
        }
      });
    })();
  </script>
</Base>
