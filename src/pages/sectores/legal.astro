import SectorProposal from "../../components/SectorProposal.astro";
---

<SectorProposal
  title="Propuesta administrativa para despachos profesionales"
  description="Ejemplo ilustrativo para organizar solicitudes administrativas en despachos jurídicos y fiscales, con supervisión profesional."
  sector="Despachos jurídicos y fiscales"
  intro="Un posible flujo interno para clasificar consultas administrativas, asignar responsables y preparar borradores de respuesta. La información jurídica sustantiva siempre queda bajo criterio del profesional."
