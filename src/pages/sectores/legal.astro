---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de automatización e IA privada para despachos legales y tributarios de VARINO."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Automatización e IA Privada para Despachos Legales y Asesorías Tributarias en Barcelona",
  provider: {
    "@type": "ProfessionalService",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Sistemas de automatización e IA privada on-premise para bufetes de abogados y despachos tributarios en Barcelona: ingesta de notificaciones oficiales (LexNET, DEHú, AEAT), extracción de escrituras y modelos tributarios, y triaje multicanal.",
  serviceType: "Automatización LegalTech e IA Privada",
});
---

<Base
  title="Sector Legal y Tributario en Barcelona"
  description="Automatización e IA privada on-premise para despachos legales y asesores tributarios en Barcelona: ingesta de LexNET/DEHú/AEAT, cotejo documental y triaje multicanal."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Legal y Tributario</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-[#0071e3]/20 bg-[#0071e3]/10 px-3.5 py-1 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] mb-6">
        <span class="h-2 w-2 rounded-full bg-[#0071e3] live-dot"></span>
        <span>Despachos y Asesorías Tributarias · Barcelona · IA Privada On-Premise</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Bufetes jurídicos y despachos fiscales</p>
        <h1 class="display-title mt-4">
          Sistemas de alta precisión jurídica.<br />
          <span>Cero exposición de datos confidenciales.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>socios directores, letrados sénior y directores de operaciones</strong> de bufetes de abogados y firmas tributarias de Barcelona. Automatizamos la ingesta de notificaciones judiciales y administrativas, el cotejo documental y el triaje de consultas con infraestructura privada y control humano estricto.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular capacidad recuperable →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta confidencial por WhatsApp ↗
            </a>
          )}
        </div>

        <!-- Trust Highlights -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-black/8 dark:border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Despliegue</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">On-premise / Local</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Secreto profesional</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Art. 542 LOPJ & RGPD</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Supervisión</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Firma letrada preceptiva</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Ámbito</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Barcelona y área metropolitana</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EL CONTEXTO OPERATIVO DEL SECTOR LEGAL -->
  <section class="py-20 sm:py-28 bg-[#f7f7f5] dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Realidad operativa</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          El valor del despacho reside en el criterio jurídico, no en descargar notificaciones.
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          En los despachos de abogados y asesorías tributarias de Barcelona, los profesionales de mayor cualificación dedican decenas de horas mensuales a tareas manuales de alta fricción y riesgo administrativo.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <!-- Friccion 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-sm">
            01
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Dispersión de sedes electrónicas
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Revisión manual cada mañana en LexNET, DEHú, AEAT, Seguridad Social y portales autonómicos. Riesgo de plazos procesales perentorios traspapelados en buzones personales.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Impacto:</span> Tiempo de letrados y procuradores consumido en descargas y renombrado de PDFs.
          </div>
        </article>

        <!-- Friccion 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-sm">
            02
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Cotejo documental exhaustivo a mano
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Comprobación casilla a casilla entre libros contables, escrituras notariales y modelos tributarios (303, 390, 111, 200). Horas de trabajo repetitivo propensas a fatiga humana.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Impacto:</span> Cuellos de botella en campañas trimestrales y cierres de operaciones societarias.
          </div>
        </article>

        <!-- Friccion 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold text-sm">
            03
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Miedo legítimo a filtraciones en IA pública
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Pegar información procesal, balances de clientes o borradores de contratos en chatbots públicos viola el secreto profesional y el RGPD. El despacho necesita IA local que no salga de su perímetro.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Impacto:</span> Parálisis tecnológica por falta de soluciones con custodia on-premise verificada.
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CASOS DE USO CLAVE -->
  <section id="casos" class="py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-3xl">
        <p class="eyebrow">Arquitectura aplicada</p>
        <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Tres soluciones críticas para el despacho legal y tributario
        </h2>
        <p class="mt-5 text-lg text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          Flujos diseñados en n8n e IA privada que respetan los protocolos del bufete, con paradas de aprobación preceptivas y registro de auditoría documental.
        </p>
      </div>

      <!-- 3 Use Cases Detail -->
      <div class="mt-16 space-y-8">
        <!-- Caso A -->
        <article data-reveal class="overflow-hidden rounded-[2rem] border border-black/8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="grid gap-0 lg:grid-cols-[1.15fr_.85fr]">
            <div class="p-8 sm:p-12">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">
                Caso de uso A · Gestión procesal y administrativa
              </span>
              <h3 class="mt-4 text-2xl sm:text-3xl font-semibold text-[#1d1d1f] dark:text-white">
                Clasificación e ingesta automática de notificaciones de sedes electrónicas
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
                Conectamos de forma periódica y segura los buzones de <strong>LexNET, DEHú, Agencia Tributaria (AEAT) y Seguridad Social (SEDESS)</strong> para centralizar la recepción de actos de comunicación oficial.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2 text-xs">
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Extracción y Metadatos</strong>
                  Identificación automática del órgano emisor, juzgado o tribunal, número de autos/expediente, partes implicadas y letrado asignado en el bufete.
                </div>
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Cálculo de Plazos Procesales</strong>
                  Estimación de fecha de vencimiento según calendario judicial de días hábiles en Cataluña/España, generando borrador de apunte en agenda.
                </div>
              </div>

              <div class="mt-6 flex items-center gap-2 text-xs text-[#0071e3] dark:text-[#2997ff] font-medium">
                <span>Parada humana preceptiva:</span>
                <span class="text-[#6e6e73] dark:text-[#a1a1a6]">El letrado valida el plazo antes de incorporar el apunte al calendario definitivo.</span>
              </div>
            </div>

            <div class="bg-[#0b0d12] p-8 sm:p-12 text-white flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-white/10">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-[#a1a1a6]">
                  <span>FUENTES OFICIALES</span>
                  <span>INGESTA SEGURA</span>
                </div>
                <ul class="mt-6 space-y-3 font-mono text-xs text-[#d2d2d7]">
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">●</span> LexNET (Ministerio de Justicia)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">●</span> DEHú (Dirección Electrónica Habilitada única)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">●</span> Sede Electrónica AEAT (Notificaciones tributarias)
                  </li>
                  <li class="flex items-center gap-2">
                    <span class="text-emerald-400">●</span> SEDESS (Seguridad Social) y sedes autonómicas
                  </li>
                </ul>
              </div>
              <div class="mt-8 border-t border-white/10 pt-6">
                <span class="text-[11px] text-[#a1a1a6] block">Resultado directo</span>
                <strong class="text-sm text-white mt-1 block">Bandeja unificada con PDFs clasificados por letrado y alerta de vencimiento</strong>
              </div>
            </div>
          </div>
        </article>

        <!-- Caso B -->
        <article data-reveal class="overflow-hidden rounded-[2rem] border border-black/8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="grid gap-0 lg:grid-cols-[1.15fr_.85fr]">
            <div class="p-8 sm:p-12">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">
                Caso de uso B · Asesoría tributaria y mercantil
              </span>
              <h3 class="mt-4 text-2xl sm:text-3xl font-semibold text-[#1d1d1f] dark:text-white">
                Extracción estructurada y cotejo de escrituras, contratos y modelos tributarios
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
                Flujos de análisis con visión estructurada y modelos privados para cotejar declaraciones oficiales frente a libros contables y escrituras notariales.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2 text-xs">
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Modelos Tributarios Recurrentes</strong>
                  Lectura y verificación de casillas en <strong>Modelo 303 (IVA), 390 (resumen anual), 111 (retenciones) y 200 (Sociedades)</strong>.
                </div>
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Escrituras y Contratos</strong>
                  Extracción de poderes, facultades de administradores, titulares reales, cláusulas de responsabilidad y discrepancias en balances mercantiles.
                </div>
              </div>

              <div class="mt-6 flex items-center gap-2 text-xs text-[#0071e3] dark:text-[#2997ff] font-medium">
                <span>Trazabilidad documental:</span>
                <span class="text-[#6e6e73] dark:text-[#a1a1a6]">Cada discrepancia detectada enlaza a la página y línea exacta del documento fuente.</span>
              </div>
            </div>

            <div class="bg-[#0b0d12] p-8 sm:p-12 text-white flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-white/10">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-[#a1a1a6]">
                  <span>MODELOS COTEJADOS</span>
                  <span>CERO ALUCINACIÓN</span>
                </div>
                <div class="mt-6 grid grid-cols-2 gap-2 text-xs font-mono">
                  <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                    <span class="text-[#2997ff] block font-bold">Mod. 303 / 390</span>
                    <span class="text-[11px] text-[#a1a1a6] mt-1 block">Bases imponibles y cuotas devengadas vs libros</span>
                  </div>
                  <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                    <span class="text-[#2997ff] block font-bold">Mod. 111 / 190</span>
                    <span class="text-[11px] text-[#a1a1a6] mt-1 block">Retenciones IRPF nóminas y profesionales</span>
                  </div>
                  <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                    <span class="text-[#2997ff] block font-bold">Mod. 200</span>
                    <span class="text-[11px] text-[#a1a1a6] mt-1 block">Ajustes extracontables y bases imponibles</span>
                  </div>
                  <div class="rounded-lg bg-white/5 p-3 border border-white/10">
                    <span class="text-[#2997ff] block font-bold">Escrituras</span>
                    <span class="text-[11px] text-[#a1a1a6] mt-1 block">Poderes, socios, titularidad y objeto social</span>
                  </div>
                </div>
              </div>
              <div class="mt-8 border-t border-white/10 pt-6">
                <span class="text-[11px] text-[#a1a1a6] block">Resultado directo</span>
                <strong class="text-sm text-white mt-1 block">Informe de cotejo previo a la presentación tributaria o firma notarial</strong>
              </div>
            </div>
          </div>
        </article>

        <!-- Caso C -->
        <article data-reveal class="overflow-hidden rounded-[2rem] border border-black/8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="grid gap-0 lg:grid-cols-[1.15fr_.85fr]">
            <div class="p-8 sm:p-12">
              <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">
                Caso de uso C · Intake comercial y admisión
              </span>
              <h3 class="mt-4 text-2xl sm:text-3xl font-semibold text-[#1d1d1f] dark:text-white">
                Triaje multicanal de consultas de nuevos clientes y asignación por especialidad
              </h3>
              <p class="mt-4 text-sm leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
                Entrada ordenada de oportunidades que llegan por formulario web, correo corporativo o WhatsApp profesional del bufete.
              </p>

              <div class="mt-6 grid gap-3 sm:grid-cols-2 text-xs">
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Clasificación por Área</strong>
                  Detección de la disciplina aplicable: Mercantil/M&A, Fiscal/Tributario, Laboral, Litigación civil/penal o Inmobiliario.
                </div>
                <div class="rounded-xl border border-black/5 bg-white p-4 dark:border-white/5 dark:bg-[#161617]">
                  <strong class="block text-[#1d1d1f] dark:text-white mb-1">Control de Conflictos Previo</strong>
                  Cruce automatizado contra la base interna de clientes y contrapartes activas antes de aceptar la consulta o emitir propuesta.
                </div>
              </div>

              <div class="mt-6 flex items-center gap-2 text-xs text-[#0071e3] dark:text-[#2997ff] font-medium">
                <span>Aprobación del socio:</span>
                <span class="text-[#6e6e73] dark:text-[#a1a1a6]">El sistema prepara el borrador; el socio responsable decide la admisión y presupuesto.</span>
              </div>
            </div>

            <div class="bg-[#0b0d12] p-8 sm:p-12 text-white flex flex-col justify-between border-t lg:border-t-0 lg:border-l border-white/10">
              <div>
                <div class="flex items-center justify-between text-[11px] font-mono uppercase tracking-widest text-[#a1a1a6]">
                  <span>DISCIPLINAS</span>
                  <span>ASIGNACIÓN AUTOMATIZADA</span>
                </div>
                <div class="mt-6 space-y-2 text-xs font-mono text-[#d2d2d7]">
                  <div class="flex justify-between border-b border-white/10 pb-2">
                    <span>Mercantil & Societario</span>
                    <span class="text-white">Socio Área Mercantil</span>
                  </div>
                  <div class="flex justify-between border-b border-white/10 pb-2">
                    <span>Fiscal & Tributario</span>
                    <span class="text-white">Equipo Tributario</span>
                  </div>
                  <div class="flex justify-between border-b border-white/10 pb-2">
                    <span>Litigación & Arbitraje</span>
                    <span class="text-white">Letrado Procesalista</span>
                  </div>
                  <div class="flex justify-between border-b border-white/10 pb-2">
                    <span>Laboral & Compliance</span>
                    <span class="text-white">Asociado Especialista</span>
                  </div>
                </div>
              </div>
              <div class="mt-8 border-t border-white/10 pt-6">
                <span class="text-[11px] text-[#a1a1a6] block">Resultado directo</span>
                <strong class="text-sm text-white mt-1 block">Respuesta inicial estructurada en menos de 2 horas con conflicto verificado</strong>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- CALCULADORA INTERACTIVA DE AHORRO PARA DESPACHOS -->
  <section id="calculadora" class="py-24 sm:py-32 bg-[#f7f7f5] dark:bg-[#0a0d14] border-y border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-5xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Calculadora de Productividad Legal</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Calcula la capacidad y valor recuperable en tu despacho
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          Evalúa cuántas horas de letrados y tramitadores se liberan al automatizar la ingesta de notificaciones, el cotejo tributario y el triaje.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-[2.5rem] border border-black/10 bg-white p-6 sm:p-10 dark:border-white/10 dark:bg-[#111318] shadow-xl">
        <div class="grid gap-10 lg:grid-cols-12 items-start">
          <!-- Controles de la calculadora (7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
              1. Parámetros del despacho
            </h3>

            <!-- Número de profesionales -->
            <div>
              <div class="flex justify-between items-center mb-2">
