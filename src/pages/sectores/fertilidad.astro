---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de triaje confidencial de fertilidad y captación 24/7 de VARINO para clínicas de reproducción asistida."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Triaje Automatizado y Precalificación de Fertilidad y Reproducción Asistida en Barcelona",
  provider: {
    "@type": "MedicalClinic",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Triaje confidencial multicanal por WhatsApp y web en menos de 60 segundos, precalificación clínica de perfil reproductivo y agendamiento directo de estudio de fertilidad para clínicas en Barcelona.",
  serviceType: "Automatización de Reproducción Asistida e Integración Clínica",
});
---

<Base
  title="Clínicas de Fertilidad en Barcelona — Triaje Confidencial 24/7 y Captación FIV"
  description="Triaje confidencial para clínicas de reproducción asistida y fertilidad por WhatsApp en menos de 60s, precalificación de perfil reproductivo y agenda diagnóstica en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Fertilidad y Reproducción Asistida</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-rose-500/20 bg-rose-500/10 px-3.5 py-1 text-xs font-semibold text-rose-700 dark:text-rose-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-rose-500 live-dot"></span>
        <span>Clínicas de Fertilidad · Barcelona · Soberanía RGPD Art. 9 & Ley 14/2006</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Centros de medicina reproductiva y fertilidad</p>
        <h1 class="display-title mt-4">
          Triaje confidencial de fertilidad en WhatsApp.<br />
          <span>Atención empática en 45s y agenda médica 24/7.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos, coordinadores asistenciales y gerentes</strong> de centros de fertilidad en Barcelona (Sarrià-Sant Gervasi, Pedralbes, Les Corts y Eixample). Acompañe al instante a pacientes que consultan por FIV, Ovodonación, método ROPA o preservación ovocitaria, oriente con empatía clínica y agende el estudio inicial de fertilidad antes de que comparen con otros centros.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular ciclos recuperados →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta técnica por WhatsApp ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM DIAGNOSIS -->
  <section class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El cuello de botella en admisiones de fertilidad</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Por qué se pierden pacientes de reproducción asistida en Barcelona
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          En tratamientos de reproducción asistida (tickets de 4.000 € a 12.000 € por ciclo), el factor decisivo no es solo el prestigio del laboratorio, sino la calidez y la inmediatez de la primera interacción cuando la paciente decide dar el paso.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-rose-600 dark:text-rose-400">70%</div>
          <h3 class="text-base font-semibold mt-3 text-[#1d1d1f] dark:text-white">Consultas fuera de horario</h3>
          <p class="text-sm text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            Las parejas y mujeres solas investigan de noche o en fines de semana. Si reciben una respuesta genérica 24 horas después por email, la emoción se enfría o ya han escrito a otra clínica.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-amber-600 dark:text-amber-400">25 h/sem</div>
          <h3 class="text-base font-semibold mt-3 text-[#1d1d1f] dark:text-white">Sobrecarga de enfermería y admisiones</h3>
          <p class="text-sm text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            El personal asistencial invierte horas al teléfono explicando qué analíticas traer (antimülleriana, serologías, seminograma) en lugar de centrarse en las pacientes en sala de espera.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-sky-600 dark:text-sky-400">30%</div>
          <h3 class="text-base font-semibold mt-3 text-[#1d1d1f] dark:text-white">Cancelaciones de primera visita</h3>
          <p class="text-sm text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            La falta de un recordatorio empático y una guía de preparación previa genera no-shows o visitas improductivas donde faltan pruebas diagnósticas básicas.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- SOLUTION ARCHITECTURE -->
  <section id="sprint" class="py-20 border-b border-black/5 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Arquitectura de la solución · Automation Sprint (7 días)</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Triaje multicanal confidencial, cualificación clínica y cita médica
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          Flujo automatizado desplegado sobre n8n con WhatsApp Cloud API y formularios web cifrados, integrado de forma nativa con su software médico (Clinic Cloud, DriCloud, Gesden o ERP asistencial).
        </p>
      </div>

      <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-[#0071e3] dark:text-[#2997ff] uppercase tracking-wider">Paso 1</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Triaje Confidencial en 45s</h3>
          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            Asistente conversacional por WhatsApp/Web que orienta según objetivo: FIV, Ovodonación, método ROPA o vitrificación, con lenguaje cálido y empático.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-[#0071e3] dark:text-[#2997ff] uppercase tracking-wider">Paso 2</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Precalificación Reproductiva</h3>
          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            Recoge datos orientativos clave: edad, tiempo de búsqueda, intentos previos o informes de seminograma, clasificando la prioridad médica de la consulta.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-[#0071e3] dark:text-[#2997ff] uppercase tracking-wider">Paso 3</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Agenda Diagnóstica Sincronizada</h3>
          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            Conexión directa con la agenda de los facultativos especialistas. Reserva inmediata de consulta presencial o videoconsulta internacional en 1 clic.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-[#0071e3] dark:text-[#2997ff] uppercase tracking-wider">Paso 4</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Guía Previa y Confirmación</h3>
          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-2 leading-relaxed">
            Envío automatizado de pautas para la visita: analíticas a aportar, ayunas o abstinencia para el seminograma y confirmación activa 24h antes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- RGPD MEDICAL COMPLIANCE -->
  <section class="py-16 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="rounded-3xl border border-rose-500/20 bg-rose-500/[0.03] p-8 sm:p-12">
        <div class="max-w-3xl">
          <span class="inline-block rounded-full bg-rose-500/10 px-3 py-1 text-xs font-semibold text-rose-700 dark:text-rose-400">
            Seguridad y Cumplimiento Normativo Sanitario
          </span>
          <h2 class="text-2xl sm:text-3xl font-semibold mt-4 text-[#1d1d1f] dark:text-white">
            100% Conforme al Art. 9 del RGPD y Ley 14/2006 de Reproducción Asistida
          </h2>
          <p class="text-sm text-[#6e6e73] dark:text-[#a1a1a6] mt-3 leading-relaxed">
            Los datos de salud y categorización especial reciben la máxima protección exigida por la Agencia Española de Protección de Datos (AEPD):
          </p>
          <ul class="mt-6 space-y-3 text-sm text-[#1d1d1f] dark:text-[#f5f5f7]">
            <li class="flex items-start gap-3">
              <span class="text-rose-600 font-bold">✓</span>
              <span><strong>Cero persistencia de historiales médicos:</strong> Los datos se transmiten directamente al software clínico de la clínica vía HTTPS/TLS 1.3 sin almacenamiento residual en servidores externos.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-rose-600 font-bold">✓</span>
              <span><strong>Modelos procesados en Europa o localmente:</strong> El triaje semántico se ejecuta en infraestructura soberana europea o servidores locales on-premise (Ollama).</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-rose-600 font-bold">✓</span>
              <span><strong>Consentimiento explícito informado:</strong> Formulario de consentimiento previo desmarcado específico para tratamiento de datos sanitarios reproductivos.</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULADORA DE ROI -->
  <section id="calculadora" class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-4xl px-6">
      <div data-reveal class="text-center max-w-xl mx-auto">
        <p class="eyebrow">Calculadora de Retorno Asistencial</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Estime los ciclos recuperados con triaje 24/7
        </h2>
        <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">
          Ajuste el volumen mensual de solicitudes informativas y el ticket medio de ciclo en su centro.
        </p>
      </div>

      <div data-reveal class="mt-12 rounded-3xl border border-black/10 dark:border-white/15 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm">
        <div class="grid gap-8 sm:grid-cols-2">
          <!-- Sliders -->
          <div class="space-y-6">
            <div>
              <div class="flex justify-between text-xs font-semibold text-[#1d1d1f] dark:text-white mb-2">
                <span>Consultas informativas web/WhatsApp al mes:</span>
                <span id="val-consultas" class="text-rose-600 dark:text-rose-400 font-bold">45</span>
              </div>
              <input
                type="range"
                id="range-consultas"
                min="10"
                max="200"
                step="5"
                value="45"
                class="w-full h-2 bg-black/10 dark:bg-white/15 rounded-lg appearance-none cursor-pointer accent-rose-600"
              />
            </div>

            <div>
              <div class="flex justify-between text-xs font-semibold text-[#1d1d1f] dark:text-white mb-2">
                <span>Ticket medio por tratamiento / ciclo:</span>
                <span id="val-ticket" class="text-rose-600 dark:text-rose-400 font-bold">5.500 €</span>
              </div>
              <input
                type="range"
                id="range-ticket"
                min="3000"
                max="12000"
                step="500"
                value="5500"
                class="w-full h-2 bg-black/10 dark:bg-white/15 rounded-lg appearance-none cursor-pointer accent-rose-600"
              />
            </div>

            <div class="pt-2 text-xs text-[#86868b] leading-relaxed">
              * Estimación conservadora basada en un 6% de conversión adicional de leads recuperados fuera de horario comercial y 40 minutos ahorrados por paciente.
            </div>
          </div>

          <!-- Resultados -->
          <div class="rounded-2xl bg-black/[0.03] dark:bg-white/[0.04] p-6 flex flex-col justify-between border border-black/5 dark:border-white/10">
            <div>
              <div class="text-xs uppercase font-bold tracking-wider text-[#86868b]">Impacto Mensual Estimado</div>
              <div class="mt-4 flex items-baseline gap-2">
                <span id="res-ingresos" class="text-3xl font-extrabold text-[#1d1d1f] dark:text-white">+16.500 € / mes</span>
              </div>
              <div class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">
                En facturación recuperada por tratamientos de fertilidad
              </div>
            </div>

            <div class="mt-6 pt-6 border-t border-black/5 dark:border-white/10 grid grid-cols-2 gap-4">
              <div>
                <div class="text-xs text-[#86868b]">Nuevos ciclos</div>
                <div id="res-ciclos" class="text-xl font-bold text-rose-600 dark:text-rose-400 mt-1">+3</div>
              </div>
              <div>
                <div class="text-xs text-[#86868b]">Horas liberadas</div>
                <div id="res-horas" class="text-xl font-bold text-[#1d1d1f] dark:text-white mt-1">30 h</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULARIO DE CONTACTO -->
  <section class="py-20 border-b border-black/5 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]">
    <div class="mx-auto max-w-xl px-6">
      <div data-reveal class="text-center">
        <p class="eyebrow">Solicitud de diagnóstico técnico</p>
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight mt-3">
          Auditoría de admisiones y triaje para su clínica
        </h2>
        <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">
          Sin coste ni compromiso. Analizamos los canales actuales de su centro y presentamos un esquema de integración en 48 horas.
        </p>
      </div>

      <form
        action={BACKEND_LEAD}
        method="POST"
        class="mt-10 space-y-4 rounded-3xl border border-black/10 dark:border-white/15 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm"
      >
        <input type="hidden" name="origen" value="landing_fertilidad_barcelona" />

        <div>
          <label for="nombre" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre y Apellidos</label>
          <input type="text" id="nombre" name="nombre" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Dr. / Dña..." />
        </div>

        <div>
          <label for="clinica" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre del Centro / Clínica de Fertilidad</label>
          <input type="text" id="clinica" name="empresa" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Instituto de Fertilidad Barcelona" />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Correo Corporativo</label>
          <input type="email" id="email" name="email" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="direccion@suclinica.es" />
        </div>

        <div>
          <label for="software" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Software de Gestión / Agenda Actual</label>
          <input type="text" id="software" name="software" class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Clinic Cloud, DriCloud, Gesden, SAP..." />
        </div>

        <div class="pt-2">
          <button type="submit" class="button-primary w-full text-center">
            Enviar solicitud confidencial →
          </button>
        </div>

        <p class="text-[11px] text-[#86868b] text-center mt-3">
          Tratamiento confidencial de datos bajo el RGPD. Cero spam.
        </p>
      </form>
    </div>
  </section>

  <!-- FOOTER CTA -->
  <Cta
    titulo="¿Su centro atiende más de 40 solicitudes de fertilidad al mes?"
    texto="Diseñamos un flujo a medida que conecta directamente con sus facultativos y el laboratorio de embriología."
  />

  <!-- CALCULATOR SCRIPT -->
  <script>
    (function () {
      const rConsultas = document.getElementById("range-consultas");
      const rTicket = document.getElementById("range-ticket");
      const valConsultas = document.getElementById("val-consultas");
      const valTicket = document.getElementById("val-ticket");
      const resCiclos = document.getElementById("res-ciclos");
      const resHoras = document.getElementById("res-horas");
      const resIngresos = document.getElementById("res-ingresos");

      function recalc() {
        const c = parseInt(rConsultas.value, 10);
        const t = parseInt(rTicket.value, 10);

        valConsultas.textContent = c;
        valTicket.textContent = t.toLocaleString("es-ES") + " €";

        // 6% additional treatment cycle conversions
        const ciclos = Math.max(1, Math.round(c * 0.06));
        const horas = Math.round(c * 0.65);
        const ingresos = ciclos * t;

        resCiclos.textContent = "+" + ciclos;
        resHoras.textContent = horas + " h";
        resIngresos.textContent = "+" + ingresos.toLocaleString("es-ES") + " € / mes";
      }

      if (rConsultas && rTicket) {
        rConsultas.addEventListener("input", recalc);
        rTicket.addEventListener("input", recalc);
        recalc();
      }
    })();
  </script>
</Base>
