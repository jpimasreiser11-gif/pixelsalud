---
import SectorProposal from "../../components/SectorProposal.astro";
---

<SectorProposal
  title="Propuesta administrativa para reproducción asistida"
  description="Ejemplo ilustrativo de coordinación de consultas administrativas para centros de reproducción asistida, sin procesar información clínica."
  sector="Reproducción asistida"
  intro="Una propuesta centrada en facilitar el primer contacto y la coordinación administrativa con sensibilidad y revisión humana. La demo no pregunta por tratamientos, diagnósticos ni circunstancias reproductivas."
  steps={[
    "La persona indica cómo prefiere ser contactada y solicita una conversación.",
    "El flujo presenta únicamente información general aprobada por la clínica.",
    "Recepción revisa la solicitud y coordina el siguiente contacto con el equipo.",
    "La clínica decide qué información adicional es necesaria y cómo tratarla de forma segura.",
  ]}
  boundaries={[
    "No realiza triaje, no aconseja sobre fertilidad y no recomienda tratamientos.",
    "No recoge datos sobre salud, historial reproductivo, pareja ni tratamientos en esta demo.",
    "No promete conversiones, pacientes, ciclos recuperados ni facturación.",
    "Cualquier proyecto con datos sensibles requiere evaluación específica y controles acordados con la clínica.",
  ]}
/>
