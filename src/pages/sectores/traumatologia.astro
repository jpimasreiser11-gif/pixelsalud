---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer la solución de triaje traumatológico y captación de cirugías articulares 24/7 de VARINO para centros ortopédicos."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Triaje Automatizado y Precalificación de Traumatología y Cirugía Ortopédica en Barcelona",
  provider: {
    "@type": "MedicalClinic",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Barcelona",
      addressRegion: "Catalunya",
      addressCountry: "ES",
    },
  },
  description:
    "Triaje traumatológico multicanal por WhatsApp y web en menos de 60 segundos, recepción estructurada de informes de resonancia magnética y agendamiento asistido con cirujanos ortopédicos especialistas en Barcelona.",
  serviceType: "Automatización de Traumatología, Cirugía Ortopédica e Integración Clínica",
});
---

<Base
  title="Clínicas de Traumatología en Barcelona — Triaje 24/7 y Captación de Cirugía Ortopédica"
  description="Triaje traumatológico para centros ortopédicos por WhatsApp en menos de 60s, ingesta de RMN, precalificación articular y agenda de alta resolución en Barcelona."
>
  {SITE.launchReady && <script type="application/ld+json" set:html={schema} />}

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumbs & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Traumatología y Cirugía Ortopédica</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-sky-500/20 bg-sky-500/10 px-3.5 py-1 text-xs font-semibold text-sky-700 dark:text-sky-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-sky-500 live-dot"></span>
        <span>Institutos de Traumatología · Barcelona · Soberanía RGPD Art. 9</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Centros de traumatología, ortopedia y medicina del deporte</p>
        <h1 class="display-title mt-4">
          Triaje traumatológico articular en WhatsApp.<br />
          <span>Atención en 45s y recepción estructurada de RMN.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos, jefes de servicio y cirujanos ortopédicos</strong> de Barcelona (Sarrià, Tres Torres, Pedralbes y Eixample). Clasifique al instante lesiones agudas (LCA, menisco, hombro, cadera, columna), recopile informes radiológicos previos y agende la consulta de alta resolución antes de que el paciente busque cita en otro centro.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#calculadora" class="button-primary">
            Calcular cirugías recuperadas →
          </a>
          <a href="#sprint" class="button-secondary">
            Automation Sprint (7 días)
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta técnica por WhatsApp ↗
            </a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM DIAGNOSIS -->
  <section class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El cuello de botella en admisiones traumatológicas</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Por qué se fugan pacientes quirúrgicos en Barcelona
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          En cirugía ortopédica (artroscopias y prótesis con presupuestos de 3.500 € a 12.000 €), el paciente lesionado exige rapidez diagnóstica. La falta de respuesta inmediata en canales digitales o las asignaciones a especialistas erróneos provocan la pérdida del caso.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-3">
        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-sky-600 dark:text-sky-400">70%</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Consultas fuera de horario</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            Las lesiones deportivas ocurren por la tarde y fines de semana. Si el paciente no recibe orientación en minutos tras salir de urgencias con su informe, agenda en otra clínica.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-sky-600 dark:text-sky-400">&gt;24h</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Demora en revisar RMN</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            Los informes radiológicos quedan acumulados en el correo de recepción sin triar, perdiendo la oportunidad de proponer cita quirúrgica inmediata.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="text-3xl font-bold text-sky-600 dark:text-sky-400">40%</div>
          <h3 class="text-base font-semibold mt-2 text-[#1d1d1f] dark:text-white">Derivaciones erróneas</h3>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            Pacientes con problemas de hombro agendados con especialistas de rodilla, obligando a reasignar citas y deteriorando la experiencia asistencial.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WORKFLOW STEPS -->
  <section class="py-20 border-b border-black/5 dark:border-white/10 bg-black/[0.01] dark:bg-white/[0.01]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El flujo de triaje automatizado</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          De la lesión a la agenda quirúrgica en 60 segundos
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          Un circuito automatizado en n8n que acompaña al paciente con rigor traumatológico y total respeto por la privacidad médica.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-4">
        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-5 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-sky-600 dark:text-sky-400 mb-2">PASO 01</div>
          <h4 class="font-semibold text-sm text-[#1d1d1f] dark:text-white">Triaje Anatómico Rápido</h4>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Identificación de la articulación afectada (rodilla, hombro, columna, cadera, pie, mano) y antigüedad del traumatismo en menos de 45 segundos.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-5 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-sky-600 dark:text-sky-400 mb-2">PASO 02</div>
          <h4 class="font-semibold text-sm text-[#1d1d1f] dark:text-white">Ingesta Estructurada de RMN</h4>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            El paciente adjunta de forma segura fotos o PDF del informe de resonancia o TAC previo, volcándose directamente en el software clínico (TLS 1.3).
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-5 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-sky-600 dark:text-sky-400 mb-2">PASO 03</div>
          <h4 class="font-semibold text-sm text-[#1d1d1f] dark:text-white">Asignación de Subunidad</h4>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Enrutamiento preciso hacia la agenda del cirujano ortopédico supraespecializado, evitando intermediarios y citas desalineadas.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 dark:border-white/10 p-5 bg-white dark:bg-[#1c1c1e]">
          <div class="text-xs font-bold text-sky-600 dark:text-sky-400 mb-2">PASO 04</div>
          <h4 class="font-semibold text-sm text-[#1d1d1f] dark:text-white">Cita de Alta Resolución</h4>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Confirmación automatizada de la visita diagnóstica presencial con indicaciones de preparación e historial médico listo para el especialista.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CALCULATOR SECTION -->
  <section id="calculadora" class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Calculadora de rentabilidad asistencial</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Estime las intervenciones recuperadas al mes
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          Compruebe el impacto de capturar y orientar en menos de 60 segundos a pacientes con lesiones agudas que consultan en su centro.
        </p>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-2 items-center">
        <!-- Sliders -->
        <div data-reveal class="space-y-6 rounded-3xl border border-black/8 dark:border-white/10 p-8 bg-black/[0.02] dark:bg-white/[0.02]">
          <div>
            <div class="flex justify-between items-center text-sm font-semibold mb-2">
              <label for="range-consultas">Consultas o solicitudes de traumatología / mes:</label>
              <span id="val-consultas" class="text-sky-600 dark:text-sky-400 font-bold">120</span>
            </div>
            <input
              type="range"
              id="range-consultas"
              min="30"
              max="400"
              step="10"
              value="120"
              class="w-full accent-sky-600"
            />
          </div>

          <div>
            <div class="flex justify-between items-center text-sm font-semibold mb-2">
              <label for="range-ticket">Ticket medio de cirugía / intervención:</label>
              <span id="val-ticket" class="text-sky-600 dark:text-sky-400 font-bold">4.200 €</span>
            </div>
            <input
              type="range"
              id="range-ticket"
              min="2000"
              max="9000"
              step="200"
              value="4200"
              class="w-full accent-sky-600"
            />
          </div>

          <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            *Cálculo conservador basado en un incremento del 5% en conversión de solicitantes a cirugía programada gracias al triaje en &lt;60s y ahorro de 45 min por expediente revisado.
          </p>
        </div>

        <!-- Result Box -->
        <div data-reveal class="rounded-3xl border border-sky-500/20 bg-sky-500/5 p-8 text-center sm:text-left">
          <div class="text-xs uppercase tracking-wider font-semibold text-sky-700 dark:text-sky-400">
            Impacto Operativo Mensual Estimado
          </div>
          <div class="mt-4 grid grid-cols-2 gap-4">
            <div>
              <div id="res-cirugias" class="text-3xl sm:text-4xl font-extrabold text-[#1d1d1f] dark:text-white">+6</div>
              <div class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-1">Cirugías adicionales retenidas</div>
            </div>
            <div>
              <div id="res-horas" class="text-3xl sm:text-4xl font-extrabold text-[#1d1d1f] dark:text-white">35 h</div>
              <div class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-1">Horas administrativas liberadas</div>
            </div>
          </div>
          <div class="mt-6 pt-6 border-t border-sky-500/20">
            <div class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Facturación quirúrgica recuperada:</div>
            <div id="res-ingresos" class="text-2xl sm:text-3xl font-extrabold text-sky-600 dark:text-sky-400 mt-1">
              +25.200 € / mes
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SPRINT SERVICE -->
  <section id="sprint" class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">Entrega garantizada en 7 días</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Automation Sprint: Triaje Traumatológico Inmediato
        </h2>
        <p class="mt-4 text-[#6e6e73] dark:text-[#a1a1a6] text-base leading-relaxed">
          Un servicio cerrado, sin cuotas sorpresa, completamente integrado con sus herramientas clínicas habituales.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <div data-reveal class="rounded-3xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="font-bold text-lg text-[#1d1d1f] dark:text-white">1. Asistente Conversacional</div>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Despliegue del árbol de decisión traumatológico en WhatsApp Cloud API y web con detección de articulación, síntomas agudos y escala de dolor.
          </p>
        </div>

        <div data-reveal class="rounded-3xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="font-bold text-lg text-[#1d1d1f] dark:text-white">2. Conexión con Software Médico</div>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Integración con Clinic Cloud, DriCloud, Gesden Médica, SAP o Google Workspace mediante webhooks seguros en n8n.
          </p>
        </div>

        <div data-reveal class="rounded-3xl border border-black/8 dark:border-white/10 p-6 bg-black/[0.02] dark:bg-white/[0.02]">
          <div class="font-bold text-lg text-[#1d1d1f] dark:text-white">3. Cumplimiento RGPD Art. 9</div>
          <p class="mt-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
            Contrato DPA específico incluido, consentimiento explícito previo, cifrado TLS 1.3 de punto a punto y cero almacenamiento secundario de imágenes.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- LEAD FORM -->
  <section class="py-20 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-xl px-6">
      <div data-reveal class="text-center">
        <p class="eyebrow">Contacto confidencial</p>
        <h2 class="text-3xl font-semibold tracking-tight mt-3">
          Solicite una demostración de triaje traumatológico
        </h2>
        <p class="mt-3 text-[#6e6e73] dark:text-[#a1a1a6] text-sm">
          Le mostraremos el flujo exacto de clasificación articular y recepción de RMN en directo.
        </p>
      </div>

      <form
        action={BACKEND_LEAD}
        method="POST"
        class="mt-10 space-y-4 rounded-3xl border border-black/10 dark:border-white/15 p-8 bg-white dark:bg-[#1c1c1e] shadow-sm"
      >
        <input type="hidden" name="origen" value="landing_traumatologia_barcelona" />

        <div>
          <label for="nombre" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre y Apellidos</label>
          <input type="text" id="nombre" name="nombre" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Dr. / Dña..." />
        </div>

        <div>
          <label for="centro" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Nombre del Centro / Instituto Traumatológico</label>
          <input type="text" id="centro" name="empresa" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Instituto de Cirugía Ortopédica..." />
        </div>

        <div>
          <label for="email" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Correo Corporativo</label>
          <input type="email" id="email" name="email" required class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="direccion@suclinica.es" />
        </div>

        <div>
          <label for="software" class="block text-xs font-semibold text-[#1d1d1f] dark:text-white mb-1">Software de Gestión / Agenda Actual</label>
          <input type="text" id="software" name="software" class="w-full rounded-xl border border-black/10 dark:border-white/15 px-3 py-2 text-sm bg-transparent" placeholder="Ej: Clinic Cloud, DriCloud, Gesden, SAP..." />
        </div>

        <div class="pt-2">
          <button type="submit" class="button-primary w-full text-center">
            Enviar solicitud confidencial →
          </button>
        </div>

        <p class="text-[11px] text-[#86868b] text-center mt-3">
          Tratamiento confidencial de datos bajo el RGPD. Cero spam.
        </p>
      </form>
    </div>
  </section>

  <!-- FOOTER CTA -->
  <Cta
    titulo="¿Su centro atiende más de 60 consultas de traumatología al mes?"
    texto="Diseñamos un flujo a medida que conecta directamente con sus especialistas de rodilla, hombro, cadera y columna."
  />

  <!-- CALCULATOR SCRIPT -->
  <script>
    (function () {
      const rConsultas = document.getElementById("range-consultas");
      const rTicket = document.getElementById("range-ticket");
      const valConsultas = document.getElementById("val-consultas");
      const valTicket = document.getElementById("val-ticket");
      const resCirugias = document.getElementById("res-cirugias");
      const resHoras = document.getElementById("res-horas");
      const resIngresos = document.getElementById("res-ingresos");

      function recalc() {
        if (!rConsultas || !rTicket || !valConsultas || !valTicket || !resCirugias || !resHoras || !resIngresos) return;
        const c = parseInt(rConsultas.value, 10);
        const t = parseInt(rTicket.value, 10);

        valConsultas.textContent = String(c);
        valTicket.textContent = t.toLocaleString("es-ES") + " €";

        // 5% additional surgery conversions
        const cirugias = Math.max(1, Math.round(c * 0.05));
        const horas = Math.round(c * 0.3);
        const ingresos = cirugias * t;

        resCirugias.textContent = "+" + cirugias;
        resHoras.textContent = horas + " h";
        resIngresos.textContent = "+" + ingresos.toLocaleString("es-ES") + " € / mes";
      }

      if (rConsultas && rTicket) {
        rConsultas.addEventListener("input", recalc);
        rTicket.addEventListener("input", recalc);
        recalc();
      }
    })();
  </script>
</Base>
