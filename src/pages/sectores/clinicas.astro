  <!-- SCRIPT DE REACTIVIDAD DEL DIAGNÓSTICO Y ENVÍO DE FORMULARIO -->
  <script>
    (function () {
      // 1. Lógica reactiva del calculador interactivo
      var selectTipo = document.getElementById("diag-tipo");
      var selectGabinetes = document.getElementById("diag-gabinetes");
      var selectFriccion = document.getElementById("diag-friccion");
      var selectSoftware = document.getElementById("diag-software");

      var elHorasAdmin = document.getElementById("metric-horas-admin");
      var elAdminDesc = document.getElementById("metric-admin-desc");
      var elHorasGabinete = document.getElementById("metric-horas-gabinete");
      var elGabineteDesc = document.getElementById("metric-gabinete-desc");
      var elModuloPrioritario = document.getElementById("metric-modulo-prioritario");

      function recalcular() {
        if (!selectGabinetes || !selectFriccion) return;
        var g = selectGabinetes.value;
        var f = selectFriccion.value;

        // Horas según gabinetes
        var adminHoras = "20–30 horas / mes";
        var gabineteHoras = "4–8 horas / mes";

        if (g === "1-2") {
          adminHoras = "15–25 horas / mes";
          gabineteHoras = "4–8 horas de consulta / mes";
        } else if (g === "3-5") {
          adminHoras = "35–55 horas / mes";
          gabineteHoras = "10–18 horas de consulta / mes";
        } else if (g === "6-10") {
          adminHoras = "60–90 horas / mes";
          gabineteHoras = "20–35 horas de consulta / mes";
        } else if (g === "mas-10") {
          adminHoras = "+100 horas / mes";
          gabineteHoras = "+40 horas de consulta / mes";
        }

        // Módulo prioritario según fricción principal
        var modulo = "Confirmación activa + Reasignación de huecos";
        if (f === "recepcion") {
          modulo = "Triaje inteligente + Clasificación de entrada";
        } else if (f === "preanamnesis") {
          modulo = "Pre-anamnesis digital antes del gabinete";
        } else if (f === "seguimiento") {
          modulo = "Seguimiento reglado de presupuestos y revisiones";
        }

        if (elHorasAdmin) elHorasAdmin.textContent = adminHoras;
        if (elHorasGabinete) elHorasGabinete.textContent = gabineteHoras;
        if (elModuloPrioritario) elModuloPrioritario.textContent = modulo;
      }

      if (selectTipo) selectTipo.addEventListener("change", recalcular);
      if (selectGabinetes) selectGabinetes.addEventListener("change", recalcular);
      if (selectFriccion) selectFriccion.addEventListener("change", recalcular);
      if (selectSoftware) selectSoftware.addEventListener("change", recalcular);

      // 2. Manejo del formulario de envío de lead / informe
      var form = document.getElementById("form-clinica-lead");
      if (!form) return;

      var statusEl = document.getElementById("form-status-msg");
      var btnSubmit = document.getElementById("btn-enviar-diagnostico");
      var leadUrl = form.getAttribute("data-lead") || "";
      var fallbackEmail = form.getAttribute("data-email") || "varinoagency@gmail.com";

      function getVal(name) {
        var el = form.querySelector('[name="' + name + '"]');
        return el ? el.value.trim() : "";
      }

      function enviarPorMailto(datos) {
        var asunto = "Diagnóstico Clínica: " + datos.clinica + " (" + datos.ubicacion + ")";
        var cuerpo =
          "SOLICITUD DE DIAGNÓSTICO OPERATIVO PARA CLÍNICA\n\n" +
          "Nombre y cargo: " + datos.nombre + "\n" +
          "Clínica: " + datos.clinica + "\n" +
          "Ubicación: " + datos.ubicacion + "\n" +
          "Email: " + datos.email + "\n" +
          "Teléfono/WhatsApp: " + datos.whatsapp + "\n" +
          "Plazo deseado: " + datos.plazo_deseado + "\n\n" +
          "DATOS DEL DIAGNÓSTICO:\n" +
          "- Tipo de centro: " + datos.tipo_clinica + "\n" +
          "- Gabinetes activos: " + datos.num_gabinetes + "\n" +
          "- Mayor fricción: " + datos.friccion_principal + "\n" +
          "- Software clínico: " + datos.software_clinico + "\n\n" +
          "Comentarios: " + (datos.comentario || "Sin comentarios adicionales");

        window.location.href =
          "mailto:" + fallbackEmail + "?subject=" + encodeURIComponent(asunto) + "&body=" + encodeURIComponent(cuerpo);

        if (statusEl) {
          statusEl.textContent = "✓ Abriendo tu gestor de correo para enviar la solicitud. Te responderemos en breve.";
        }
      }

      form.addEventListener("submit", function (ev) {
        ev.preventDefault();

        // Comprobación anti-spam honeypot
        var honeypot = form.querySelector('input[name="website"]');
        if (honeypot && honeypot.value) return;

        var consentEl = form.querySelector('input[name="consentimiento"]');
        if (!consentEl || !consentEl.checked) {
          if (statusEl) statusEl.textContent = "Por favor, acepta la política de privacidad para continuar.";
          return;
        }

        var payload = {
          nombre: getVal("nombre"),
          clinica: getVal("clinica"),
          ubicacion: getVal("ubicacion"),
          email: getVal("email"),
          whatsapp: getVal("whatsapp"),
          plazo_deseado: getVal("plazo_deseado"),
          comentario: getVal("comentario"),
          tipo_clinica: selectTipo ? selectTipo.value : "",
          num_gabinetes: selectGabinetes ? selectGabinetes.value : "",
          friccion_principal: selectFriccion ? selectFriccion.value : "",
          software_clinico: selectSoftware ? selectSoftware.value : "",
          interes: "automation-sprint-clinicas",
          fuente: "landing-sectores-clinicas",
          pagina: location.pathname,
          consentimiento: true,
          fecha: new Date().toISOString(),
        };

        if (statusEl) statusEl.textContent = "Procesando solicitud de diagnóstico…";
        if (btnSubmit) btnSubmit.setAttribute("disabled", "true");

        if (leadUrl) {
          fetch(leadUrl, {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "ngrok-skip-browser-warning": "true",
            },
            body: JSON.stringify(payload),
          })
            .then(function (res) {
              return res.json();
            })
            .then(function (data) {
              if (data && data.ok) {
                if (statusEl) {
                  statusEl.textContent = "✓ Diagnóstico recibido. El equipo de VARINO se pondrá en contacto en menos de 24 horas.";
                }
                form.reset();
                recalcular();
              } else {
                enviarPorMailto(payload);
              }
            })
            .catch(function () {
              enviarPorMailto(payload);
            })
            .finally(function () {
              if (btnSubmit) btnSubmit.removeAttribute("disabled");
            });
        } else {
          enviarPorMailto(payload);
          if (btnSubmit) btnSubmit.removeAttribute("disabled");
        }
      });
    })();
  </script>
</Base>
