---
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";
import { BASE, SITE, BACKEND_LEAD, whatsappUrl } from "../../config";

const wa = whatsappUrl(
  "Hola, me interesa conocer el Automation Sprint para Clínicas y Centros de Salud de VARINO."
);

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Automation Sprint para Clínicas y Centros de Salud en Barcelona",
  provider: {
    "@type": "ProfessionalService",
    name: SITE.name,
    url: SITE.url,
    address: {
      "@type": "PostalAddress",
      "addressLocality": "Barcelona",
      "addressRegion": "Catalunya",
      "addressCountry": "ES",
    },
  },
  description:
    "Solución de automatización operativa para clínicas dentales y centros de salud privados en Barcelona: triaje asistido, pre-anamnesis digital antes del gabinete y reducción activa de inasistencias con supervisión humana.",
  serviceType: "Automatización e IA Operativa para Clínicas",
});
---

<Base
  title="Automation Sprint para Clínicas en Barcelona"
  description="Optimización operativa para directores médicos y gerentes en Barcelona: triaje asistido, pre-anamnesis digital antes del gabinete y reducción de inasistencias con supervisión humana."
>
  <script type="application/ld+json" set:html={schema} />

  <!-- HERO SECTION -->
  <section class="relative overflow-hidden pt-20 pb-16 sm:pt-28 sm:pb-24 border-b border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <!-- Breadcrumb & Local Badge -->
      <div data-reveal class="flex flex-wrap items-center gap-2 text-xs text-[#6e6e73] dark:text-[#a1a1a6] mb-6">
        <a href={`${BASE}/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Inicio</a>
        <span>/</span>
        <a href={`${BASE}/sectores/`} class="hover:text-[#1d1d1f] dark:hover:text-white transition">Sectores</a>
        <span>/</span>
        <span class="text-[#1d1d1f] dark:text-white font-medium">Clínicas y Salud Privada</span>
      </div>

      <div data-reveal class="inline-flex items-center gap-2 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-3.5 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-400 mb-6">
        <span class="h-2 w-2 rounded-full bg-emerald-500 live-dot"></span>
        <span>Especialización Barcelona · Privacidad RGPD Art. 9</span>
      </div>

      <div data-reveal class="max-w-4xl">
        <p class="eyebrow">Solución sectorial · Salud privada y odontología</p>
        <h1 class="display-title mt-4">
          Menos tiempo administrativo en recepción.<br />
          <span>Más tiempo clínico en gabinete.</span>
        </h1>
        <p class="mt-7 max-w-2xl text-lg sm:text-xl leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
          Diseñado para <strong>directores médicos y gerentes</strong> de clínicas dentales y centros de salud privados de Barcelona. Sustituimos llamadas perdidas, cuestionarios en papel y huecos imprevistos de agenda por flujos automatizados bajo supervisión humana permanente.
        </p>

        <!-- CTAs -->
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#diagnostico" class="button-primary">
            Diagnosticar mi clínica gratis →
          </a>
          <a href="#solucion" class="button-secondary">
            Ver solución técnica
          </a>
          {wa && (
            <a
              href={wa}
              class="inline-flex items-center gap-2 text-xs font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline px-3 py-2"
            >
              Consulta directa por WhatsApp ↗
            </a>
          )}
        </div>

        <!-- Trust Highlights -->
        <div class="mt-12 grid grid-cols-2 gap-4 border-t border-black/8 dark:border-white/10 pt-8 sm:grid-cols-4">
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Plazo del sprint</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">15–21 días hábiles</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Control facultativo</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">100% Supervisado</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Seguridad y RGPD</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Datos de salud protegidos</strong>
          </div>
          <div>
            <span class="block text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Ámbito geográfico</span>
            <strong class="mt-1 block text-sm font-semibold text-[#1d1d1f] dark:text-white">Barcelona y área metropolitana</strong>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EL CUELLO DE BOTELLA OPERATIVO EN CLÍNICAS -->
  <section class="py-20 sm:py-28 bg-[#f7f7f5] dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-2xl">
        <p class="eyebrow">El diagnóstico operativo</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          La fricción no está en la atención médica. Está en la entrada de pacientes.
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          En los centros de salud y policlínicas de Barcelona, el equipo facultativo es de primer nivel, pero la operativa diaria de recepción y pre-consulta consume recursos críticos.
        </p>
      </div>

      <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <!-- Card 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 font-bold text-sm">
            01
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Recepción colapsada y triaje desordenado
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Llamadas sonando, cola en mostrador y mensajes de WhatsApp sin clasificar. Citas de urgencia dolorosa compiten con revisiones ordinarias y el personal no dispone de un protocolo automatizado para priorizar.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Citas mal dimensionadas en tiempo de sillón y esperas no deseadas.
          </div>
        </article>

        <!-- Card 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-rose-500/10 text-rose-600 dark:text-rose-400 font-bold text-sm">
            02
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            El gabinete parado por anamnesis en papel
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente llega a la sala de espera y pasa los primeros minutos rellenando un portapapeles con antecedentes, medicación y alergias. El doctor dedica los primeros 7 a 10 minutos de consulta a transcribir datos básicos.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Pérdida de hasta un 20% del tiempo efectivo de gabinete por cada primera visita.
          </div>
        </article>

        <!-- Card 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 bg-white p-7 dark:border-white/10 dark:bg-[#111318]">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-blue-500/10 text-blue-600 dark:text-blue-400 font-bold text-sm">
            03
          </div>
          <h3 class="mt-5 text-xl font-semibold text-[#1d1d1f] dark:text-white">
            Inasistencias y huecos vacíos en agenda
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El ausentismo no avisado (no-shows) deja salas y gabinetes vacíos con el equipo médico listo pero improductivo. Las confirmaciones manuales por llamada son lentas y no dan margen para reasignar el hueco a tiempo.
          </p>
          <div class="mt-5 border-t border-black/5 dark:border-white/10 pt-4 text-xs text-[#86868b]">
            <span class="font-medium text-[#1d1d1f] dark:text-white">Consecuencia:</span> Horas de sillón médico desaprovechadas que no se pueden recuperar.
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- LA SOLUCIÓN: AUTOMATION SPRINT PARA CLÍNICAS -->
  <section id="solucion" class="py-24 sm:py-32">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="max-w-3xl">
        <p class="eyebrow">La propuesta técnica</p>
        <h2 class="mt-3 text-3xl sm:text-5xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Automation Sprint para Clínicas
        </h2>
        <p class="mt-5 text-lg text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
          Un proyecto de alcance acotado e implantación directa en 3 semanas. Conectamos los canales de entrada de vuestra clínica con un sistema observable que asiste a recepción y prepara al facultativo antes de abrir la puerta del gabinete.
        </p>
      </div>

      <!-- 4 Pillars Grid -->
      <div class="mt-16 grid gap-8 md:grid-cols-2">
        <!-- Pillar 1 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 01</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Recepción asistida</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Triaje inteligente de pacientes
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Clasificación automática previa por motivo de consulta: dolor agudo / urgencia, primera visita diagnóstica, revisión ordinaria o continuación de tratamiento.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Detección previa del motivo clínico y estimación de duración en agenda.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Asignación de cola al especialista adecuado (ej. odontopediatra, implantólogo o médico general).</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span><strong>Parada humana estricta:</strong> recepción siempre valida y aprueba antes de confirmar en agenda.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 2 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 02</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Pre-consulta ágil</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Pre-anamnesis digital antes del gabinete
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente recibe un enlace seguro a su móvil 24 horas antes de la cita. Completa sus antecedentes de salud, alergias y medicación habitual en menos de 2 minutos.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Cuestionario médico adaptable según la especialidad y el motivo de cita.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>El doctor dispone de la ficha sintética estructurada antes de que el paciente entre a consulta.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Eliminación de portapapeles en sala y ahorro de 5 a 10 minutos de consulta por paciente.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 3 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 03</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Ocupación de agenda</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Confirmación activa y recuperación de huecos
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Sistema interactivo de confirmación y reasignación ágil que minimiza los no-shows y rescata horas de sillón libres ante cancelaciones imprevistas.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Recordatorio y confirmación bidireccional mediante WhatsApp oficial o SMS.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>En caso de cancelación, el sistema propone automáticamente pacientes en lista de espera con disponibilidad rápida.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Recepción conserva el control absoluto para autorizar o pausar cualquier contacto.</span>
            </li>
          </ul>
        </article>

        <!-- Pillar 4 -->
        <article data-reveal class="rounded-3xl border border-black/8 p-8 bg-[#fbfbfd] dark:border-white/10 dark:bg-[#111318]">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-[#0071e3] dark:text-[#2997ff]">Módulo 04</span>
            <span class="rounded-full bg-black/5 dark:bg-white/10 px-3 py-0.5 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">Cumplimiento normativo</span>
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-[#1d1d1f] dark:text-white">
            Privacidad clínica y RGPD Artículo 9
          </h3>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
            Protección integral de datos de salud (categoría especial bajo RGPD y LOPDGDD). Cero filtraciones a herramientas no autorizadas.
          </p>
          <ul class="mt-6 space-y-2.5 text-xs text-[#424245] dark:text-[#d2d2d7]">
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Servidores bajo soberanía europea o despliegue local (on-premise) en vuestro propio servidor.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Firma de Acuerdo de Encargo de Tratamiento de Datos (<a href={`${BASE}/dpa/`} class="underline text-[#0071e3] dark:text-[#2997ff]">DPA</a>) específico para salud.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-[#0071e3] font-bold">✓</span>
              <span>Los datos clínicos jamás se utilizan para entrenar inteligencias artificiales externas o públicas.</span>
            </li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- EL FLUJO OBSERVABLE (ARQUITECTURA DE LA CONSULTA) -->
  <section class="py-20 bg-[#f7f7f5] dark:bg-[#0a0d14] border-y border-black/5 dark:border-white/10">
    <div class="mx-auto max-w-6xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Recorrido del paciente</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          El flujo de atención, paso a paso
        </h2>
        <p class="mt-3 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">
          Desde que el paciente entra en contacto hasta que se sienta en consulta. Sin lagunas ni tareas duplicadas.
        </p>
      </div>

      <div class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <div data-reveal class="rounded-2xl border border-black/8 bg-white p-6 dark:border-white/10 dark:bg-[#111318]">
          <span class="text-xs font-bold text-[#0071e3]">PASO 01</span>
          <h4 class="mt-4 font-semibold text-[#1d1d1f] dark:text-white">Entrada y Triaje</h4>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente solicita cita por web, WhatsApp o recepción. El sistema clasifica el motivo clínico, estima la duración necesaria y asigna la cola médica adecuada.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 bg-white p-6 dark:border-white/10 dark:bg-[#111318]">
          <span class="text-xs font-bold text-[#0071e3]">PASO 02</span>
          <h4 class="mt-4 font-semibold text-[#1d1d1f] dark:text-white">Confirmación Activa</h4>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            48h y 24h antes, se valida la asistencia. En caso de no confirmación o cancelación, se activa la lista de espera para reasignar el hueco de gabinete al instante.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 bg-white p-6 dark:border-white/10 dark:bg-[#111318]">
          <span class="text-xs font-bold text-[#0071e3]">PASO 03</span>
          <h4 class="mt-4 font-semibold text-[#1d1d1f] dark:text-white">Pre-anamnesis Móvil</h4>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            El paciente completa su cuestionario de salud y antecedentes en su teléfono móvil antes de llegar al centro. Los datos se cifran y estructuran de inmediato.
          </p>
        </div>

        <div data-reveal class="rounded-2xl border border-black/8 bg-white p-6 dark:border-white/10 dark:bg-[#111318]">
          <span class="text-xs font-bold text-[#0071e3]">PASO 04</span>
          <h4 class="mt-4 font-semibold text-[#1d1d1f] dark:text-white">Consulta Efectiva</h4>
          <p class="mt-2 text-xs leading-relaxed text-[#6e6e73] dark:text-[#a1a1a6]">
            El facultativo abre la ficha con la información clínica pre-validada y comienza el diagnóstico de inmediato, sin perder tiempo en trámites burocráticos de sala.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FORMULARIO INTERACTIVO DE DIAGNÓSTICO DE CLÍNICA -->
  <section id="diagnostico" class="py-24 sm:py-32">
    <div class="mx-auto max-w-5xl px-6">
      <div data-reveal class="text-center max-w-2xl mx-auto">
        <p class="eyebrow">Evaluador Operativo</p>
        <h2 class="mt-3 text-3xl sm:text-4xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white">
          Diagnóstico interactivo para tu clínica
        </h2>
        <p class="mt-4 text-base text-[#6e6e73] dark:text-[#a1a1a6]">
          Selecciona la configuración de tu centro para calcular una estimación de capacidad recuperable y recibir una propuesta de arquitectura de automatización adaptada.
        </p>
      </div>

      <!-- Interactive Calculator Container -->
      <div
        data-reveal
        class="mt-12 rounded-[2.5rem] border border-black/10 bg-[#f7f7f5] p-6 sm:p-10 dark:border-white/10 dark:bg-[#111318] shadow-xl"
      >
        <div class="grid gap-10 lg:grid-cols-12 items-start">
          <!-- Configurator Selectors (Left / 7 cols) -->
          <div class="lg:col-span-7 space-y-6">
            <h3 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">
              1. Perfil y operativa actual
            </h3>

            <!-- Tipo de centro -->
            <div>
              <label for="diag-tipo" class="block text-xs font-semibold uppercase tracking-wider text-[#6e6e73] dark:text-[#a1a1a6] mb-2">
                Tipo de centro médico o clínica
              </label>
              <select
                id="diag-tipo"
                name="tipo_clinica"
                class="w-full rounded-2xl border border-black/12 bg-white px-4 py-3 text-sm text-[#1d1d1f] dark:border-white/15 dark:bg-[#0a0d14] dark:text-white focus:border-[#0071e3] focus:outline-none"
              >
                <option value="dental">Clínica Dental / Odontológica</option>
                <option value="policlinica">Policlínica o Centro Médico Privado</option>
                <option value="fisioterapia">Traumatología, Fisioterapia o Rehabilitación</option>
                <option value="especialidades">Otras Especialidades (Dermatología, Oftalmología, etc.)</option>
              </select>
            </div>

