---
import Base from "../layouts/Base.astro";
import InteractiveMissions from "../components/InteractiveMissions.astro";
import Cta from "../components/Cta.astro";
import { BASE, MAINTENANCE_PLANS, SERVICES, SITE } from "../config";
---

<Base title="Automatización e IA con control" description={SITE.description}>
  <section class="relative overflow-hidden px-6 pb-24 pt-24 sm:pb-32 sm:pt-32">
    <div class="pointer-events-none absolute left-1/2 top-0 h-[36rem] w-[70rem] -translate-x-1/2 rounded-full bg-[#655cff]/12 blur-[130px]"></div>
    <div class="relative mx-auto max-w-6xl">
      <p class="eyebrow">Inteligencia, puesta a trabajar.</p>
      <h1 class="display-title max-w-5xl">Menos fricción.<br /><span>Más capacidad.</span></h1>
      <p class="mt-8 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6] sm:text-xl">Convertimos procesos manuales, seguimiento disperso y conocimiento difícil de encontrar en sistemas observables, revisables y preparados para crecer.</p>
      <div class="mt-10 flex flex-wrap gap-3">
        <a href={`${BASE}/experiencia/`} class="button-primary">Probar una misión</a>
        <a href={`${BASE}/servicios/`} class="button-secondary">Explorar servicios</a>
      </div>
      <div class="mt-16 grid gap-px overflow-hidden rounded-3xl border border-black/8 bg-black/8 dark:border-white/10 dark:bg-white/10 sm:grid-cols-3">
        <div class="bg-white p-6 dark:bg-[#111318]"><span class="text-xs text-[#655cff]">01</span><strong class="mt-8 block text-lg">Proceso antes que herramienta</strong><p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">Primero entendemos decisiones, excepciones y responsables.</p></div>
        <div class="bg-white p-6 dark:bg-[#111318]"><span class="text-xs text-[#655cff]">02</span><strong class="mt-8 block text-lg">Humano en los puntos críticos</strong><p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">La IA prepara; las acciones sensibles se revisan.</p></div>
        <div class="bg-white p-6 dark:bg-[#111318]"><span class="text-xs text-[#655cff]">03</span><strong class="mt-8 block text-lg">Privacidad por diseño</strong><p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">Datos mínimos, permisos definidos y opciones locales.</p></div>
      </div>
    </div>
  </section>

  <InteractiveMissions compact />

  <section class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
    <div class="section-heading"><div><p class="eyebrow">Tres formas de empezar</p><h2>Un problema concreto.<br />Un sistema útil.</h2></div><p>Los rangos son orientativos. Una persona confirma el alcance, dependencias y precio antes de comenzar.</p></div>
    <div class="mt-14 grid gap-5 lg:grid-cols-3">
      {SERVICES.map((service) => (
        <article class="rounded-[2rem] border border-black/8 bg-[#f7f7f5] p-7 dark:border-white/10 dark:bg-[#111318]">
          <p class="text-xs font-bold text-[#655cff]">{service.numero} · {service.tag}</p>
          <h3 class="mt-8 text-3xl font-semibold tracking-[-0.04em]">{service.name}</h3>
          <p class="mt-3 min-h-20 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{service.summary}</p>
          <div class="mt-8 border-t border-black/8 pt-5 dark:border-white/10"><span class="text-xs text-[#6e6e73]">Rango indicativo</span><strong class="mt-1 block">{service.range}</strong></div>
          <a href={`${BASE}/servicios/${service.id === "growth-system" ? "sistema-crecimiento" : service.id === "private-ai" ? "ia-privada" : service.id}/`} class="service-link">Ver alcance y límites <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="border-y border-black/6 bg-[#f7f7f5] dark:border-white/10 dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6 py-24 sm:py-32">
      <p class="eyebrow">Método VARINO</p>
      <h2 class="mt-3 max-w-3xl text-4xl font-semibold tracking-[-0.05em] sm:text-6xl">Diseñar, probar y mejorar sin perder el control.</h2>
      <ol class="method-grid mt-14">
        {[["01","Diagnosticar","Proceso, datos, excepciones y línea base."],["02","Diseñar","Alcance, controles y recuperación."],["03","Construir","Primera versión observable y documentada."],["04","Revisar","Pruebas, aprobación y decisión de escala."]].map(([n,t,d]) => <li><span>{n}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
      <a href={`${BASE}/metodo/`} class="button-secondary mt-8">Conocer el método completo</a>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-8 px-6 py-24 sm:py-32 lg:grid-cols-[.85fr_1.15fr]">
    <div><p class="eyebrow">Operación continua</p><h2 class="mt-3 text-4xl font-semibold tracking-[-0.05em] sm:text-5xl">Construir es el inicio. Mantenerlo fiable es el trabajo.</h2><p class="mt-5 text-[#6e6e73] dark:text-[#a1a1a6]">El mantenimiento es opcional y se acuerda con límites, soporte y responsabilidades visibles.</p></div>
    <div class="grid gap-3 sm:grid-cols-2">{MAINTENANCE_PLANS.map((plan) => <article class="rounded-2xl border border-black/8 p-5 dark:border-white/10"><div class="flex items-start justify-between gap-3"><h3 class="font-semibold">{plan.name}</h3><strong class="text-sm text-[#655cff]">{plan.monthly}</strong></div><p class="mt-4 text-xs leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{plan.includes.join(" · ")}</p></article>)}</div>
  </section>

  <Cta titulo="Cuéntanos dónde se atasca el trabajo." texto="Puedes explorar un caso sin identificarte. Nada se envía mientras la experiencia siga en modo demostración local." />
</Base>
