---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base
  title={`Seguridad e IA responsable — ${SITE.name}`}
  description="Privacidad, mínimo acceso, IA local y control humano como requisitos del sistema."
>
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="eyebrow">Seguridad e IA responsable</p>
    <h1 class="display-title max-w-4xl">Control antes<br /><span>que automatismo.</span></h1>
    <p class="mt-8 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">
      Diseñamos cada solución con datos mínimos, permisos limitados, trazabilidad y
      aprobación humana. Las verificaciones pendientes se presentan como pendientes,
      nunca como certificaciones obtenidas.
    </p>
  </section>
</Base>
