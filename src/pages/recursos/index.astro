---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";

const guias = [
  {
    href: "/recursos/solicitudes-citas-whatsapp/",
    tag: "Operaciones",
    title: "Solicitudes por WhatsApp, teléfono y web: el problema no es el canal",
    excerpt: "Cuando las peticiones llegan por tres bandas, lo que falla es no tener una entrada única. Cómo se ordena sin perder el control humano.",
  },
  {
    href: "/recursos/ia-local-datos-sensibles/",
    tag: "IA privada",
    title: "IA local para datos sensibles: qué es y cuándo compensa",
    excerpt: "Qué modelo ejecutar en tu propio equipo, qué memoria pide de verdad y qué compra (y qué no) frente a un servicio externo.",
  },
  {
    href: "/recursos/presupuesto-automatizacion/",
    tag: "Precios",
    title: "Qué presupuesto tiene automatizar un proceso (y cómo se calcula)",
    excerpt: "Horas por partida, margen de contingencia y mantenimiento: cómo reconocer un presupuesto honesto, el nuestro incluido.",
  },
];
---

<Base
  title={`Guías y recursos`}
  description="Guías prácticas sobre automatización de procesos, IA local para datos sensibles y presupuestos honestos."
>
  <section class="mx-auto max-w-4xl px-6 pb-24 pt-20 sm:pt-28">
    <p class="eyebrow">Recursos</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-[-0.045em] text-[#1d1d1f] dark:text-white sm:text-6xl">
      Decidir con contexto.
    </h1>
    <p class="mt-7 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">
      Guías escritas para quien evalúa automatizar por primera vez. Sin porcentajes mágicos, sin
      casos inventados: lo que hay aquí se puede comprobar.
    </p>
    <div class="mt-12 grid gap-4">
      {guias.map((guia) => (
        <a
          href={guia.href}
          class="group rounded-3xl border border-black/8 p-7 transition hover:border-[#0071e3]/40 dark:border-white/10"
        >
          <p class="text-xs font-bold text-[#655cff]">{guia.tag}</p>
          <h2 class="mt-5 text-2xl font-semibold tracking-[-0.03em] text-[#1d1d1f] dark:text-white">{guia.title}</h2>
          <p class="mt-3 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{guia.excerpt}</p>
          <p class="mt-5 text-sm font-semibold text-[#0071e3] dark:text-[#2997ff]">Leer la guía <span aria-hidden="true">→</span></p>
        </a>
      ))}
    </div>
  </section>
</Base>
