---
import Base from '../layouts/Base.astro';
---
<Base title="Preferencias de correo" description="Confirma la baja de las comunicaciones comerciales de VARINO. No necesitas iniciar sesión ni proporcionar de nuevo tu dirección de correo." noindex={true} includeVisitorTools={false}>
  <div class="unsubscribe-page">
    <section aria-labelledby="unsubscribe-title">
      <span class="eyebrow">Tu correo. Tu decisión.</span>
      <h1 id="unsubscribe-title">Solo lo que<br />quieres recibir.</h1>
      <p>Confirma que no quieres recibir más comunicaciones comerciales de VARINO. No necesitas una cuenta ni escribir tu email.</p>
      <div class="preference-card">
        <h2>Baja de comunicaciones comerciales</h2>
        <p>Abrir este enlace no cambia tu preferencia. La baja se solicita únicamente al pulsar el botón.</p>
        <button id="confirm-unsubscribe" type="button" disabled>Confirmar mi baja</button>
        <p id="unsubscribe-status" role="status" aria-live="polite" tabindex="-1">Comprobando el formato del enlace…</p>
        <noscript><p>Activa JavaScript para confirmar con este enlace. También puedes solicitar la baja respondiendo al correo original.</p></noscript>
      </div>
      <p class="fine-print">La baja no cancela un servicio contratado ni impide los mensajes necesarios para gestionarlo. Nunca te inscribe en otra lista.</p>
    </section>
  </div>
</Base>
<script>
  import { tokenFromFragment } from '../lib/unsubscribe-contract.mjs';
  const button = document.querySelector('#confirm-unsubscribe');
  const status = document.querySelector('#unsubscribe-status');
  const token = tokenFromFragment(window.location.hash);
  // Keep the bearer only in this page's memory: never local/session storage or a query URL.
  if (window.location.hash) history.replaceState(null, '', window.location.pathname);
  status.textContent = token ? 'Puedes confirmar tu baja cuando quieras.' : 'Este enlace no es válido. Abre el enlace completo del correo original o responde a ese correo para solicitar la baja.';
  button.disabled = !token;
  button.addEventListener('click', async () => {
    if (!token || button.disabled) return;
    button.disabled = true;
    status.textContent = 'Guardando tu preferencia…';
    try {
      const response = await fetch('/api/unsubscribe', { method: 'POST', credentials: 'omit', redirect: 'error',
        headers: { 'content-type': 'application/json' }, body: JSON.stringify({ token }), signal: AbortSignal.timeout(10000) });
      const data = await response.json();
      if (!response.ok || data?.ok !== true || data?.status !== 'suppressed') throw new Error('not_confirmed');
      button.textContent = 'Baja confirmada';
      status.textContent = 'Tu baja ha quedado guardada. Has solicitado dejar de recibir comunicaciones comerciales de VARINO.';
      status.focus();
    } catch {
      status.textContent = 'No hemos podido confirmar la baja. Reintenta con este mismo botón o responde al correo original. No necesitas volver a escribir tu email.';
      button.textContent = 'Volver a confirmar mi baja';
      button.disabled = false;
    }
  });
</script>
<style>
  .unsubscribe-page { min-height: 65vh; padding: clamp(3rem,8vw,6rem) 1.5rem; }
  .unsubscribe-page section { max-width: 42rem; margin: auto; }
  .eyebrow { color: #655cff; font-size: .875rem; font-weight: 650; letter-spacing: .035em; }
  h1 { font-size: clamp(2.5rem,7vw,4.5rem); font-weight: 650; letter-spacing: -.045em; line-height: 1.06; margin: 1rem 0 1.5rem; }
  p { line-height: 1.65; max-width: 38rem; }
  .preference-card { margin: 2rem 0 1.25rem; padding: clamp(1.25rem,4vw,2rem); background: #f5f5f7; border: 1px solid #dedee3; border-radius: 1.5rem; }
  h2 { font-size: 1.125rem; font-weight: 650; margin-bottom: .75rem; }
  button { margin-top: 1.5rem; min-height: 3rem; padding: .75rem 1.35rem; border-radius: 3rem; background: #005dc3; color: white; font-weight: 650; cursor: pointer; }
  button:active:not(:disabled) { background: #004a9c; }
  button:disabled { cursor: default; background: #45454d; }
  button:focus-visible { outline: 3px solid #655cff; outline-offset: 4px; }
  #unsubscribe-status { margin-top: 1.25rem; font-size: .9375rem; }
  .fine-print { font-size: .875rem; color: #55555f; }
  :global(.dark) .preference-card { background: #16161b; border-color: #41414a; }
  :global(.dark) .fine-print { color: #b6b6bf; }
  :global(.dark) .eyebrow { color: #b0aaff; }
  @media (max-width: 450px) { button { width: 100%; } }
  @media (prefers-contrast: more) { .preference-card { border: 2px solid currentColor; } }
  @media (prefers-reduced-transparency: reduce) { .preference-card { backdrop-filter: none; } }
</style>
