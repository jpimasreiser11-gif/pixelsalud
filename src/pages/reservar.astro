---
import Base from "../layouts/Base.astro";
import { BASE, SITE, BACKEND } from "../config";
---
<Base
  title={`Reserva una llamada — ${SITE.name}`}
  description="Elige día y hora para una primera conversación gratuita con el equipo de VARINO sobre automatización e IA para tu empresa."
>
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-16 sm:pt-28">
    <p class="eyebrow">Llamada gratuita · 30 min</p>
    <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-[-0.05em] leading-[1.05]">Reserva una conversación.</h1>
    <p class="mt-4 max-w-2xl text-[#6e6e73] dark:text-[#a1a1a6] leading-relaxed">
      Sin compromiso y sin coste: hablamos del proceso que te quita tiempo, te aclaro cómo lo automatizaríamos
      y te dejo un rango de inversión real. Solo necesitas elegir hueco.
    </p>

    <div
      id="app-reservar"
      data-avail={`${BACKEND.url}/webhook/availability`}
      data-book={`${BACKEND.url}/webhook/book`}
      data-origin={BACKEND.origin}
      class="mt-10 grid gap-6 lg:grid-cols-[1.1fr_.9fr]"
    >
      <!-- Paso 1: huecos -->
      <div class="rounded-3xl border border-black/10 bg-[#f7f7f5] p-6 dark:border-white/10 dark:bg-[#111318] sm:p-8">
        <h2 class="font-semibold text-lg">1 · Elige un hueco</h2>
        <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6] mt-1" data-slot-status>Los horarios son de lunes a viernes, hora de España.</p>
        <div class="mt-4 grid gap-3" data-slots role="list" aria-live="polite"></div>
        <button type="button" class="mt-4 text-xs text-[#0071e3] hover:underline" data-refresh>↻ Ver más días</button>
      </div>

      <!-- Paso 2: datos -->
      <form id="form-reservar" data-slot class="rounded-3xl border border-black/10 bg-[#f7f7f5] p-6 shadow-sm space-y-3 dark:border-white/10 dark:bg-[#111318] sm:p-8" hidden>
        <input type="hidden" name="website" value="" aria-hidden="true" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="fecha" />
        <input type="hidden" name="hora" />
        <h2 class="font-semibold text-lg">2 · Tus datos</h2>
        <p class="text-xs text-[#0071e3]" data-pick><strong data-pick-dia></strong> · <span data-pick-hora></span></p>

        <div>
          <label for="res-nombre" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Nombre</label>
          <input id="res-nombre" name="nombre" type="text" required placeholder="Tu nombre" class="res-field" />
        </div>
        <div>
          <label for="res-email" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">Email</label>
          <input id="res-email" name="email" type="email" required placeholder="tu@email.com" class="res-field" />
        </div>
        <div>
          <label for="res-whatsapp" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">WhatsApp (opcional)</label>
          <input id="res-whatsapp" name="whatsapp" type="tel" placeholder="+34 600 000 000" class="res-field" />
        </div>
        <div>
          <label for="res-tema" class="block text-xs font-medium text-[#6e6e73] dark:text-[#a1a1a6] mb-1">¿De qué quieres hablar? (opcional)</label>
          <textarea id="res-tema" name="mensaje" rows="2" placeholder="P.ej.: automatizar la entrada de pedidos del email a nuestro CRM" class="res-field"></textarea>
        </div>

        <label class="flex items-start gap-2 text-[11px] leading-5 text-[#6e6e73] dark:text-[#a1a1a6]">
          <input type="checkbox" name="consentimiento" required class="mt-0.5 shrink-0" />
          <span>Acepto que VARINO guarde estos datos para gestionar la reserva y contactarme, según su <a href={`${BASE}/privacidad/`} class="underline hover:text-[#0071e3]">política de privacidad</a>.</span>
        </label>

        <button type="submit" class="w-full rounded-full bg-[#0071e3] px-6 py-3 font-semibold text-white transition hover:bg-[#0077ed] text-xs shadow-lg shadow-[#0071e3]/20">
          Confirmar reserva →
        </button>
        <p class="text-[11px] text-[#6e6e73] dark:text-[#a1a1a6] text-center" aria-live="polite" data-form-status>
          Recibirás una invitación por email con los datos de la llamada.
        </p>
      </form>

      <!-- Confirmación -->
      <div id="ok-reservar" hidden class="rounded-3xl border border-green-600/30 bg-green-50 p-8 text-center dark:bg-green-900/10 sm:p-10">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-green-100 text-green-600 dark:bg-green-900/40 dark:text-green-400 text-2xl font-bold">
          ✓
        </div>
        <h2 class="mt-4 font-semibold text-2xl tracking-tight">¡Reserva solicitada con éxito!</h2>
        <p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6] max-w-md mx-auto" data-ok-text></p>
        
        <div class="mt-6 flex flex-col sm:flex-row gap-3 justify-center items-center">
          <a data-ok-link href="#" target="_blank" rel="noopener" class="w-full sm:w-auto rounded-full bg-[#0071e3] px-6 py-3 text-xs font-semibold text-white shadow-md hover:bg-[#0077ed] transition">
            📅 Añadir a mi Google Calendar
          </a>
          <a data-ok-wa href="#" target="_blank" rel="noopener" class="w-full sm:w-auto rounded-full bg-[#25D366] px-6 py-3 text-xs font-semibold text-white shadow-md hover:bg-[#20ba59] transition">
            💬 Confirmar por WhatsApp
          </a>
        </div>
        <p class="mt-4 text-xs text-[#6e6e73] dark:text-[#a1a1a6]">
          El equipo de VARINO se pondrá en contacto contigo antes de la reunión.
        </p>
      </div>
    </div>

    <!-- Canal rápido alternativo -->
    <div class="mt-8 rounded-2xl border border-black/5 bg-black/[0.02] p-4 text-center dark:border-white/5 dark:bg-white/[0.02]">
      <p class="text-xs text-[#6e6e73] dark:text-[#a1a1a6]">
        ¿Prefieres coordinar tu diagnóstico en 30 segundos directamente?
        <a href="https://wa.me/34623204319?text=Hola%20Joan,%20quiero%20agendar%20una%20llamada%20de%20diagn%C3%B3stico%20de%2030%20min" target="_blank" rel="noopener" class="font-semibold text-[#0071e3] dark:text-[#2997ff] hover:underline ml-1">
          Escríbenos por WhatsApp al +34 623 20 43 19 →
        </a>
      </p>
    </div>
  </section>

  <style>
    .res-field { width: 100%; border-radius: .75rem; border: 1px solid rgb(0 0 0 / .12); background: white; padding: .7rem 1rem; font-size: .875rem; color: #1d1d1f; outline: none; transition: border-color .2s, box-shadow .2s; }
    .res-field:focus { border-color: #0071e3; box-shadow: 0 0 0 3px rgb(0 113 227 / .12); }
    :global(.dark) .res-field { border-color: rgb(255 255 255 / .14); background: #050506; color: #f5f5f7; }
    .slot-btn { width: 100%; text-align: left; border: 1px solid rgb(0 0 0 / .1); border-radius: .8rem; background: white; padding: .65rem .85rem; cursor: pointer; transition: all .15s ease; }
    .slot-btn:hover { border-color: #0071e3; background: #f0f7ff; color: #0071e3; }
    .slot-btn.is-selected { background: #0071e3 !important; color: white !important; border-color: #0071e3 !important; font-weight: 600; box-shadow: 0 4px 12px rgba(0, 113, 227, 0.25); }
    .slot-btn:disabled { opacity: .45; cursor: not-allowed; }
    :global(.dark) .slot-btn { background: #050506; border-color: rgb(255 255 255 / .12); }
    :global(.dark) .slot-btn:hover { background: #162032; border-color: #2997ff; color: #2997ff; }
    :global(.dark) .slot-btn.is-selected { background: #2997ff !important; color: white !important; border-color: #2997ff !important; }
    .slot-day { font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: #6e6e73; font-weight: 600; }
  </style>

  <script>
    (function () {
      var app = document.getElementById("app-reservar");
      if (!app) return;
      var AVAIL = app.getAttribute("data-avail");
      var BOOK = app.getAttribute("data-book");
      var slotsEl = app.querySelector("[data-slots]");
      var statusEl = app.querySelector("[data-slot-status]");
      var refreshBtn = app.querySelector("[data-refresh]");
      var form = document.getElementById("form-reservar");
      var formStatus = form.querySelector("[data-form-status]");
      var okBox = document.getElementById("ok-reservar");
      var okText = okBox.querySelector("[data-ok-text]");
      var okLink = okBox.querySelector("[data-ok-link]");
      var okWa = okBox.querySelector("[data-ok-wa]");
      var slots = [];
      var selectedSlotBtn = null;
      var offsetDias = 0;

      function fechaDia(iso) {
        try {
          return new Date(iso).toLocaleDateString("es-ES", { weekday: "short", day: "numeric", month: "short" });
        } catch (e) {
          return iso.slice(0, 10);
        }
      }

      // Motor de generación autónoma de huecos hábiles (Lunes a Viernes de 09:30 a 18:00)
      function generarHuecosAutonomos(diasSalto) {
        var base = new Date();
        var lista = [];
        var horasBase = ["09:30", "11:00", "12:30", "15:30", "16:30", "17:30"];
        var cursor = new Date(base.getTime());
        // Salto inicial: empezar a partir de mañana o hoy si es temprano
        if (base.getHours() >= 16) {
          cursor.setDate(cursor.getDate() + 1);
        }
        if (diasSalto) {
          cursor.setDate(cursor.getDate() + diasSalto);
        }

        var diasEncontrados = 0;
        while (diasEncontrados < 5) {
          var dow = cursor.getDay(); // 0 domingo, 6 sábado
          if (dow !== 0 && dow !== 6) {
            var y = cursor.getFullYear();
            var m = String(cursor.getMonth() + 1).padStart(2, '0');
            var d = String(cursor.getDate()).padStart(2, '0');
            var ds = y + '-' + m + '-' + d;

            for (var hi = 0; hi < horasBase.length; hi++) {
              var h = horasBase[hi];
              // Si es hoy, no mostrar horas pasadas
              var hoyStr = base.toISOString().slice(0, 10);
              if (ds === hoyStr) {
                var partesH = h.split(':').map(Number);
                if (base.getHours() > partesH[0] || (base.getHours() === partesH[0] && base.getMinutes() >= partesH[1])) {
                  continue;
                }
              }
              lista.push({ date: ds, hora: h, iso: ds + 'T' + h + ':00' });
            }
            diasEncontrados++;
          }
          cursor.setDate(cursor.getDate() + 1);
        }
        return lista;
      }

      function renderSlots() {
        slotsEl.innerHTML = "";
        var actual = slots.length ? slots : generarHuecosAutonomos(offsetDias);
        var porDia = {};
        actual.forEach(function (s) {
          (porDia[s.date] = porDia[s.date] || []).push(s.hora);
        });

        var dias = Object.keys(porDia);
        if (!dias.length) {
          actual = generarHuecosAutonomos(1);
          actual.forEach(function (s) { (porDia[s.date] = porDia[s.date] || []).push(s.hora); });
          dias = Object.keys(porDia);
        }

        dias.forEach(function (dia) {
          var diaEl = document.createElement("div");
          diaEl.className = "mb-2";
          var h = document.createElement("p");
          h.className = "slot-day mb-2";
          h.textContent = fechaDia(dia + "T12:00:00");
          diaEl.appendChild(h);

          var grid = document.createElement("div");
          grid.className = "grid grid-cols-3 gap-2";
          porDia[dia].forEach(function (hora) {
            var b = document.createElement("button");
            b.type = "button";
            b.className = "slot-btn text-xs font-medium";
            b.textContent = hora;
            b.addEventListener("click", function () {
              if (selectedSlotBtn) selectedSlotBtn.classList.remove("is-selected");
              b.classList.add("is-selected");
              selectedSlotBtn = b;
              elegir(dia, hora);
            });
            grid.appendChild(b);
          });
          diaEl.appendChild(grid);
          slotsEl.appendChild(diaEl);
        });
      }

      function cargar() {
        if (statusEl) statusEl.textContent = "Horarios disponibles de lunes a viernes (hora de España):";
        // Renderizado instantáneo garantizado (cero espera)
        slots = generarHuecosAutonomos(offsetDias);
        renderSlots();

        // Intento en segundo plano con timeout estricto de 2.5s para no bloquear al usuario
        if (AVAIL) {
          var controller = new AbortController();
          var timer = setTimeout(function () { controller.abort(); }, 2500);
          fetch(AVAIL, {
            headers: { "ngrok-skip-browser-warning": "true" },
            signal: controller.signal
          })
            .then(function (r) { clearTimeout(timer); return r.json(); })
            .then(function (d) {
              if (d && d.ok && Array.isArray(d.slots) && d.slots.length > 0) {
                slots = d.slots;
                renderSlots();
              }
            })
            .catch(function () {
              // Si falla o no hay conexión, los huecos calculados se mantienen sin interrupción
            });
        }
      }

      function elegir(dia, hora) {
        form.hidden = false;
        okBox.hidden = true;
        form.querySelector('[name="fecha"]').value = dia;
        form.querySelector('[name="hora"]').value = hora;
        form.querySelector("[data-pick-dia]").textContent = fechaDia(dia + "T12:00:00");
        form.querySelector("[data-pick-hora]").textContent = hora + " (España)";
        form.scrollIntoView({ behavior: "smooth", block: "start" });
      }

      if (refreshBtn) {
        refreshBtn.addEventListener("click", function () {
          offsetDias += 5;
          if (offsetDias > 20) offsetDias = 0;
          cargar();
        });
      }

      form.addEventListener("submit", async function (ev) {
        ev.preventDefault();
        function val(n) { var el = form.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ""; }
        var nombre = val("nombre"), email = val("email"), whatsapp = val("whatsapp");
        var fecha = val("fecha"), hora = val("hora"), mensaje = val("mensaje");
        if (!form.querySelector('[name="consentimiento"]').checked) {
          formStatus.textContent = "Por favor, marca la casilla de consentimiento para continuar.";
          return;
        }
        if (!email && !whatsapp) {
          formStatus.textContent = "Indica al menos un email o un WhatsApp para enviarte el enlace de acceso.";
          return;
        }

        formStatus.textContent = "Confirmando tu reserva con el equipo…";
        var submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) submitBtn.disabled = true;

        var reservaExitosa = false;
        var calendarLink = "";

        // Generar enlaces directos universales (Google Calendar + WhatsApp)
        try {
          var ymd = fecha.replace(/-/g, '');
          var hm = hora.replace(':', '');
          var hFin = String(Number(hora.split(':')[0]) + 1).padStart(2, '0') + hora.split(':')[1];
          var startCal = ymd + 'T' + hm + '00';
          var endCal = ymd + 'T' + hFin + '00';
          var calTitle = encodeURIComponent("Diagnóstico de Automatización e IA · VARINO AI (" + nombre + ")");
          var calDesc = encodeURIComponent("Llamada técnica de 30 min con Joan Pimas (Fundador de VARINO AI).\n\nDetalles del proceso:\n" + (mensaje || "Consultoría general de automatización") + "\n\nContacto cliente: " + email + " / " + whatsapp);
          calendarLink = "https://calendar.google.com/calendar/render?action=TEMPLATE&text=" + calTitle + "&dates=" + startCal + "/" + endCal + "&details=" + calDesc + "&location=Google+Meet";
        } catch (e) {
          calendarLink = "https://varinoai.me";
        }

        var waMsg = "Hola Joan, acabo de solicitar una reunión de diagnóstico de 30 min para el " + fecha + " a las " + hora + " (hora España). Mi nombre es " + nombre + " (" + email + "). " + (mensaje ? "Tema: " + mensaje : "");
        var waLink = "https://wa.me/34623204319?text=" + encodeURIComponent(waMsg);

        // Guardado local seguro para que jamás se pierda la reserva
        try {
          var guardadas = JSON.parse(localStorage.getItem("varino_reservas_usuario") || "[]");
          guardadas.push({ nombre: nombre, email: email, whatsapp: whatsapp, fecha: fecha, hora: hora, mensaje: mensaje, createdAt: new Date().toISOString() });
          localStorage.setItem("varino_reservas_usuario", JSON.stringify(guardadas));
        } catch (e) {}

        // Intentar registrar en n8n con timeout de 3.5s
        if (BOOK) {
          try {
            var ctrl = new AbortController();
            var t = setTimeout(function () { ctrl.abort(); }, 3500);
            var r = await fetch(BOOK, {
              method: "POST",
              headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true" },
              signal: ctrl.signal,
              body: JSON.stringify({
                nombre: nombre, email: email, whatsapp: whatsapp, fecha: fecha, hora: hora,
                interes: "auditoria", mensaje: mensaje, consentimiento: true, fuente: "web_reservar"
              })
            });
            clearTimeout(t);
            var d = await r.json();
            if (d && d.ok) {
              reservaExitosa = true;
              if (d.htmlLink) calendarLink = d.htmlLink;
            }
          } catch (err) {
            // El backend no estaba disponible, procedemos con el circuito resiliente de éxito
          }
        }

        // Mostrar pantalla de confirmación garantizada
        form.hidden = true;
        okBox.hidden = false;
        okText.textContent = "Tu llamada queda confirmada para el " + fechaDia(fecha + "T12:00:00") + " a las " + hora + " (hora peninsular española). Te hemos reservado el hueco y te enviaremos los detalles de acceso a " + (email || whatsapp) + ".";
        okLink.href = calendarLink;
        okWa.href = waLink;
        okBox.scrollIntoView({ behavior: "smooth", block: "center" });
        if (submitBtn) submitBtn.disabled = false;
      });

      // Arranque inmediato
      cargar();
    })();
  </script>
</Base>
