---
import Base from "../layouts/Base.astro";
import InteractiveMissions from "../components/InteractiveMissions.astro";
import { BASE, SITE } from "../config";

const cases = [
  {
    id: "clinica",
    label: "Clínica",
    title: "Solicitudes de cita bajo control",
    problem: "WhatsApp, llamadas y formularios terminan en una hoja manual sin una cola común.",
    input: "Solicitud sintética de primera cita",
    flow: ["Validar canal y contenido", "Minimizar los datos", "Clasificar la solicitud", "Detener para revisión de recepción"],
    control: "El flujo no confirma citas ni envía mensajes. Recepción decide qué hacer.",
    output: "Cola estructurada, estado y trazabilidad para cada solicitud.",
    service: "IA privada",
    price: "4.500–12.000 €+",
    file: `${BASE}/demos/clinica-intake.n8n.json`,
  },
  {
    id: "crecimiento",
    label: "Servicios profesionales",
    title: "Cada oportunidad llega preparada",
    problem: "Los contactos entran por varios canales y el seguimiento depende de recordatorios personales.",
    input: "Oportunidad sintética con necesidad y tamaño de equipo",
    flow: ["Validar la entrada", "Extraer señales permitidas", "Priorizar para revisión", "Detener antes de contactar"],
    control: "No compra bases de datos, no puntúa personas y no contacta sin aprobación.",
    output: "Bandeja priorizada y borrador de siguiente acción para el comercial.",
    service: "Sistema de crecimiento",
    price: "2.500–4.500 €",
    file: `${BASE}/demos/leads-seguimiento.n8n.json`,
  },
  {
    id: "operaciones",
    label: "Operaciones",
    title: "Una bandeja que muestra las excepciones",
    problem: "El equipo copia solicitudes entre correo y software, y los errores aparecen demasiado tarde.",
    input: "Caso sintético de actualización de pedido",
    flow: ["Validar identificador", "Clasificar el asunto", "Asignar una cola", "Detener ante el responsable"],
    control: "Cada excepción conserva una recuperación manual; no se modifica ningún sistema externo.",
    output: "Caso enrutable, observable y preparado para aprobación.",
    service: "Automation Sprint",
    price: "950–1.500 €",
    file: `${BASE}/demos/operaciones-bandeja.n8n.json`,
  },
];
---

<Base title={`Demos técnicas — ${SITE.name}`} description="Escenarios demostrativos de automatización e IA con arquitectura, controles y flujos n8n descargables.">
  <section class="mx-auto max-w-6xl px-6 pb-20 pt-28 sm:pt-36">
    <p class="eyebrow">Laboratorio VARINO</p>
    <h1 class="display-title mt-5 max-w-5xl">No te pedimos que imagines el sistema.<br /><span>Te enseñamos cómo se comporta.</span></h1>
    <p class="mt-7 max-w-3xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Estos casos usan datos sintéticos y no representan resultados de clientes. Cada flujo se entrega inactivo, sin credenciales y con una parada humana obligatoria.</p>
  </section>

  <section class="mx-auto max-w-6xl space-y-8 px-6 pb-28">
    {cases.map((item, index) => (
      <article id={item.id} class="overflow-hidden rounded-[2rem] border border-black/8 bg-[#f7f7f5] dark:border-white/10 dark:bg-[#111318]">
        <div class="grid gap-0 lg:grid-cols-[.78fr_1.22fr]">
          <div class="p-7 sm:p-10">
            <p class="text-xs font-bold text-[#0071e3]">0{index + 1} · {item.label}</p>
            <h2 class="mt-5 text-3xl font-semibold tracking-[-0.045em] sm:text-4xl">{item.title}</h2>
            <p class="mt-5 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{item.problem}</p>
            <dl class="mt-8 space-y-5 text-sm">
              <div><dt class="text-xs text-[#6e6e73]">Entrada de la demo</dt><dd class="mt-1 font-medium">{item.input}</dd></div>
              <div><dt class="text-xs text-[#6e6e73]">Control no negociable</dt><dd class="mt-1 font-medium">{item.control}</dd></div>
              <div><dt class="text-xs text-[#6e6e73]">Salida observable</dt><dd class="mt-1 font-medium">{item.output}</dd></div>
            </dl>
          </div>
          <div class="bg-[#0b0d12] p-7 text-white sm:p-10">
            <div class="flex items-center justify-between gap-4 text-[.62rem] font-bold tracking-[.14em] text-[#a1a1a6]"><span>FLUJO IMPORTABLE</span><span>INACTIVO · SIN CREDENCIALES</span></div>
            <ol class="mt-8 grid gap-3 sm:grid-cols-2">
              {item.flow.map((step, stepIndex) => <li class="rounded-2xl border border-white/10 bg-white/5 p-4"><span class="text-[.62rem] text-[#9b95ff]">0{stepIndex + 1}</span><strong class="mt-2 block text-sm">{step}</strong></li>)}
            </ol>
            <div class="mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-end sm:justify-between">
              <div><span class="text-xs text-[#a1a1a6]">Encaje orientativo</span><strong class="mt-1 block">{item.service} · {item.price}</strong></div>
              <a href={item.file} download class="inline-flex rounded-full bg-white px-5 py-2.5 text-xs font-semibold text-black transition hover:bg-[#e8e8ed]">Descargar flujo n8n</a>
            </div>
          </div>
        </div>
      </article>
    ))}
  </section>

  <section class="border-y border-black/6 bg-[#f7f7f5] py-24 dark:border-white/10 dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6"><div class="section-heading"><div><p class="eyebrow">Tu proceso</p><h2>La mejor demo empieza con una situación real.</h2></div><p>Describe el proceso sin identificar a personas ni incluir información confidencial. La guía construirá una primera arquitectura y una estimación.</p></div></div>
    <InteractiveMissions compact />
  </section>
</Base>
