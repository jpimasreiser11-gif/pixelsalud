---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import Base from "../layouts/Base.astro";
import DemoRunthrough from "../components/DemoRunthrough.astro";
import { BASE, SERVICES } from "../config";
import { describePublicDemo, type PublicDemoKey } from "../lib/public-demo-catalog";

const servicePrice = (id: string) => SERVICES.find((service) => service.id === id)?.range ?? "Consultar alcance";

const cases = [
  {
    id: "clinica",
    label: "Clínica",
    title: "Solicitudes de cita bajo control",
    problem: "WhatsApp, llamadas y formularios terminan en una hoja manual sin una cola común.",
    control: "El flujo no confirma citas ni envía mensajes. Recepción decide qué hacer.",
    output: "Solicitud clasificada · pendiente de revisión de recepción",
    service: "IA privada",
    serviceHref: `${BASE}/servicios/ia-privada/`,
    price: servicePrice("private-ai"),
    file: `${BASE}/demos/clinica-intake.n8n.json`,
    filename: "clinica-intake.n8n.json",
  },
  {
    id: "crecimiento",
    label: "Servicios profesionales",
    title: "Cada oportunidad llega preparada",
    problem: "Los contactos entran por varios canales y el seguimiento depende de recordatorios personales.",
    control: "No compra bases de datos, no puntúa personas y no contacta sin aprobación.",
    output: "Prioridad propuesta · pendiente de revisión comercial",
    service: "Sistema de crecimiento",
    serviceHref: `${BASE}/servicios/sistema-crecimiento/`,
    price: servicePrice("growth-system"),
    file: `${BASE}/demos/leads-seguimiento.n8n.json`,
    filename: "leads-seguimiento.n8n.json",
  },
  {
    id: "operaciones",
    label: "Operaciones",
    title: "Una bandeja que muestra las excepciones",
    problem: "El equipo copia solicitudes entre correo y software, y los errores aparecen demasiado tarde.",
    control: "Cada excepción conserva una recuperación manual; no se modifica ningún sistema externo.",
    output: "Caso enrutado · pendiente del responsable del proceso",
    service: "Automation Sprint",
    serviceHref: `${BASE}/servicios/automation-sprint/`,
    price: servicePrice("automation-sprint"),
    file: `${BASE}/demos/operaciones-bandeja.n8n.json`,
    filename: "operaciones-bandeja.n8n.json",
  },
].map((item) => ({
  ...item,
  ...describePublicDemo(JSON.parse(readFileSync(resolve(process.cwd(), "public/demos", item.filename), "utf8")), item.id as PublicDemoKey),
}));
---

<Base title="Demos técnicas" description="Escenarios demostrativos de automatización e IA con arquitectura, controles y flujos n8n descargables.">
  <section class="mx-auto max-w-6xl px-6 pb-20 pt-28 sm:pt-36">
    <p class="eyebrow">Laboratorio VARINO</p>
    <h1 class="display-title mt-5 max-w-5xl">No te pedimos que imagines el sistema.<br /><span>Te enseñamos cómo se comporta.</span></h1>
    <p class="mt-7 max-w-3xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">Una solicitud, una oportunidad o un pedido. Explora cómo se ordena el trabajo y dónde interviene tu equipo. Son ejemplos con datos ficticios y reglas, no resultados de clientes ni ejecuciones de IA.</p>
    <nav aria-label="Elegir un ejemplo" class="mt-8 flex flex-wrap gap-3">
      {cases.map((item) => <a class="button-secondary" href={`#${item.id}`}>{item.label} <span aria-hidden="true">↓</span></a>)}
    </nav>
  </section>

  <section class="mx-auto max-w-6xl space-y-8 px-6 pb-28">
    {cases.map((item) => <DemoRunthrough {...item} />)}
  </section>

  <section class="border-y border-black/6 bg-[#f7f7f5] py-24 dark:border-white/10 dark:bg-[#0a0d14]">
    <div class="mx-auto max-w-6xl px-6"><div class="section-heading"><div><p class="eyebrow">Tu proceso</p><h2>La mejor demo empieza con una situación real.</h2></div><p>Describe el proceso sin identificar a personas ni incluir información confidencial. Usa la <a class="font-semibold text-[#0071e3]" href={`${BASE}/#guia-varino`}>guía interactiva</a> para ordenar el alcance y reserva una llamada si quieres revisarlo con el equipo.</p></div></div>
  </section>
</Base>
