---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { SITE } from "../config";

const scenarios = [
  {
    number: "01",
    sector: "Asesorías y servicios profesionales",
    title: "Clasificar documentación sin perder la revisión humana",
    flow: ["Llega un documento", "Se extraen campos", "Una persona valida", "Se archiva y avisa"],
    detail: "Un flujo podría ordenar entradas y preparar una ficha para revisión. La conexión con correo, gestor documental y software contable se define tras comprobar sus permisos y API.",
    boundary: "No contabiliza, presenta impuestos ni envía documentos por su cuenta.",
  },
  {
    number: "02",
    sector: "Equipos comerciales pequeños",
    title: "Dar continuidad a una solicitud entrante",
    flow: ["Llega una consulta", "Se comprueba duplicado", "Se registra en el CRM", "El equipo decide el siguiente paso"],
    detail: "La automatización puede estructurar una petición que la propia persona envía y avisar al responsable. Las comunicaciones promocionales requieren un permiso separado y comprobable.",
    boundary: "No compra listas ni inicia campañas de correo a contactos que no las hayan solicitado.",
  },
  {
    number: "03",
    sector: "Operaciones internas",
    title: "Encontrar respuestas en documentación aprobada",
    flow: ["Se consulta una guía interna", "El asistente busca referencias", "Muestra la fuente", "Deriva dudas a una persona"],
    detail: "Una solución privada puede recuperar procedimientos y preparar una respuesta con referencias. El alojamiento, los accesos y el modelo se seleccionan según el tipo de dato y el equipo disponible.",
    boundary: "No se promete que los datos permanezcan en local hasta validar y probar toda la arquitectura concreta.",
  },
];
---

<Base
  title={`Ejemplos de automatización — ${SITE.name}`}
  description="Escenarios ilustrativos de automatización con n8n e IA, sus límites y los puntos que revisa una persona antes de actuar."
>
  <section class="mx-auto max-w-6xl px-6 pb-12 pt-28 sm:pt-36">
    <p class="eyebrow">Escenarios ilustrativos · datos sintéticos</p>
    <h1 class="display-title mt-4 max-w-4xl">Ideas para mejorar un proceso real.</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">
      Estos ejemplos muestran cómo se podría diseñar un flujo. No son proyectos de clientes, resultados obtenidos ni estimaciones de ahorro. El alcance y la viabilidad se validan con cada empresa antes de construir.
    </p>
  </section>

  <section class="mx-auto max-w-6xl space-y-6 px-6 pb-20" aria-label="Escenarios de automatización">
    {scenarios.map((scenario) => (
      <article class="rounded-3xl border border-black/8 bg-white p-6 dark:border-white/10 dark:bg-[#111318] sm:p-9">
        <div class="flex flex-wrap items-center gap-3">
          <span class="text-sm font-semibold text-[#0071e3]">{scenario.number}</span>
          <span class="eyebrow">{scenario.sector}</span>
        </div>
        <h2 class="mt-4 text-2xl font-semibold tracking-tight text-[#1d1d1f] dark:text-white sm:text-3xl">{scenario.title}</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">{scenario.detail}</p>
        <ol class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" aria-label="Pasos ilustrativos">
          {scenario.flow.map((step, index) => (
            <li class="rounded-2xl bg-[#f5f5f7] p-4 text-sm dark:bg-[#1d1d1f]">
              <span class="mb-2 block text-xs text-[#86868b]">Paso {index + 1}</span>
              <span class="font-medium text-[#1d1d1f] dark:text-white">{step}</span>
            </li>
          ))}
        </ol>
        <p class="mt-5 border-l-2 border-[#0071e3] pl-4 text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">
          <strong class="text-[#1d1d1f] dark:text-white">Límite del ejemplo:</strong> {scenario.boundary}
        </p>
      </article>
    ))}
    <div class="rounded-3xl border border-black/8 bg-[#f5f5f7] p-6 dark:border-white/10 dark:bg-[#111318] sm:p-8">
      <h2 class="text-xl font-semibold text-[#1d1d1f] dark:text-white">¿Quieres verlo con tu proceso?</h2>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-[#6e6e73] dark:text-[#a1a1a6]">Cuéntanos qué tarea se repite y qué herramientas usáis. Primero comprobaremos viabilidad, riesgos y coste; después podrás decidir si seguimos.</p>
      <a href="/contacto/" class="mt-5 inline-flex rounded-full bg-[#0071e3] px-5 py-3 text-sm font-semibold text-white hover:bg-[#0077ed]">Describir mi proceso</a>
    </div>
  </section>
  <Cta titulo="Empieza por el cuello de botella" texto="Una conversación breve para delimitar el proceso y decidir si automatizarlo tiene sentido." />
</Base>
