---
import Base from "../layouts/Base.astro";
import { SITE } from "../config";
---

<Base
  title={`Método — ${SITE.name}`}
  description="Diagnóstico, diseño, construcción, revisión y mejora con alcance y aprobaciones definidos."
>
  <section class="mx-auto max-w-5xl px-6 py-24 sm:py-32">
    <p class="eyebrow">Método VARINO</p>
    <h1 class="display-title max-w-4xl">Del proceso<br /><span>al progreso.</span></h1>
    <p class="mt-8 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">
      Diagnosticamos, diseñamos, construimos, revisamos y mejoramos. Cada etapa termina
      con evidencia y una decisión humana antes de ampliar el alcance.
    </p>
  </section>
</Base>
