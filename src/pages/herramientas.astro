---
import Base from "../layouts/Base.astro";
import InteractiveMissions from "../components/InteractiveMissions.astro";
import { SITE } from "../config";
---
<Base title={`Herramientas interactivas — ${SITE.name}`} description="Una guía conversacional para visualizar automatización e IA sin resultados inventados."><section class="mx-auto max-w-6xl px-6 py-24"><p class="eyebrow">Herramientas</p><h1 class="display-title max-w-5xl">Explorar antes<br /><span>de decidir.</span></h1><p class="mt-7 max-w-2xl text-lg leading-8 text-[#6e6e73] dark:text-[#a1a1a6]">No ofrecemos una calculadora de ahorro universal: cada proceso tiene excepciones, calidad y costes distintos. Describe el tuyo con lenguaje natural y observa cómo se transforma en una arquitectura visual.</p></section><InteractiveMissions /></Base>
