---
import { BASE, SERVICIOS, SITE, hasContactChannel } from "../config";

const assistantKnowledge = JSON.stringify({
  brand: SITE.name,
  contactReady: hasContactChannel,
  contactUrl: `${BASE}/contacto/`,
  services: SERVICIOS.map(({ nombre, subtitulo, descripcion, entregables, ejemplos, precio }) => ({
    nombre,
    subtitulo,
    descripcion,
    entregables,
    ejemplos,
    precio,
  })),
});
---

<div id="systra-copilot" class="fixed bottom-5 right-5 z-50 sm:bottom-7 sm:right-7">
  <button
    id="copilot-toggle"
    type="button"
    aria-haspopup="dialog"
    aria-controls="copilot-window"
    aria-expanded="false"
    class="flex min-h-11 items-center gap-2 rounded-full border border-white/20 bg-[#0071e3] px-4 py-2.5 text-xs font-semibold text-white shadow-xl shadow-[#0071e3]/25 transition hover:-translate-y-0.5 hover:bg-[#0077ed]"
  >
    <svg aria-hidden="true" class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
    </svg>
    Pregunta a VARINO
  </button>

  <section
    id="copilot-window"
    role="dialog"
    aria-modal="false"
    aria-labelledby="copilot-title"
    class="absolute bottom-14 right-0 hidden h-[min(560px,calc(100vh-7rem))] w-[min(390px,calc(100vw-2.5rem))] flex-col overflow-hidden rounded-[1.75rem] border border-black/10 bg-white/96 text-[#1d1d1f] shadow-2xl backdrop-blur-2xl dark:border-white/12 dark:bg-[#161617]/96 dark:text-[#f5f5f7]"
  >
    <header class="flex items-center justify-between border-b border-black/6 px-5 py-4 dark:border-white/10">
      <div>
        <h2 id="copilot-title" class="text-sm font-semibold">Asistente VARINO</h2>
        <p class="mt-0.5 text-[11px] text-[#6e6e73] dark:text-[#a1a1a6]">Información sobre servicios y método</p>
      </div>
      <button
        id="copilot-close"
        type="button"
        aria-label="Cerrar asistente"
        class="flex size-10 items-center justify-center rounded-full text-[#6e6e73] transition hover:bg-black/5 hover:text-[#1d1d1f] dark:hover:bg-white/10 dark:hover:text-white"
      >
        <span aria-hidden="true">✕</span>
      </button>
    </header>

    <div id="copilot-messages" aria-live="polite" aria-relevant="additions" class="flex flex-1 flex-col gap-3 overflow-y-auto p-4 text-xs leading-relaxed">
      <p class="max-w-[90%] rounded-2xl rounded-tl-sm bg-[#f5f5f7] p-3.5 dark:bg-[#1d1d1f]">
        Hola. Puedo explicarte los servicios, el método, los precios o ayudarte a elegir un primer caso de uso.
      </p>
    </div>

    <div class="flex gap-2 overflow-x-auto border-t border-black/6 px-4 py-2.5 dark:border-white/10">
      <button type="button" class="quick-ask min-h-9 whitespace-nowrap rounded-full bg-[#f5f5f7] px-3 text-[11px] text-[#0071e3] dark:bg-[#1d1d1f] dark:text-[#2997ff]">
        ¿Por dónde empiezo?
      </button>
      <button type="button" class="quick-ask min-h-9 whitespace-nowrap rounded-full bg-[#f5f5f7] px-3 text-[11px] text-[#0071e3] dark:bg-[#1d1d1f] dark:text-[#2997ff]">
        ¿Qué servicios ofrecéis?
      </button>
      <button type="button" class="quick-ask min-h-9 whitespace-nowrap rounded-full bg-[#f5f5f7] px-3 text-[11px] text-[#0071e3] dark:bg-[#1d1d1f] dark:text-[#2997ff]">
        ¿Cómo tratáis mis datos?
      </button>
    </div>

    <form id="copilot-form" class="flex gap-2 border-t border-black/6 p-3 dark:border-white/10">
      <label for="copilot-input" class="sr-only">Pregunta para el asistente</label>
      <input
        id="copilot-input"
        type="text"
        inputmode="text"
        autocomplete="off"
        maxlength="500"
        placeholder="Escribe tu pregunta"
        class="min-w-0 flex-1 rounded-xl border border-black/10 bg-[#f5f5f7] px-3.5 py-2.5 text-xs outline-none focus:border-[#0071e3] dark:border-white/10 dark:bg-[#1d1d1f]"
        required
      />
      <button type="submit" class="min-h-11 rounded-xl bg-[#0071e3] px-4 text-xs font-semibold text-white hover:bg-[#0077ed]">
        Enviar
      </button>
    </form>
  </section>
</div>

<script id="systra-knowledge" type="application/json" set:html={assistantKnowledge}></script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const root = document.getElementById("systra-copilot");
    const toggle = document.getElementById("copilot-toggle");
    const close = document.getElementById("copilot-close");
    const panel = document.getElementById("copilot-window");
    const form = document.getElementById("copilot-form");
    const input = document.getElementById("copilot-input");
    const messages = document.getElementById("copilot-messages");
    const knowledgeNode = document.getElementById("systra-knowledge");
    if (!root || !toggle || !close || !panel || !form || !input || !messages || !knowledgeNode) return;

    const knowledge = JSON.parse(knowledgeNode.textContent || "{}");
    const quickButtons = root.querySelectorAll(".quick-ask");

    function setOpen(open) {
      panel.classList.toggle("hidden", !open);
      panel.classList.toggle("flex", open);
      toggle.setAttribute("aria-expanded", String(open));
      if (open) input.focus();
      else toggle.focus();
    }

    function addMessage(text, fromUser = false) {
      const message = document.createElement("p");
      message.className = fromUser
        ? "ml-auto max-w-[86%] rounded-2xl rounded-tr-sm bg-[#0071e3] p-3 text-white"
        : "max-w-[90%] rounded-2xl rounded-tl-sm bg-[#f5f5f7] p-3.5 dark:bg-[#1d1d1f]";
      message.textContent = text;
      messages.appendChild(message);
      messages.scrollTop = messages.scrollHeight;
    }

    function serviceSummary() {
      return knowledge.services
        .map((service) => `${service.nombre}: ${service.subtitulo}`)
        .join("\n");
    }

    function answer(rawQuestion) {
      const question = rawQuestion.toLocaleLowerCase("es");
      const service = knowledge.services.find((item) => {
        const terms = [item.nombre, ...item.ejemplos].join(" ").toLocaleLowerCase("es");
        return terms.split(/\s+/).some((term) => term.length > 5 && question.includes(term));
      });

      if (service) {
        return `${service.nombre}. ${service.descripcion}\n\nIncluye: ${service.entregables.join("; ")}.\n\nPrecio: ${service.precio}; se concreta después de definir el alcance.`;
      }
      if (/servicio|ofrec|hacéis|hacen|solucion/.test(question)) {
        return `Trabajamos en tres áreas:\n${serviceSummary()}\n\nSi me cuentas el proceso que quieres mejorar, te indico cuál encaja mejor.`;
      }
      if (/precio|coste|cuesta|tarifa|presupuesto/.test(question)) {
        return "No publicamos una cifra universal porque una integración simple y un producto con permisos o datos sensibles no tienen el mismo alcance. Primero definimos entregables, dependencias y criterios de aceptación; después presentamos un presupuesto por escrito.";
      }
      if (/privacidad|dato|seguridad|rgpd|confiden/.test(question)) {
        return "La arquitectura de seguridad se define según los datos y proveedores del proyecto. Priorizamos mínimo acceso, separación de entornos, registro de actividad, retención limitada y revisión humana. No afirmamos cumplimiento o cifrado concreto hasta haber definido y verificado la solución.";
      }
      if (/tiempo|plazo|tarda|semana|día/.test(question)) {
        return "El plazo depende del alcance y de las integraciones. Proponemos empezar por un piloto pequeño y fijar el calendario cuando conocemos accesos, datos, excepciones y responsables.";
      }
      if (/empez|primer|idea|caso|recomienda/.test(question)) {
        return "Empieza por una tarea frecuente, repetitiva y fácil de medir. Buenos candidatos: clasificar solicitudes, preparar documentos, buscar información interna o actualizar el CRM. Evitaría empezar por una decisión crítica sin supervisión.";
      }
      if (/contact|reunión|reunion|hablar|llamada/.test(question)) {
        return knowledge.contactReady
          ? "Puedes usar la página de contacto para plantear tu caso. Allí encontrarás el canal disponible."
          : "La página de contacto está preparada, pero el canal definitivo aún debe configurarse antes de publicar.";
      }
      if (/hola|buenas|quién|quien eres/.test(question)) {
        return "Soy el asistente informativo de VARINO. Puedo orientarte sobre servicios, método, seguridad, precios y primeros casos de uso.";
      }
      return "Puedo ayudarte mejor si me cuentas qué tarea quieres mejorar, quién la realiza, con qué herramientas y qué resultado considerarías útil. También puedes preguntarme por servicios, método, precios o seguridad.";
    }

    toggle.addEventListener("click", () => setOpen(panel.classList.contains("hidden")));
    close.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.classList.contains("hidden")) setOpen(false);
    });

    quickButtons.forEach((button) => {
      button.addEventListener("click", () => {
        input.value = button.textContent?.trim() || "";
        form.requestSubmit();
      });
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const question = input.value.trim().slice(0, 500);
      if (!question) return;
      addMessage(question, true);
      input.value = "";
      window.setTimeout(() => addMessage(answer(question)), 180);
    });
  });
</script>
