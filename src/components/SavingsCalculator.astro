---
import { BASE, SERVICES, whatsappUrl } from "../config";

const sprint = SERVICES.find((service) => service.id === "automation-sprint");
const wa = whatsappUrl("Hola, me gustaría revisar el coste de un proceso manual y valorar una automatización.");
const examples = [
  { id: "legal", title: "Servicios jurídicos", example: "Ejemplo hipotético: extraer campos de solicitudes y preparar borradores para revisión del equipo." },
  { id: "salud", title: "Administración sanitaria", example: "Ejemplo hipotético: organizar solicitudes administrativas sin procesar datos clínicos." },
  { id: "comercio", title: "Comercio", example: "Ejemplo hipotético: centralizar consultas y preparar respuestas para aprobación." },
  { id: "inmobiliario", title: "Inmobiliario", example: "Ejemplo hipotético: clasificar consultas y preparar una lista de seguimiento para revisión." },
  { id: "operaciones", title: "Operaciones", example: "Ejemplo hipotético: validar campos y separar excepciones antes de registrar una solicitud." },
];
---

<section id="calculadora-ahorro" class="mx-auto max-w-6xl px-6 py-20 sm:py-28" data-reveal>
  <div class="rounded-3xl border border-black/8 bg-white p-7 shadow-xl dark:border-white/10 dark:bg-[#111318] sm:p-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow">Explorador de procesos</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-[-0.04em] text-[#1d1d1f] dark:text-[#f5f5f7] sm:text-4xl">
          Ponle números al trabajo manual.
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-[#5b5b60] dark:text-[#c4c4cc]">
          Introduce tus propios supuestos para explorar cuánto cuesta hoy una tarea repetitiva. El escenario no predice ahorro, ROI ni plazo de implantación: eso requiere medir y diseñar el proceso real.
        </p>
      </div>
      <span class="calc-badge">Simulación editable</span>
    </div>

    <div class="mt-10">
      <p class="mb-3 text-xs font-bold uppercase tracking-wider text-[#5b5b60] dark:text-[#c4c4cc]">Elige un tipo de proceso para ver un ejemplo hipotético</p>
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-5" id="calc-sector-tabs" aria-label="Ejemplos de proceso">
        {examples.map((item, index) => (
          <button type="button" class:list={["calc-tab", { "is-active": index === 0 }]} data-example={item.id} data-copy={item.example} aria-pressed={String(index === 0)}>
            {item.title}
          </button>
        ))}
      </div>
      <p class="mt-3 rounded-xl border border-[#005bb5]/20 bg-[#f1f6fc] p-4 text-sm leading-6 text-[#004b96] dark:border-[#2997ff]/30 dark:bg-[#111c2b] dark:text-[#b8d8ff]" id="calc-example" aria-live="polite">
        {examples[0].example} Es una idea ilustrativa, no un caso de cliente ni una promesa de resultado.
      </p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-start">
      <div class="space-y-5 lg:col-span-6">
        <div class="calc-input-card">
          <div class="flex items-center justify-between gap-4">
            <label for="range-horas-calc">Horas manuales por semana</label>
            <output id="val-horas-calc" for="range-horas-calc">16 h</output>
          </div>
          <p>Usa una media observada o una estimación propia. No incluyas tareas que no quieras evaluar.</p>
          <input id="range-horas-calc" type="range" min="1" max="60" step="1" value="16" aria-label="Horas manuales por semana" />
          <div class="calc-range-labels"><span>1 h</span><span>30 h</span><span>60 h</span></div>
        </div>

        <div class="calc-input-card">
          <div class="flex items-center justify-between gap-4">
            <label for="range-coste-calc">Coste laboral estimado por hora</label>
            <output id="val-coste-calc" for="range-coste-calc">32 €/h</output>
          </div>
          <p>El valor lo decides tú; puede no coincidir con el coste real de tu organización.</p>
          <input id="range-coste-calc" type="range" min="10" max="150" step="1" value="32" aria-label="Coste laboral estimado por hora" />
          <div class="calc-range-labels"><span>10 €/h</span><span>80 €/h</span><span>150 €/h</span></div>
        </div>

        <div class="calc-input-card">
          <div class="flex items-center justify-between gap-4">
            <label for="range-semanas-calc">Semanas de trabajo al año</label>
            <output id="val-semanas-calc" for="range-semanas-calc">46 semanas</output>
          </div>
          <p>Ajusta vacaciones, estacionalidad y semanas en las que la tarea no se realiza.</p>
          <input id="range-semanas-calc" type="range" min="1" max="52" step="1" value="46" aria-label="Semanas de trabajo al año" />
          <div class="calc-range-labels"><span>1</span><span>26</span><span>52</span></div>
        </div>

        <div class="calc-input-card">
          <div class="flex items-center justify-between gap-4">
            <label for="range-potencial-calc">Hipótesis de tiempo automatizable</label>
            <output id="val-potencial-calc" for="range-potencial-calc">25 %</output>
          </div>
          <p>Solo una hipótesis de trabajo que tú puedes cambiar. No es una tasa observada ni un ahorro garantizado.</p>
          <input id="range-potencial-calc" type="range" min="0" max="80" step="5" value="25" aria-label="Hipótesis de tiempo automatizable" />
          <div class="calc-range-labels"><span>0 %</span><span>40 %</span><span>80 %</span></div>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div class="calc-results">
          <div class="flex items-center justify-between gap-4 border-b border-white/15 pb-4">
            <h3 class="text-sm font-semibold">Tu escenario anual</h3>
            <span class="calc-results__tag">No es un presupuesto</span>
          </div>
          <div class="mt-5 grid grid-cols-2 gap-3">
            <div class="calc-result-card">
              <span>Horas manuales estimadas</span>
              <strong id="calc-res-horas">736 h</strong>
              <small>horas/semana × semanas/año</small>
            </div>
            <div class="calc-result-card">
              <span>Coste anual de referencia</span>
              <strong id="calc-res-coste">23.552 €</strong>
              <small>no equivale a ahorro potencial</small>
            </div>
            <div class="calc-result-card calc-result-card--wide">
              <span>Valor bruto del tiempo en tu hipótesis</span>
              <strong id="calc-res-potencial">5.888 €</strong>
              <small id="calc-res-explicacion">25 % hipotético · antes de costes, excepciones y validación</small>
            </div>
          </div>
          <p class="calc-disclaimer">
            El cálculo multiplica tus entradas; no aplica datos de clientes ni tasas sectoriales. El tiempo potencial requiere comprobación con una línea base, revisión humana y análisis de costes de implantación, licencias y mantenimiento.
          </p>
          <div class="mt-6 rounded-2xl border border-white/15 bg-white/5 p-4">
            <p class="text-xs font-semibold text-white">Referencia pública de servicio</p>
            <p class="mt-1 text-sm leading-6 text-[#d0d0d6]">
              Automation Sprint: {sprint?.range} orientativos para un alcance acotado. El precio final depende del proceso, integraciones, excepciones y requisitos acordados.
            </p>
            <a href={`${BASE}/precios/`} class="calc-link">Ver precios y condiciones →</a>
          </div>
          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a href={`${BASE}/contacto/`} class="calc-primary">Revisar mi proceso con el equipo</a>
            {wa && <a href={wa} class="calc-secondary">WhatsApp</a>}
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .calc-badge { display: inline-flex; width: fit-content; align-items: center; border: 1px solid #b9d1eb; border-radius: 999px; background: #f1f6fc; padding: .4rem .75rem; color: #004b96; font-size: .7rem; font-weight: 700; }
    :global(.dark) .calc-badge { border-color: #344d69; background: #111c2b; color: #b8d8ff; }
    .calc-tab { min-height: 2.75rem; border: 1px solid #d4d4d8; border-radius: 1rem; background: #f7f7f5; padding: .65rem .75rem; color: #4b4b50; font-size: .72rem; font-weight: 650; cursor: pointer; transition: background-color .15s ease, border-color .15s ease, color .15s ease; }
    .calc-tab:hover { border-color: #005bb5; color: #004b96; }
    .calc-tab.is-active { border-color: #005bb5; background: #005bb5; color: #fff; }
    .calc-tab:focus-visible, .calc-input-card input:focus-visible, .calc-primary:focus-visible, .calc-secondary:focus-visible, .calc-link:focus-visible { outline: 3px solid #7bb6f0; outline-offset: 3px; }
    :global(.dark) .calc-tab { border-color: #555863; background: #16181f; color: #e0e0e4; }
    :global(.dark) .calc-tab.is-active { border-color: #2997ff; background: #174b7d; color: #fff; }
    .calc-input-card { border: 1px solid #d8d8dc; border-radius: 1rem; background: #f7f7f5; padding: 1.15rem; }
    .calc-input-card label { color: #27272b; font-size: .85rem; font-weight: 700; }
    .calc-input-card output { border-radius: .6rem; background: #e6f0fc; padding: .35rem .55rem; color: #004b96; font-size: .85rem; font-weight: 750; white-space: nowrap; }
    .calc-input-card p { margin-top: .55rem; color: #505056; font-size: .72rem; line-height: 1.5; }
    .calc-input-card input { display: block; width: 100%; margin-top: 1rem; accent-color: #005bb5; }
    .calc-range-labels { display: flex; justify-content: space-between; margin-top: .35rem; color: #505056; font-size: .68rem; }
    :global(.dark) .calc-input-card { border-color: #3b3e47; background: #16181f; }
    :global(.dark) .calc-input-card label { color: #f5f5f7; }
    :global(.dark) .calc-input-card output { background: #17263a; color: #b8d8ff; }
    :global(.dark) .calc-input-card p, :global(.dark) .calc-range-labels { color: #c4c4cc; }
    .calc-results { border-radius: 1.7rem; background: linear-gradient(145deg, #17181d, #242631); padding: 1.5rem; color: #fff; }
    .calc-results__tag { border-radius: 999px; background: #343640; padding: .35rem .55rem; color: #e0e0e4; font-size: .62rem; font-weight: 700; }
    .calc-result-card { min-width: 0; border: 1px solid #484a53; border-radius: 1rem; background: #2a2c35; padding: .85rem; }
    .calc-result-card--wide { grid-column: 1 / -1; border-color: #54769b; background: #202c3b; }
    .calc-result-card span, .calc-result-card small { display: block; color: #e0e0e4; font-size: .67rem; line-height: 1.45; }
    .calc-result-card strong { display: block; margin-top: .45rem; color: #fff; font-size: clamp(1.4rem, 4vw, 2rem); font-weight: 750; line-height: 1.1; overflow-wrap: anywhere; }
    .calc-result-card--wide strong { color: #b8d8ff; }
    .calc-result-card small { margin-top: .4rem; color: #c4c4cc; font-size: .62rem; }
    .calc-disclaimer { margin-top: 1rem; color: #e0e0e4; font-size: .72rem; line-height: 1.6; }
    .calc-link { display: inline-block; margin-top: .55rem; color: #b8d8ff; font-size: .75rem; font-weight: 750; text-decoration: underline; text-underline-offset: .2em; }
    .calc-primary, .calc-secondary { display: inline-flex; flex: 1; align-items: center; justify-content: center; min-height: 2.9rem; border-radius: 999px; padding: .7rem 1rem; text-align: center; font-size: .78rem; font-weight: 750; }
    .calc-primary { background: #005bb5; color: #fff; }
    .calc-primary:hover { background: #004b96; }
    .calc-secondary { border: 1px solid #777b86; background: #343640; color: #fff; }
    .calc-secondary:hover { background: #434650; }
    @media (prefers-reduced-motion: reduce) { .calc-tab { transition: none; } }
  </style>

  <script>
    (function () {
      var hours = document.getElementById("range-horas-calc");
      var rate = document.getElementById("range-coste-calc");
      var weeks = document.getElementById("range-semanas-calc");
      var assumption = document.getElementById("range-potencial-calc");
      var tabs = document.querySelectorAll("#calc-sector-tabs .calc-tab");
      if (!hours || !rate || !weeks || !assumption) return;
      var fmt = new Intl.NumberFormat("es-ES", { maximumFractionDigits: 0 });
      var money = new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
      var outputs = {
        hours: document.getElementById("val-horas-calc"),
        rate: document.getElementById("val-coste-calc"),
        weeks: document.getElementById("val-semanas-calc"),
        assumption: document.getElementById("val-potencial-calc"),
        annualHours: document.getElementById("calc-res-horas"),
        annualCost: document.getElementById("calc-res-coste"),
        potential: document.getElementById("calc-res-potencial"),
        explanation: document.getElementById("calc-res-explicacion"),
        example: document.getElementById("calc-example"),
      };
      function calculate() {
        var h = Number(hours.value);
        var r = Number(rate.value);
        var w = Number(weeks.value);
        var pct = Number(assumption.value);
        var annualHours = h * w;
        var annualCost = annualHours * r;
        var scenarioHours = annualHours * pct / 100;
        if (outputs.hours) outputs.hours.textContent = `${fmt.format(h)} h`;
        if (outputs.rate) outputs.rate.textContent = `${money.format(r)}/h`;
        if (outputs.weeks) outputs.weeks.textContent = `${fmt.format(w)} semanas`;
        if (outputs.assumption) outputs.assumption.textContent = `${fmt.format(pct)} %`;
        if (outputs.annualHours) outputs.annualHours.textContent = `${fmt.format(annualHours)} h`;
        if (outputs.annualCost) outputs.annualCost.textContent = money.format(annualCost);
        if (outputs.potential) outputs.potential.textContent = money.format(scenarioHours * r);
        if (outputs.explanation) outputs.explanation.textContent = `${fmt.format(pct)} % hipotético · ${fmt.format(scenarioHours)} h antes de costes y validación`;
      }
      tabs.forEach(function (tab) {
        tab.addEventListener("click", function () {
          tabs.forEach(function (item) { item.classList.remove("is-active"); item.setAttribute("aria-pressed", "false"); });
          tab.classList.add("is-active");
          tab.setAttribute("aria-pressed", "true");
          if (outputs.example) outputs.example.textContent = `${tab.getAttribute("data-copy")} Es una idea ilustrativa, no un caso de cliente ni una promesa de resultado.`;
        });
      });
      [hours, rate, weeks, assumption].forEach(function (input) { input.addEventListener("input", calculate); });
      calculate();
    })();
  </script>
</section>
