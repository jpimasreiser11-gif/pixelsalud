---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
import { BASE } from "../config";
// En desarrollo existe /api/guide, que intenta usar Ollama. En la web
// publicada solo se ejecuta el motor de reglas en el navegador.
const hasLocalGuideApi = import.meta.env.DEV;
---

<section class:list={["ai-guide", { "ai-guide--compact": compact }]} data-ai-guide data-base={BASE} data-local-guide-api={String(hasLocalGuideApi)}>
  <div class="ai-guide__heading">
    <div>
      <p class="eyebrow">Definición guiada</p>
      <h2>De una tarea repetitiva a un sistema claro.</h2>
    </div>
    <p class="ai-guide__promise"><span><i></i>Guía de proyecto · orientación inicial</span>Cuéntanos cómo trabajáis hoy. La guía convierte tus respuestas en un flujo y un rango orientativo; una persona revisa el alcance antes de cualquier propuesta.</p>
  </div>

  <div class="ai-studio">
    <article class="ai-chat" aria-label="Guía de proyecto VARINO">
      <header class="ai-chat__topbar">
        <div class="ai-orb" aria-hidden="true"><span></span></div>
        <div><strong>VARINO Guide</strong><small>Guía de alcance y estimación</small></div>
        <span class="ai-chat__local" data-guide-status aria-live="polite" aria-atomic="true">Guía lista</span>
      </header>
      <div class="ai-chat__messages" data-guide-messages aria-live="polite">
        <div class="ai-message ai-message--assistant"><p>Hola, soy VARINO Guide. Cuéntame a qué se dedica tu empresa y qué te gustaría mejorar. Con tus respuestas dibujaré el sistema y un rango de horas y precio.</p></div>
      </div>
      <form class="ai-composer" data-guide-form>
        <label class="sr-only" for="guide-message">Escribe tu mensaje</label>
        <textarea id="guide-message" name="message" maxlength="1200" rows="1" placeholder="Por ejemplo: quiero automatizar la atención al cliente" required></textarea>
        <button type="submit" aria-label="Enviar mensaje">↑</button>
      </form>
      <p class="ai-chat__privacy"><span aria-hidden="true">◉</span>No incluyas contraseñas, secretos ni datos personales de terceros. La conversación se procesa en tu equipo y no se guarda al cerrar la página.</p>
    </article>

    <article class="ai-preview" aria-label="Arquitectura propuesta">
      <div class="ai-preview__media">
        <div class="ai-preview__grid" aria-hidden="true"></div>
        <header class="ai-preview__header"><span>ARQUITECTURA VARINO</span><span data-guide-stage>DESCUBRIMIENTO</span></header>
        <div class="ai-preview__intro">
          <p data-preview-kicker>Sistema en definición</p>
          <h3 data-preview-title>Tu necesidad, convertida en una arquitectura clara.</h3>
          <p data-preview-caption>La visualización cambiará mientras la guía comprende tu proceso, controles y objetivo.</p>
        </div>
      </div>
      <div class="ai-blueprint" data-blueprint>
        <div class="ai-blueprint__line"></div>
        <article class="is-active"><span>01 · Entrada</span><strong data-node="input">Por descubrir</strong><small>Origen de la solicitud</small></article>
        <article><span>02 · Inteligencia</span><strong data-node="logic">Análisis guiado</strong><small>Reglas, IA e integraciones</small></article>
        <article><span>03 · Control</span><strong data-node="control">Aprobación humana</strong><small>Excepciones y seguridad</small></article>
        <article><span>04 · Resultado</span><strong data-node="output">Objetivo medible</strong><small>Entrega y seguimiento</small></article>
      </div>
      <div class="ai-budget" data-budget hidden>
        <span>Estimación inicial transparente</span>
        <div class="ai-budget__grid">
          <p><strong data-budget-hours>—</strong><small>horas con margen</small></p>
          <p><strong data-budget-range>—</strong><small>rango sin IVA</small></p>
          <p><strong data-maintenance-hours>—</strong><small>horas de operación estimadas</small></p>
        </div>
        <p class="ai-budget__note" data-budget-note>Rango orientativo sin IVA. Las horas de operación no son una cuota: el mantenimiento es opcional y se contrata con uno de los planes publicados.</p>
        <a class="mt-3 inline-flex text-xs font-semibold text-[#0071e3] underline-offset-4 hover:underline" href={`${BASE}/planes/`}>Consultar planes mensuales →</a>
        <p data-hardware>La infraestructura se dimensionará cuando conozcamos usuarios, datos y concurrencia.</p>
      </div>
      <div class="ai-insight">
        <div><span>Recomendación actual</span><strong data-service>Diagnóstico y arquitectura</strong></div>
        <p data-reason>Primero entendemos el proceso. Después decidimos qué automatizar y qué debe seguir bajo aprobación humana.</p>
        <a class="ai-insight__cta" href={`${BASE}/contacto/`} data-service-link><span data-service-link-label>Revisar mi caso con VARINO</span> <span aria-hidden="true">→</span></a>
      </div>
      <div class="ai-preview__restart"><span>¿Quieres empezar de nuevo?</span><br /><button type="button" data-guide-reset>Nueva conversación</button></div>
    </article>
  </div>
</section>

<script>
  import { advise, containsPrivateData } from "../lib/guide-engine.mjs";

  const stageNames = { welcome: "BIENVENIDA", discovery: "DESCUBRIMIENTO", process: "PROCESO", requirements: "REQUISITOS", architecture: "ARQUITECTURA", estimate: "ESTIMACIÓN" };
  const activeNodes = { welcome: 1, discovery: 1, process: 2, requirements: 3, architecture: 4, estimate: 4 };
  const money = new Intl.NumberFormat("es-ES", { style: "currency", currency: "EUR", maximumFractionDigits: 0 });
  const rationale = {
    "ia-privada": "Datos aislados, permisos explícitos y aprobación humana antes de cualquier acción sensible.",
    "sistema-crecimiento": "Captura, cualificación y seguimiento medibles, sin automatizar decisiones que necesiten criterio humano.",
    "automation-sprint": "Un flujo observable con reglas, excepciones y recuperación documentada.",
  };

  document.querySelectorAll("[data-ai-guide]").forEach((root) => {
    if (root.dataset.ready === "true") return;
    root.dataset.ready = "true";
    const form = root.querySelector("[data-guide-form]");
    const input = form.querySelector("textarea");
    const submit = form.querySelector("button");
    const messages = root.querySelector("[data-guide-messages]");
    const status = root.querySelector("[data-guide-status]");
    const budget = root.querySelector("[data-budget]");
    const base = root.dataset.base || "";
    const hasLocalGuideApi = root.dataset.localGuideApi === "true";
    const browserStatus = "Guía lista";
    const idleStatus = browserStatus;
    let conversation = [];
    let profile = {};

    const appendMessage = (paragraphs, role, pending = false) => {
      const bubble = document.createElement("div");
      bubble.className = `ai-message ai-message--${role}${pending ? " ai-message--pending" : ""}`;
      for (const text of [].concat(paragraphs).filter(Boolean)) {
        const paragraph = document.createElement("p");
        paragraph.textContent = text;
        bubble.append(paragraph);
      }
      messages.append(bubble);
      messages.scrollTop = messages.scrollHeight;
      return bubble;
    };

    const setText = (selector, value) => {
      const node = root.querySelector(selector);
      if (node && value) node.textContent = value;
    };

    const updatePreview = (data) => {
      profile = data.profile || profile;
      setText("[data-guide-stage]", stageNames[data.stage] || "DESCUBRIMIENTO");
      setText('[data-node="input"]', profile.channels || profile.business || "Por descubrir");
      setText('[data-node="logic"]', profile.problem || "Análisis guiado");
      setText('[data-node="control"]', profile.approvals || "Aprobación humana");
      setText('[data-node="output"]', profile.goal || "Objetivo medible");
      setText("[data-preview-kicker]", profile.sector ? `Sistema para ${profile.sector}` : profile.business ? `Sistema para ${profile.business}` : "Sistema en definición");
      setText("[data-preview-title]", profile.problem || "Tu necesidad, convertida en una arquitectura clara.");
      setText("[data-preview-caption]", profile.goal ? `Objetivo: ${profile.goal}` : "Seguimos concretando proceso, controles y resultado esperado.");

      const count = activeNodes[data.stage] || 1;
      root.querySelectorAll(".ai-blueprint article").forEach((card, index) => card.classList.toggle("is-active", index < count));

      if (data.service) {
        setText("[data-service]", data.service.name);
        setText("[data-reason]", rationale[data.service.slug]);
        const link = root.querySelector("[data-service-link]");
        link.href = `${base}/servicios/${data.service.slug}/`;
        setText("[data-service-link-label]", `Ver ${data.service.name}`);
      }

      if (data.estimate) {
        budget.hidden = false;
        setText("[data-budget-hours]", String(data.estimate.quotedHours));
        setText("[data-budget-range]", `${money.format(data.estimate.range.min)}–${money.format(data.estimate.range.max)}`);
        setText("[data-maintenance-hours]", `${data.estimate.maintenanceHours} h/mes`);
        setText("[data-budget-note]", data.estimate.exceedsPackage
          ? "El caso supera los límites del paquete publicado y requiere propuesta personalizada. Las horas de operación son una estimación, no una cuota; el mantenimiento es opcional y se contrata aparte."
          : "Rango del proyecto orientativo y sin IVA. Las horas de operación no son una cuota: el mantenimiento es opcional y se contrata con uno de los planes publicados.");
      }
      if (data.hardware) setText("[data-hardware]", `${data.hardware.profile}: ${data.hardware.unifiedMemoryGb} GB de memoria unificada, ${data.hardware.freeStorageGb} GB libres y ${data.hardware.headroom}.`);
    };

    const render = (result) => {
      appendMessage([result.reply, result.nextQuestion], "assistant");
      conversation.push({ role: "assistant", content: [result.reply, result.nextQuestion].filter(Boolean).join(" ") });
      conversation = conversation.slice(-36);
      updatePreview(result);
    };

    const resetGuide = (message = "Empezamos de nuevo. Cuéntame a qué se dedica tu empresa y qué quieres mejorar.") => {
      conversation = [];
      profile = {};
      messages.replaceChildren();
      appendMessage(message, "assistant");
      budget.hidden = true;
      setText("[data-budget-note]", "Rango orientativo sin IVA. Las horas de operación no son una cuota: el mantenimiento es opcional y se contrata con uno de los planes publicados.");
      setText("[data-guide-stage]", "DESCUBRIMIENTO");
      setText("[data-preview-kicker]", "Sistema en definición");
      setText("[data-preview-title]", "Tu necesidad, convertida en una arquitectura clara.");
      setText("[data-preview-caption]", "La visualización cambiará mientras la guía comprende tu proceso, controles y objetivo.");
      setText('[data-node="input"]', "Por descubrir");
      setText('[data-node="logic"]', "Análisis guiado");
      setText('[data-node="control"]', "Aprobación humana");
      setText('[data-node="output"]', "Objetivo medible");
      root.querySelectorAll(".ai-blueprint article").forEach((card, index) => card.classList.toggle("is-active", index === 0));
      setText("[data-service]", "Diagnóstico y arquitectura");
      setText("[data-reason]", "Primero entendemos el proceso. Después decidimos qué automatizar y qué debe seguir bajo aprobación humana.");
      setText("[data-service-link-label]", "Revisar mi caso con VARINO");
      const link = root.querySelector("[data-service-link]");
      if (link) link.href = `${base}/contacto/`;
      setText("[data-hardware]", "La infraestructura se dimensionará cuando conozcamos usuarios, datos y concurrencia.");
      status.textContent = idleStatus;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const text = input.value.trim();
      if (!text || submit.disabled) return;
      if (containsPrivateData([...conversation.map((message) => message.content), text].join("\n"))) {
        input.value = "";
        resetGuide("Por privacidad, no he enviado esa información al modelo y he reiniciado el diagnóstico. Continúa con una descripción general, sin datos de contacto ni secretos.");
        return;
      }
      appendMessage(text, "user");
      conversation.push({ role: "user", content: text });
      conversation = conversation.slice(-36);
      input.value = "";
      input.disabled = submit.disabled = true;
      status.textContent = "Analizando";
      const pending = appendMessage("Estoy analizando tu respuesta…", "assistant", true);
      let statusLabel = hasLocalGuideApi ? "Preparando orientación" : browserStatus;
      try {
        // El motor local siempre produce una respuesta completa. El modelo,
        // cuando está disponible, solo mejora la redacción.
        let result = advise({ messages: conversation, profile });
        if (hasLocalGuideApi) {
          try {
            const response = await fetch(`${base}/api/guide`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ messages: conversation, profile }),
            });
            const data = await response.json();
            if (response.ok && data.profile) {
              result = data;
              statusLabel = data.replySource === "model" && data.modelInvoked
                ? "Respuesta asistida"
                : data.stage === "welcome"
                  ? "Respuesta inmediata"
                  : "Orientación inicial";
            }
          } catch {
            statusLabel = "Guía de respaldo";
          }
        }
        pending.remove();
        render(result);
      } finally {
        status.textContent = statusLabel;
        input.disabled = submit.disabled = false;
        input.focus();
      }
    });

    input.addEventListener("keydown", (event) => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        form.requestSubmit();
      }
    });

    root.querySelector("[data-guide-reset]").addEventListener("click", () => {
      resetGuide();
      input.focus();
    });
  });
</script>
