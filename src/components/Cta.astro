---
import { BASE, SITE, whatsappUrl } from "../config";

interface Props {
  titulo?: string;
  texto?: string;
}

const {
  titulo = "Hablemos del proceso que quieres mejorar.",
  texto = "Revisamos el contexto, las herramientas, los límites y la forma de medir antes de proponer una solución.",
} = Astro.props;

const wa = whatsappUrl(
  `Hola, me interesa agendar una auditoría con ${SITE.name}.`
);
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <div
    class="rounded-3xl border border-[#424245]/40 bg-gradient-to-b from-[#161617] to-black px-8 py-16 text-center text-white sm:px-16 shadow-2xl relative overflow-hidden"
  >
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-96 h-40 bg-[#2997ff]/15 rounded-full blur-3xl pointer-events-none"></div>

    <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight relative z-10">{titulo}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-sm sm:text-base text-[#86868b] relative z-10 leading-relaxed">{texto}</p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-4 relative z-10">
      <a
        href={`${BASE}/contacto/`}
        class="rounded-full bg-[#0071e3] px-7 py-3 text-xs sm:text-sm font-semibold text-white transition hover:bg-[#0077ed] shadow-lg shadow-[#0071e3]/25 active:scale-95"
      >
        Plantear un caso
      </a>
      {
        wa && (
          <a
            href={wa}
            class="rounded-full border border-[#424245] bg-[#1d1d1f] px-6 py-3 text-xs sm:text-sm font-medium text-[#f5f5f7] transition hover:bg-[#2c2c2e]"
          >
            WhatsApp Directo
          </a>
        )
      }
    </div>
  </div>
</section>
