---
import { BACKEND, BACKEND_CHAT, BACKEND_LEAD, BASE, SITE } from "../config";
const CHAT = BACKEND_CHAT;
---
<!-- Asistente IA de VARINO. Envía mensajes al backend de la agencia si está disponible;
     el historial y los datos de contacto no se persisten en el navegador. -->
<section
  class="ai-chat-widget"
  data-aichat
  data-chat={BACKEND_CHAT}
  data-lead={BACKEND_LEAD}
  data-origin={BACKEND.origin}
  aria-label={CHAT ? "Asistente VARINO AI" : "Guía VARINO"}
>
  <button type="button" class="aichat-launcher" data-aichat-open aria-expanded="false">
    <span aria-hidden="true">◉</span> {CHAT ? "VARINO AI" : "Guía VARINO"}
  </button>

  <div class="aichat-backdrop" data-aichat-backdrop hidden></div>

  <div class="aichat-panel" hidden>
    <header class="aichat-head">
      <div>
        <strong>{CHAT ? "VARINO AI" : "Guía VARINO"}</strong>
        <small>{CHAT ? "Asistente conectado" : "Experiencia interactiva · modo local"}</small>
      </div>
      <button type="button" class="aichat-close" data-aichat-close aria-label="Cerrar">✕</button>
    </header>

    <div class="aichat-msgs" data-aichat-msgs aria-live="polite">
      {!CHAT && (
        <div class="aichat-offline" data-aichat-offline role="status">
          <p><strong>La IA conversacional no está conectada.</strong> Esta ventana no enviará ni guardará tus mensajes; no quiero fingir respuestas.</p>
          <a class="button-primary" href={`${BASE}/experiencia/`}>Explorar la experiencia interactiva →</a>
          <a class="aichat-offline-link" href={`${BASE}/precios/`}>Consultar servicios y precios</a>
          <a class="aichat-offline-link" href={`${BASE}/contacto/`}>Contactar con VARINO</a>
        </div>
      )}
    </div>

    {CHAT && <form class="aichat-composer" data-aichat-form>
      <label class="sr-only" for="aichat-input">Escribe tu mensaje</label>
      <textarea id="aichat-input" data-aichat-input rows="1" maxlength="1200" placeholder="Pregunta por servicios, precios o cómo empezar…" required></textarea>
      <button type="submit" aria-label="Enviar">↑</button>
    </form>}

    <!-- Captura con consentimiento -->
    {CHAT && <div class="aichat-capture" data-aichat-capture hidden>
      <form data-aichat-lead>
        <input type="hidden" name="website" value="" aria-hidden="true" tabindex="-1" autocomplete="off" />
        <p class="aichat-capture-title">¿Quieres que el equipo de VARINO te contacte?</p>
        <label class="sr-only" for="aichat-nombre">Nombre</label>
        <input id="aichat-nombre" name="nombre" type="text" placeholder="Tu nombre" required />
        <label class="sr-only" for="aichat-email">Email</label>
        <input id="aichat-email" name="email" type="email" placeholder="Email (o WhatsApp abajo)" />
        <label class="sr-only" for="aichat-whatsapp">WhatsApp</label>
        <input id="aichat-whatsapp" name="whatsapp" type="tel" placeholder="WhatsApp (opcional)" />
        <label class="aichat-consent">
          <input type="checkbox" name="consentimiento" value="true" required />
          <span>He leído la <a href={`${"/privacidad/"}`} target="_blank" rel="noopener">información de privacidad</a>. Usaremos estos datos para tramitar esta solicitud; no es una suscripción comercial.</span>
        </label>
        <button type="submit" class="aichat-send">Enviar y que me contacten →</button>
        <p class="aichat-status" data-aichat-lead-status aria-live="polite"></p>
      </form>
    </div>}

    <p class="aichat-legal">
      {CHAT
        ? `Asistente con IA de ${SITE.name}. El mensaje se envía al servidor de la agencia para generar una respuesta; no guardamos una copia del chat en este navegador. No compartas datos sensibles ni de terceros.`
        : `El asistente de IA está desconectado. La experiencia interactiva funciona en este navegador; no envía ni conserva mensajes.`}
      <a href={`${"/privacidad/"}`} target="_blank" rel="noopener">Privacidad</a>
    </p>
  </div>
</section>

<style is:global>
  .ai-chat-widget {
    --ac: #0071e3; --panel: #ffffff; --line: #e5e5ea; --text: #1d1d1f; --muted: #6e6e73;
    position: fixed; right: 18px; bottom: 18px; z-index: 70; font-family: ui-sans-serif, system-ui, sans-serif;
  }
  .aichat-launcher {
    display: inline-flex; align-items: center; gap: .5rem;
    background: var(--ac); color: #fff; border: 0; border-radius: 999px;
    padding: .7rem 1.1rem; font-size: .8rem; font-weight: 600; cursor: pointer;
    box-shadow: 0 10px 30px rgb(0 0 0 / .18); transition: transform .15s ease, background .2s;
  }
  .aichat-launcher:hover { background: #0077ed; }
  .aichat-backdrop {
    position: fixed; inset: 0; z-index: 69; background: rgba(15, 15, 20, .25);
  }
  .aichat-panel {
    position: fixed; top: 0; right: 0; z-index: 71;
    height: 100dvh; width: min(92vw, 410px);
    display: flex; flex-direction: column;
    background: var(--panel); color: var(--text);
    border-left: 1px solid var(--line);
    box-shadow: -18px 0 60px rgb(0 0 0 / .22);
  }
  .aichat-head {
    display: flex; justify-content: space-between; align-items: center;
    padding: .9rem 1.1rem; border-bottom: 1px solid var(--line);
  }
  .aichat-head strong { display: block; font-size: .9rem; }
  .aichat-head small { color: var(--muted); font-size: .7rem; }
  .aichat-close, .aichat-composer button { background: none; border: 0; cursor: pointer; color: var(--muted); font-size: .95rem; }
  .aichat-close { padding: .3rem .5rem; }
  .aichat-msgs { flex: 1; min-height: 0; overflow-y: auto; padding: 1rem; display: flex; flex-direction: column; gap: .45rem; }
  .aichat-offline { margin: auto 0; display: grid; gap: .8rem; max-width: 21rem; font-size: .84rem; line-height: 1.55; }
  .aichat-offline p { margin: 0; }
  .aichat-offline-link { width: fit-content; color: var(--ac); text-decoration: underline; text-underline-offset: .2em; }
  .aichat-row { display: flex; flex-direction: column; }
  .aichat-row.user { align-items: flex-end; }
  .aichat-row.bot { align-items: flex-start; }
  .aichat-who { font-size: .62rem; letter-spacing: .04em; text-transform: uppercase; color: var(--muted); margin: 0 0 3px 4px; }
  .aichat-who.user { margin: 0 4px 3px 0; }
  .aichat-bubble {
    margin: 0; padding: .55rem .8rem; border-radius: 16px;
    font-size: .85rem; line-height: 1.5; max-width: 82%;
    white-space: pre-wrap; word-break: break-word;
  }
  .aichat-row.bot .aichat-bubble { background: #e9edf3; color: var(--text); border-bottom-left-radius: 5px; }
  .aichat-row.user .aichat-bubble { background: var(--ac); color: #fff; border-bottom-right-radius: 5px; }
  .aichat-bubble.typing { opacity: .7; font-style: italic; }
  .dark .ai-chat-widget { --ac: #2997ff; --panel: #111318; --line: #2a2a2c; --text: #f5f5f7; --muted: #a1a1a6; }
  .dark .aichat-row.bot .aichat-bubble { background: #23262d; color: #f5f5f7; }
  .aichat-composer { display: flex; gap: .5rem; padding: .65rem .85rem; border-top: 1px solid var(--line); }
  .aichat-composer textarea {
    flex: 1; resize: none; border: 1px solid var(--line); border-radius: 10px;
    background: transparent; color: var(--text); padding: .45rem .6rem; font: inherit; font-size: .82rem;
  }
  .aichat-capture { border-top: 1px dashed var(--line); padding: .75rem .9rem; font-size: .8rem; }
  .aichat-capture-title { margin: 0 0 .5rem; font-weight: 600; }
  .aichat-capture input[type="text"], .aichat-capture input[type="email"], .aichat-capture input[type="tel"] {
    width: 100%; margin-bottom: .45rem; box-sizing: border-box;
    border: 1px solid var(--line); border-radius: 9px; padding: .45rem .6rem; font: inherit; font-size: .8rem;
    background: transparent; color: var(--text);
  }
  .aichat-consent { display: flex; gap: .5rem; align-items: flex-start; color: var(--muted); font-size: .7rem; line-height: 1.4; margin: .4rem 0; }
  .aichat-consent a, .aichat-legal a, .aichat-capture a { color: var(--ac); }
  .aichat-send { width: 100%; background: var(--ac); color: #fff; border: 0; border-radius: 999px; padding: .55rem; font-weight: 600; cursor: pointer; font-size: .78rem; }
  .aichat-status { min-height: 1em; margin: .35rem 0 0; color: var(--muted); font-size: .72rem; }
  .aichat-legal { margin: 0; padding: .55rem .9rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .66rem; line-height: 1.45; }
  .aichat-panel[hidden] { display: none; }
</style>

<script>
  (function () {
    var root = document.querySelector("[data-aichat]");
    if (!root) return;
    var CHAT = root.getAttribute("data-chat");
    var LEAD = root.getAttribute("data-lead");
    var launcher = root.querySelector("[data-aichat-open]");
    var panel = root.querySelector(".aichat-panel");
    var msgsEl = root.querySelector("[data-aichat-msgs]");
    var form = root.querySelector("[data-aichat-form]");
    var input = root.querySelector("[data-aichat-input]");
    var capture = root.querySelector("[data-aichat-capture]");
    var leadForm = root.querySelector("[data-aichat-lead]");
    var leadStatus = root.querySelector("[data-aichat-lead-status]");
    var backdrop = root.querySelector("[data-aichat-backdrop]");

    var msgs = [];
    var sending = false;
    var convId = "";
    function persist() { msgs = msgs.slice(-48); }

    function say(text, who, typing) {
      var isUser = who === "user";
      var row = document.createElement("div");
      row.className = "aichat-row " + (isUser ? "user" : "bot");
      var label = document.createElement("span");
      label.className = "aichat-who " + (isUser ? "user" : "bot");
      label.textContent = isUser ? "Tú" : "VARINO AI";
      row.appendChild(label);
      var p = document.createElement("p");
      p.className = "aichat-bubble" + (typing ? " typing" : "");
      p.textContent = text;
      row.appendChild(p);
      msgsEl.appendChild(row);
      msgsEl.scrollTop = msgsEl.scrollHeight;
      return row;
    }
    function save(role, content) { msgs.push({ role: role, content: content }); persist(); }

    function openPanel() {
      if (!panel.hidden) return;
      panel.hidden = false;
      if (backdrop) backdrop.hidden = false;
      launcher.hidden = true;
      launcher.setAttribute("aria-expanded", "true");
      if (CHAT) {
        msgsEl.replaceChildren();
        if (!msgs.length) {
          say("Hola, soy VARINO AI. Puedo orientarte sobre servicios y precios publicados y ayudarte a delimitar un proceso. ¿Qué tarea repetitiva te gustaría mejorar?");
        } else {
          for (var i = 0; i < msgs.length; i++) say(msgs[i].content, msgs[i].role === "user" ? "user" : "assistant");
        }
      }
      if (input) input.focus();
    }
    function closePanel() {
      panel.hidden = true;
      if (backdrop) backdrop.hidden = true;
      launcher.hidden = false;
      launcher.setAttribute("aria-expanded", "false");
      launcher.focus();
    }
    launcher.addEventListener("click", function () { if (panel.hidden) openPanel(); else closePanel(); });
    root.querySelector("[data-aichat-close]").addEventListener("click", closePanel);
    if (backdrop) backdrop.addEventListener("click", closePanel);
    // Cualquier botón [data-open-chat] (p. ej. en la portada) abre el asistente
    var openers = document.querySelectorAll("[data-open-chat]");
    for (var oi = 0; oi < openers.length; oi++) {
      openers[oi].addEventListener("click", function () { openPanel(); });
    }

    // The public deployment intentionally has no AI or lead backend connected.
    // Keep the honest local experience visible and stop before attaching send handlers.
    if (!CHAT) return;

    function respuestaSinConexion() {
      return "Ahora mismo no puedo conectar con el asistente, así que no quiero inventar una respuesta. Puedes consultar los servicios y precios en la web, o escribirnos por WhatsApp al +34 623 20 43 19 o a varinoagency@gmail.com. Tus mensajes no se guardan en este navegador.";
    }

    form.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var text = input.value.trim();
      if (!text || sending) return;
      sending = true;
      say(text, "user");
      save("user", text);
      input.value = ""; input.disabled = true;
      var pending = say("…", "assistant", true);
      var replyText = "";

      // Un modelo local grande puede tardar; el historial permanece solo en memoria de esta página.
      if (CHAT) {
        try {
          var ctrl = new AbortController();
          var t = setTimeout(function () { ctrl.abort(); }, 45000);
          var history = msgs.slice(-21, -1);
          var res = await fetch(CHAT, {
            method: "POST",
            signal: ctrl.signal,
            headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true" },
            body: JSON.stringify({ message: text, history: history, conversationId: convId, pagina: location.pathname })
          });
          clearTimeout(t);
          var data = await res.json();
          if (res.ok && data && data.reply) {
            replyText = data.reply;
            if (!convId && data.conversationId) { convId = data.conversationId; persist(); }
          }
        } catch (e) {
          clearTimeout(t);
        }
      }

      // Si el backend falla, no sustituimos la respuesta por afirmaciones comerciales hardcodeadas.
      if (!replyText) {
        replyText = respuestaSinConexion();
      }

      pending.remove();
      say(replyText, "assistant");
      save("assistant", replyText);

      // Abrir formulario de contacto tras temas de interés o conversación activa
      if (capture.hidden) {
        var norm = text.toLowerCase();
        if (/precio|cost|cuant|cita|agend|reunion|contact|llamada|auditor/.test(norm) || msgs.filter(function (m) { return m.role === "user"; }).length >= 2) {
          capture.hidden = false;
        }
      }

      sending = false;
      input.disabled = false;
      input.focus();
    });

    leadForm.addEventListener("submit", async function (ev) {
      ev.preventDefault();
      var f = leadForm;
      function val(n) { var el = f.querySelector('[name="' + n + '"]'); return el ? el.value.trim() : ""; }
      var consent = f.querySelector('[name="consentimiento"]').checked;
      var nombre = val("nombre"), email = val("email"), whatsapp = val("whatsapp");
      var last = msgs[msgs.length - 1] ? msgs[msgs.length - 1].content : "";
      if (!consent || !nombre) return;
      if (!email && !whatsapp) {
        leadStatus.textContent = "Indica al menos un email o un WhatsApp para poder contactarte.";
        return;
      }
      function mostrarCanales(texto) {
        leadStatus.replaceChildren(document.createTextNode(texto + " "));
        var wa = document.createElement("a");
        wa.href = "https://wa.me/34623204319";
        wa.target = "_blank";
        wa.rel = "noopener";
        wa.textContent = "WhatsApp";
        leadStatus.appendChild(wa);
        leadStatus.appendChild(document.createTextNode(" · "));
        var mail = document.createElement("a");
        mail.href = "mailto:varinoagency@gmail.com";
        mail.textContent = "correo";
        leadStatus.appendChild(mail);
      }
      if (!LEAD) {
        mostrarCanales("El formulario no está conectado; no hemos recibido ni guardado tus datos. Escríbenos por");
        return;
      }
      leadStatus.textContent = "Enviando la solicitud al equipo…";
      var cLead = new AbortController();
      var tLead = setTimeout(function () { cLead.abort(); }, 15000);
      try {
        var leadResponse = await fetch(LEAD, {
          method: "POST",
          signal: cLead.signal,
          headers: { "Content-Type": "application/json", "ngrok-skip-browser-warning": "true" },
          body: JSON.stringify({
            nombre: nombre, email: email, whatsapp: whatsapp, empresa: "", interes: "chat",
            fuente: "chat_widget", pagina: location.pathname, consentimiento: true, marketing_consent: false,
            mensaje: "Chat: " + (last || "").slice(0, 600), conversationId: convId,
            website: f.querySelector('[name="website"]').value
          })
        });
        if (!leadResponse.ok) throw new Error("lead_request_failed");
        var leadResult = await leadResponse.json();
        if (!leadResult || leadResult.ok !== true) throw new Error("lead_not_saved");
        leadStatus.textContent = "Solicitud recibida y registrada. El equipo revisará tu mensaje.";
        leadForm.reset();
      } catch (e2) {
        mostrarCanales("No se pudo confirmar el envío y no hemos guardado una copia en este navegador. Vuelve a intentarlo o contáctanos por");
      } finally {
        clearTimeout(tLead);
      }
    });

    // Enviar con Enter (Shift+Enter = salto de línea)
    input.addEventListener("keydown", function (ev) {
      if (ev.key === "Enter" && !ev.shiftKey) { ev.preventDefault(); form.requestSubmit(); }
    });
    function auto() { input.style.height = "auto"; input.style.height = Math.min(input.scrollHeight, 120) + "px"; }
    input.addEventListener("input", auto);

  })();
</script>
