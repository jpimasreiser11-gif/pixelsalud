---
interface Props { title: string; steps: string[]; tone?: "current" | "proposed" }
const { title, steps, tone = "current" } = Astro.props;
---

<div class={`mission-flow mission-flow--${tone}`}>
  <p>{title}</p>
  <ol>
    {steps.map((step, index) => (
      <li>
        <span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
        <strong>{step}</strong>
      </li>
    ))}
  </ol>
</div>
